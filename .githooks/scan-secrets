#!/usr/bin/env bash
# scan-secrets: refuse paths and content that look like secrets. This repo is public.
#
#   scan-secrets --staged        the index (pre-commit)
#   scan-secrets --message FILE  a commit message (commit-msg)
#   scan-secrets --range A..B    every commit in a range, messages included (pre-push)
#
# Private strings (personal email addresses and the like) are listed one per line in
# .git/info/scan-secrets-deny, which git never commits, so the list itself stays private. Matched
# literally, ignoring case; # starts a comment.
#
# Exits 1 and lists every hit. A deliberate, checked false positive can go through with
# SECRET_SCAN_BYPASS=1 git commit ...; the hook still prints what it found.
set -uo pipefail

# Paths that never belong here, matched against the full path (bash glob, nocasematch).
deny_paths=(
  '*/.ssh/*' '.ssh/*' '*/.gnupg/*' '.gnupg/*'
  'id_rsa*' '*/id_rsa*' 'id_dsa*' '*/id_dsa*' 'id_ecdsa*' '*/id_ecdsa*' 'id_ed25519*' '*/id_ed25519*'
  '*_ed25519' '*_ed25519_sk' '*_rsa' '*_ecdsa'
  '*.pem' '*.key' '*.p12' '*.pfx' '*.jks' '*.kdbx' '*.gpg' '*.asc'
  'known_hosts*' '*/known_hosts*' '*/authorized_keys*'
  '*/system-connections/*' '*.nmconnection' '*.psk' '*.8021x' '*/lib/iwd/*' '*wpa_supplicant*.conf'
  '*/gh/hosts.yml' '*.netrc' '*/.netrc' '*.git-credentials' '*/.git-credentials'
  '*/.mozilla/*' '*/mozilla/firefox/*' '*/.thunderbird/*'
  '*_history' '*/.histfile' '*/.lesshst' '*/.viminfo' '*/.local/share/nvim/shada/*'
  '*/keyrings/*' '*/.password-store/*' '*/.aws/*' '*/.kube/config' '*/.docker/config.json'
  '*/.npmrc' '*/.pypirc' '*/.cargo/credentials*' '*/rclone/rclone.conf'
  '.env' '*/.env' '.env.*' '*/.env.*'
  '*/.claude/.credentials.json' '*/.claude.json'
  'etc/shadow*' '*/etc/shadow*' 'etc/gshadow*' '*/etc/gshadow*' '*/crypttab.key*' '*.luks-key*'
)
# Allowed exceptions to the list above (public halves of keys).
allow_paths=('*.pub')

# High-confidence content patterns (grep -E). Keep these precise: noise teaches people to bypass.
deny_content=(
  '-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----'
  'gh[pousr]_[A-Za-z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{22,}'
  'glpat-[A-Za-z0-9_-]{20,}'
  '(AKIA|ASIA)[0-9A-Z]{16}'
  'xox[abprs]-[A-Za-z0-9-]{10,}'
  '(^|[^A-Za-z0-9_-])sk-ant-[A-Za-z0-9_-]{20,}'
  '(^|[^A-Za-z0-9_-])sk-(proj-)?[A-Za-z0-9_-]{32,}'
  'AIza[0-9A-Za-z_-]{35}'
  'Authorization:[[:space:]]*(Bearer|Basic|token)[[:space:]]+[A-Za-z0-9._~+/=-]{8,}'
  '(^|[^A-Za-z0-9_-])(psk|wpa_passphrase|passphrase)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9!@#%^&*._+/~-]{6,}'
  '(^|[^A-Za-z0-9_-])passw(or)?d[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9!@#%^&*._+/~-]{6,}'
  '(^|[^A-Za-z0-9_-])(secret|api_?key|access_?token|auth_?token|client_secret)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9/+_=-]{16,}'
  '\$[0-9a-z]+\$[^[:space:]:]{8,}\$[A-Za-z0-9./]{20,}'
)

# The private list, from the clone's own .git (shared by worktrees).
private=()
private_file=$(git rev-parse --git-common-dir 2>/dev/null)/info/scan-secrets-deny
if [[ -r $private_file ]]; then
  while IFS= read -r entry; do
    entry=${entry%%#*}
    entry=${entry#"${entry%%[![:space:]]*}"}
    entry=${entry%"${entry##*[![:space:]]}"}
    [[ -n $entry ]] && private+=("$entry")
  done <"$private_file"
fi

hits=0
report() { printf 'scan-secrets: %s\n' "$*" >&2; hits=$((hits + 1)); }

check_path() {
  local path=$1 glob
  shopt -s nocasematch
  for glob in "${allow_paths[@]}"; do [[ $path == $glob ]] && { shopt -u nocasematch; return; }; done
  for glob in "${deny_paths[@]}"; do
    if [[ $path == $glob ]]; then report "denied path: $path (matches '$glob')"; break; fi
  done
  shopt -u nocasematch
}

# stdin: the text to scan. $1: where it came from, for the message.
check_content() {
  local where=$1 text pat line
  text=$(cat)
  for pat in "${deny_content[@]}"; do
    while IFS= read -r line; do
      [[ -n $line ]] && report "secret-like content in $where: $(cut -c1-120 <<<"$line")"
    done < <(grep -nE -e "$pat" <<<"$text" 2>/dev/null | cut -c1-200)
  done
  for pat in "${private[@]}"; do
    while IFS= read -r line; do
      [[ -n $line ]] && report "private string (.git/info/scan-secrets-deny) in $where: $(cut -c1-120 <<<"$line")"
    done < <(grep -nFi -e "$pat" <<<"$text" 2>/dev/null | cut -c1-200)
  done
}

# gitleaks 8.19+ has `gitleaks git`; older releases have `detect` and `protect`.
gitleaks_scan() {
  command -v gitleaks >/dev/null || return 0
  local args
  if gitleaks git --help >/dev/null 2>&1; then
    if [[ $1 == staged ]]; then args=(git --staged); else args=(git "--log-opts=$2"); fi
  else
    if [[ $1 == staged ]]; then args=(protect --staged); else args=(detect "--log-opts=$2"); fi
  fi
  if ! gitleaks "${args[@]}" --no-banner --redact >&2; then report "gitleaks found leaks (output above)"; fi
}

case "${1:-}" in
  --staged)
    while IFS= read -r -d '' path; do
      check_path "$path"
      # Staged blob, not the working tree. Read it whole first: a pipe into `grep -q` would
      # SIGPIPE `git show` and, with pipefail, silently skip the file. Skip binaries.
      blob=$(git cat-file blob ":$path" | tr -d '\0'; printf x)
      blob=${blob%x}
      if [[ $(git cat-file blob ":$path" | head -c 8000 | tr -d -c '\0' | wc -c) -eq 0 ]]; then
        check_content "$path (staged)" <<<"$blob"
      fi
    done < <(git diff --cached --name-only -z --diff-filter=ACMRT)
    gitleaks_scan staged
    ;;
  --message)
    check_content "the commit message" <"${2:?usage: scan-secrets --message FILE}"
    ;;
  --range)
    range=${2:?usage: scan-secrets --range A..B}
    while IFS= read -r -d '' path; do
      check_path "$path"
    done < <(git -c core.quotePath=false log --format= --name-only --diff-filter=ACMRT "$range" | sed '/^$/d' | sort -u | tr '\n' '\0')
    # Added lines of every commit in the range. Not a pipeline into check_content: that would run
    # it in a subshell and lose the hit count.
    check_content "commits $range" < <(git log -p --format='commit %H' --diff-filter=ACMRT "$range" \
      | grep -E '^(\+[^+]|commit )')
    check_content "commit messages $range" < <(git log --format='commit %H%n%B' "$range")
    gitleaks_scan range "$range"
    ;;
  *)
    echo "usage: scan-secrets --staged | --message FILE | --range A..B" >&2
    exit 2
    ;;
esac

if ((hits)); then
  if [[ ${SECRET_SCAN_BYPASS:-} == 1 ]]; then
    echo "scan-secrets: $hits hit(s) ignored because SECRET_SCAN_BYPASS=1." >&2
    exit 0
  fi
  cat >&2 <<'MSG'
scan-secrets: blocked. This repository is public.
  Remove the file or value (git restore --staged <path>), or keep it out with .gitignore.
  Only if you have checked that a hit is a false positive: SECRET_SCAN_BYPASS=1 git commit ...
MSG
  exit 1
fi
exit 0
