#!/usr/bin/env bash
# scan-secrets: refuse paths and content that look like secrets or private details. This repo is
# public.
#
#   scan-secrets --staged         the index (pre-commit)
#   scan-secrets --message FILE   a commit message (commit-msg)
#   scan-secrets --range REV...   every commit `git log REV...` lists, messages included
#                                 (pre-push): A..B, or B --not --remotes
#
# Private strings (personal email addresses and the like) are listed one per line in
# .git/info/scan-secrets-deny, which git never commits, so the list itself stays private. Matched
# literally, ignoring case, against content, commit messages and file names; # starts a comment.
#
# Besides secrets it refuses what tells about a person or a network: mail addresses, private
# network addresses, phone numbers, bank accounts, coordinates, ssh public keys, pictures that carry
# metadata, an author address that has not published here before. What is meant to be public is
# allowed by rule in .githooks/scan-allow (`rule regex`, the regex matching the whole find).
#
# Exits 1 and lists every hit as place: rule: text. A deliberate, checked false positive can go
# through with SECRET_SCAN_BYPASS=1 git commit ...; the hook still prints what it found. When git
# itself fails (a range it cannot resolve, an object it cannot read) nothing was scanned, so the
# answer is also a refusal, and the bypass does not apply to it.
set -uo pipefail

# Paths that never belong here, matched against the full path with a leading / (bash glob,
# nocasematch), so '*/x' also matches x at the top level. Covers every secret-bearing pattern
# in .gitignore.
deny_paths=(
  '*/.ssh/*' '*/.gnupg/*'
  '*/id_rsa*' '*/id_dsa*' '*/id_ecdsa*' '*/id_ed25519*'
  '*_ed25519' '*_ed25519_sk' '*_rsa' '*_ecdsa'
  '*.pem' '*.key' '*.p12' '*.pfx' '*.jks' '*.kdbx' '*.gpg' '*.asc'
  '*/known_hosts*' '*/authorized_keys*'
  '*/system-connections/*' '*.nmconnection' '*.psk' '*.8021x' '*/lib/iwd/*' '*wpa_supplicant*.conf'
  '*/gh/hosts.yml' '*.netrc' '*.git-credentials'
  '*/.mozilla/*' '*/mozilla/firefox/*' '*/.thunderbird/*'
  '*_history' '*/.histfile' '*/.lesshst' '*/.viminfo' '*/shada/*'
  '*/keyrings/*' '*/.password-store/*' '*/.aws/*' '*/.kube/config' '*/.docker/config.json'
  '*/.npmrc' '*/.pypirc' '*/.cargo/credentials*' '*/rclone.conf'
  '*/.env' '*/.env.*'
  '*/.claude/.credentials.json' '*/.claude.json' '*/.claude/settings.local.json'
  '*/shadow' '*/shadow-' '*/gshadow' '*/gshadow-' '*/etc/shadow*' '*/etc/gshadow*'
  '*/crypttab.key*' '*.luks-key*'
  # Other machines' configuration has its own, private repository.
  '*/hosts/core/*' '*/hosts/domaci/*'
  # Data and leftovers, which hold whatever went through them: databases, logs, mail, captures,
  # agent sessions, documents, editor and patch backups.
  '*.db' '*.sqlite' '*.sqlite3' '*.sqlite-wal' '*.sqlite-shm' '*.jsonl' '*.log' '*/wget-log*'
  '*.eml' '*.mbox' '*/Mail/*' '*/Maildir/*' '*.vcf' '*.ics'
  '*.pcap' '*.pcapng' '*.har' '*.core' '*.dump' '*.tfstate' '*.tfstate.*'
  '*.ovpn' '*/wireguard/*.conf' '*/wg[0-9]*.conf' '*.mobileconfig' '*.age' '*.kdb' '*.keychain*'
  '*/.claude/*' '*/.codex/*' '*/.cursor/*' '*/.aider*' '*/.local/state/*' '*/.cache/*'
  '*.pdf' '*.doc' '*.docx' '*.xls' '*.xlsx' '*.odt' '*.ods' '*.heic'
  '*.bak' '*.orig' '*.rej' '*.swp' '*.swo' '*~' '*/.DS_Store' '*/nohup.out'
)
# Allowed exceptions to the list above (public halves of keys).
allow_paths=('*.pub')

# High-confidence content patterns, as "name regex" (grep -E). Keep these precise: noise teaches
# people to bypass. These are also run over binary files.
token_rules=(
  'private-key-block -----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----'
  'github-token gh[pousr]_[A-Za-z0-9]{36}'
  'github-token github_pat_[A-Za-z0-9_]{22,}'
  'gitlab-token glpat-[A-Za-z0-9_-]{20,}'
  'aws-key-id (AKIA|ASIA)[0-9A-Z]{16}'
  'slack-token xox[abprs]-[A-Za-z0-9-]{10,}'
  'anthropic-key (^|[^A-Za-z0-9_-])sk-ant-[A-Za-z0-9_-]{20,}'
  'openai-key (^|[^A-Za-z0-9_-])sk-(proj-)?[A-Za-z0-9_-]{32,}'
  'google-api-key AIza[0-9A-Za-z_-]{35}'
  'password-hash \$[0-9a-z]+\$[^[:space:]:]{8,}\$[A-Za-z0-9./]{20,}'
  'json-web-token eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}'
  'age-secret-key AGE-SECRET-KEY-1[0-9A-Z]{20,}'
  'otp-secret otpauth://[a-z]+/[^[:space:]]*secret='
  'npm-token npm_[A-Za-z0-9]{36}'
  'pypi-token pypi-AgE[A-Za-z0-9_-]{40,}'
  'huggingface-token (^|[^A-Za-z0-9_])hf_[A-Za-z0-9]{30,}'
  'stripe-key [sr]k_live_[A-Za-z0-9]{20,}'
  'sendgrid-key SG\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{40,}'
  'google-oauth-token ya29\.[A-Za-z0-9_-]{30,}'
  'tailscale-key tskey-[a-z]+-[A-Za-z0-9]{10,}'
  'digitalocean-token do[opr]_v1_[a-f0-9]{64}'
  'scaleway-key (^|[^A-Z0-9])SCW[A-Z0-9]{17}([^A-Z0-9]|$)'
  'telegram-bot-token (^|[^0-9])[0-9]{8,10}:AA[A-Za-z0-9_-]{33}'
  'webhook-url https://(hooks\.slack\.com/services|discord(app)?\.com/api/webhooks)/[A-Za-z0-9/_-]{20,}'
  'app-password (^|[^A-Za-z0-9-])([A-Za-z0-9]{5}-){4}[A-Za-z0-9]{5}([^A-Za-z0-9-]|$)'
)
# What tells about a person or a network, as "name regex" (grep -E -o): each find goes through
# .githooks/scan-allow before it counts. Text only.
privacy_rules=(
  'mail-address [A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}'
  'private-network-address \b(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01])|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7]))\.[0-9]{1,3}\.[0-9]{1,3}\b'
  'private-network-address \bf[cd][0-9a-f]{2}(:[0-9a-f]{0,4}){2,7}\b'
  'hardware-address \b([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}\b'
  'ssh-public-key (ssh-(ed25519|rsa|dss)|ecdsa-sha2-nistp[0-9]+|sk-ssh-ed25519@openssh\.com) AAAA[A-Za-z0-9+/]{20,}'
  'bank-account \b[A-Z]{2}[0-9]{2}( ?[0-9]{4}){3,7}( ?[0-9]{1,3})?\b'
  'phone-number (^|[^0-9A-Za-z.])\+[1-9][0-9]{0,2}[ -]?(\(0\))?[ -]?[0-9]{2,4}([ -]?[0-9]{2,4}){2,4}\b'
  'coordinates \b[0-9]{1,2}\.[0-9]{4,}°? ?[NS]?,? ?[0-9]{1,3}\.[0-9]{4,}'
)
# A file this large is a dump or an archive, not source.
max_blob=$((5 * 1024 * 1024))
# The same, ignoring case; text only.
nocase_rules=(
  'authorization-header Authorization:[[:space:]]*(Bearer|Basic|token)[[:space:]]+[A-Za-z0-9._~+/=-]{8,}'
)

# Assignments, ignoring case: a name with password, passphrase, psk, or ending in secret, token or
# key; then = or : (also := and =>), with the name and the value optionally quoted. That is
# NAME=value in shell, name: value in YAML, "name": "value" in JSON and name = "value" in TOML.
# grep lists the candidates; assignment_is_secret decides from the name and the value.
name_chars='[A-Za-z0-9_.-]'
assign_re="${name_chars}*(passw(or)?d|passphrase|psk|secret|token|api[_-]?key|[_-]key|(private|access)key)${name_chars}*"
assign_re+="[\"']?[[:space:]]*(:=|=>|=|:)[[:space:]]*(\"[^\"]{0,400}|'[^']{0,400}|[^[:space:]\"']{1,400})"
# URLs that carry a password: scheme://user:password@
url_re="[a-z][a-z0-9+.-]*://[^/[:space:]:@\"']+:[^/[:space:]@\"']+@"

# The private list, from the clone's own .git (shared by worktrees).
private=()
private_file=$(git rev-parse --git-common-dir 2>/dev/null)/info/scan-secrets-deny
if [[ -r $private_file ]]; then
  while IFS= read -r entry; do
    entry=${entry%%#*}
    entry=${entry#"${entry%%[![:space:]]*}"}
    entry=${entry%"${entry##*[![:space:]]}"}
    [[ -n $entry ]] && private+=("$entry")
  done <"$private_file"
fi

# What is allowed by rule: .githooks/scan-allow next to this script, `rule regex` a line.
declare -A allow=()
if [[ -r ${BASH_SOURCE[0]%/*}/scan-allow ]]; then
  while read -r name regex; do
    [[ -z $name || $name == '#'* || -z $regex ]] && continue
    allow[$name]+="${allow[$name]:+|}($regex)"
  done <"${BASH_SOURCE[0]%/*}/scan-allow"
fi
# Addresses that have published commits here: public already, as authors. The first set is every
# commit's (for the mail-address rule), the second only what a remote has (for a new author).
declare -A identities=() published=()
while read -r address; do identities[${address,,}]=1; done \
  < <(git log --all --format='%ae%n%ce' 2>/dev/null | sort -u)
while read -r address; do published[${address,,}]=1; done \
  < <(git log --remotes --format='%ae%n%ce' 2>/dev/null | sort -u)

# $1: rule, $2: what it found. True when .githooks/scan-allow lets it through.
allowed() {
  [[ $1 == mail-address && -n ${identities[${2,,}]:-} ]] && return 0
  [[ -n ${allow[$1]:-} && ${2,,} =~ ^(${allow[$1]})$ ]]
}

# $1: an author or committer address, $2: where. An address no remote has seen would become
# public with this commit: a wrong user.email shows here. Nothing to compare with before the
# first push.
check_identity() {
  ((${#published[@]})) || return 0
  [[ -z $1 || -n ${published[${1,,}]:-} ]] && return 0
  report "$2: new-author-address: no commit on a remote carries this address yet (git config user.email)"
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/scan-secrets.XXXXXX") || {
  echo "scan-secrets: cannot create a temporary directory; nothing was scanned." >&2
  exit 1
}
trap 'rm -rf "$tmp"' EXIT

hits=0
declare -A seen=()
# A merge is compared with each of its parents, so the same line can come up twice: report once.
report() {
  [[ -n ${seen[$*]:-} ]] && return
  seen[$*]=1
  printf 'scan-secrets: %s\n' "$*" >&2
  hits=$((hits + 1))
}
# The scan could not be done. Never a pass.
refuse() {
  printf 'scan-secrets: %s\n' "$*" >&2
  echo "scan-secrets: blocked: the scan could not be completed, so nothing is let through." >&2
  exit 1
}

check_path() {
  local path=$1 glob entry
  shopt -s nocasematch
  for entry in "${private[@]}"; do
    [[ $path == *"$entry"* ]] && report "$path: private string (.git/info/scan-secrets-deny) in the file name"
  done
  for glob in "${allow_paths[@]}"; do [[ /$path == $glob ]] && { shopt -u nocasematch; return; }; done
  for glob in "${deny_paths[@]}"; do
    if [[ /$path == $glob ]]; then report "$path: denied path (matches '$glob')"; break; fi
  done
  shopt -u nocasematch
}

# Values that stand in for a secret rather than being one: empty, a variable or command
# substitution, a template field, <...>, an ellipsis, xxx, ***, one repeated character, or a word
# such as changeme.
is_placeholder() {
  local v=$1 lv=${1,,} word
  [[ -z $v || -z ${v//"${v:0:1}"/} ]] && return 0
  [[ $v == \$* || $v == %* || $v == *'${'* || $v == *'$('* || $v == *'`'* ]] && return 0
  [[ $v == *'{'*'}'* || $v == *'<'*'>'* || $v == *...* || $v == *…* ]] && return 0
  [[ $lv == *xxx* || $v == *'***'* ]] && return 0
  word=${lv//[^a-z0-9]/}
  case $word in
    '' | changeme* | your* | example* | placeholder* | redacted* | dummy* | fake* | sample* | todo*) return 0 ;;
    password | passwd | passphrase | pass | pw | secret | token | key | user | username | value) return 0 ;;
    none | null | nil | true | false | yes | no | unset | undefined | empty | required | optional) return 0 ;;
    hidden | removed | string | str | bool | prompt | ask) return 0 ;;
  esac
  return 1
}

# $1: one candidate, name through value, as grep -o printed it.
assignment_is_secret() {
  local name sep value quoted=0 min exact=1 lv
  [[ $1 =~ ^([A-Za-z0-9_.-]+)[\"\']?[[:space:]]*(:=|=>|=|:)[[:space:]]*(.*)$ ]] || return 1
  name=${BASH_REMATCH[1],,} sep=${BASH_REMATCH[2]} value=${BASH_REMATCH[3]}
  if [[ $value == [\"\']* ]]; then
    quoted=1 value=${value:1}
  else
    while [[ $value == *[,\;\)\}\]] ]]; do value=${value%?}; done
  fi
  lv=${value,,}

  # Which kind of name: 1 for passwords, 2 for keys, tokens and secrets, which are longer and
  # have no spaces.
  if [[ $name =~ (passw(or)?d|passphrase) ]]; then
    min=6
    [[ $name =~ (passw(or)?d|passphrase)$ ]] || exact=0
  elif [[ $name =~ (^|[_.-])psk$ ]]; then
    min=6
  elif [[ $name =~ (secret|token|api[_-]?key|[_-]key|(private|access)key)$ ]]; then
    min=16
    # Names that end the same way and hold nothing secret.
    [[ $name =~ (pub(lic)?|cache|sort|primary|foreign|partition)[_-]?key$ ]] && return 1
    [[ $name =~ (gpg|pgp|signing|verif)[a-z0-9_.-]*key$ || $name =~ (next|page)[_-]?token$ ]] && return 1
  else
    return 1
  fi

  ((${#value} >= min)) || return 1
  is_placeholder "$value" && return 1
  # A file name, a command-line option or a URL. A URL with a password in it is the other rule's.
  [[ $value == /* || $value == '~'* || $value == ./* || $value == ../* || $value == --* ]] && return 1
  [[ $lv =~ ^[a-z][a-z0-9+.-]*:// ]] && return 1
  if ((!quoted)); then
    # Code rather than a literal: a call, a path such as a::b, a reference, a collection, a
    # dotted name, or a variable that is itself named after a secret.
    [[ $value == *'('* || $value == :* || $value == '&'* || $value == '*'* || $value == '['* || $value == '{'* ]] && return 1
    [[ $value =~ ^[A-Za-z_][A-Za-z0-9_]*([.][A-Za-z_][A-Za-z0-9_]*)+$ ]] && return 1
    [[ $lv =~ ^[a-z_][a-z0-9_]*$ && $lv =~ (pass|pwd|psk|secret|token|key|cred) ]] && return 1
  fi
  if ((min == 16)); then
    [[ $value =~ ^[A-Za-z0-9/+_=.~:@!#%^*-]+$ ]] || return 1
    # Words joined by _ . or - read as a name, not a key.
    [[ $value =~ ^[A-Za-z]+([_.-][A-Za-z]+)+$ ]] && return 1
  elif ((quoted && !exact)) && [[ $value == *[[:space:]]* ]]; then
    # password_prompt = "Enter the password", and the like.
    return 1
  fi
  return 0
}

# $1: one candidate, scheme://user:password@
url_has_password() {
  local password=${1#*://}
  password=${password#*:}
  password=${password%@}
  ((${#password} >= 3)) || return 1
  is_placeholder "$password" && return 1
  return 0
}

# Sets $place for line $1 of the text being scanned.
at() {
  if ((${#places[@]})); then place=${places[$1 - 1]:-$where}; else place="$where:$1"; fi
}

# $1: where the text came from, for the message. $2: the file that holds it, NULs removed.
# $3: text (default) or binary: binary runs only the token rules and the private strings, and
# does not print what matched. $4: optional file naming the place of each line of $2.
check_content() {
  local where=$1 file=$2 kind=${3:-text} rule entry n text place
  local -a places=()
  [[ -n ${4:-} ]] && mapfile -t places <"$4"
  for rule in "${token_rules[@]}"; do
    while IFS=: read -r n text; do
      [[ -n $n ]] || continue
      at "$n"
      if [[ $kind == binary ]]; then report "$place: ${rule%% *}"; else report "$place: ${rule%% *}: ${text:0:120}"; fi
    done < <(grep -anE -e "${rule#* }" <"$file" 2>/dev/null | cut -c1-200)
  done
  for entry in "${private[@]}"; do
    while IFS=: read -r n text; do
      [[ -n $n ]] || continue
      at "$n"
      if [[ $kind == binary ]]; then text=; else text=": ${text:0:120}"; fi
      report "$place: private string (.git/info/scan-secrets-deny)$text"
    done < <(grep -anFi -e "$entry" <"$file" 2>/dev/null | cut -c1-200)
  done
  [[ $kind == binary ]] && return
  for rule in "${nocase_rules[@]}"; do
    while IFS=: read -r n text; do
      [[ -n $n ]] && { at "$n"; report "$place: ${rule%% *}: ${text:0:120}"; }
    done < <(grep -anEi -e "${rule#* }" <"$file" 2>/dev/null | cut -c1-200)
  done
  for rule in "${privacy_rules[@]}"; do
    while IFS=: read -r n text; do
      [[ -n $n ]] || continue
      allowed "${rule%% *}" "$text" && continue
      at "$n"
      report "$place: ${rule%% *}: ${text:0:120}"
    done < <(grep -anoE -e "${rule#* }" <"$file" 2>/dev/null | cut -c1-200)
  done
  while IFS=: read -r n text; do
    [[ -n $n ]] && assignment_is_secret "$text" && { at "$n"; report "$place: credential-assignment: ${text:0:120}"; }
  done < <(grep -anoEi -e "$assign_re" <"$file" 2>/dev/null)
  while IFS=: read -r n text; do
    [[ -n $n ]] && url_has_password "$text" && { at "$n"; report "$place: url-with-password: ${text:0:120}"; }
  done < <(grep -anoEi -e "$url_re" <"$file" 2>/dev/null)
}

# $1: a blob. $2: where it is, for the message. Text is scanned as it is and UTF-16 text (with a
# byte order mark) after decoding. Anything else with a NUL in its first 8000 bytes is binary, as
# git has it: its raw bytes, NULs removed, still get the token rules and the private strings.
scan_blob() {
  local blob=$1 where=$2 mark size finding
  git cat-file blob "$blob" >"$tmp/blob" 2>"$tmp/err" || refuse "git cannot read $where: $(head -n1 "$tmp/err")"
  size=$(wc -c <"$tmp/blob")
  ((size > max_blob)) && report "$where: large-file: $((size / 1024 / 1024)) MiB"
  # A picture: what it carries besides the picture (where and with what it was taken, by whom).
  case $(head -c 4 "$tmp/blob" | od -An -tx1 | tr -d ' \n') in
    89504e47 | ffd8ff* | 47494638 | 52494646 | 49492a00 | 4d4d002a)
      if finding=$(python3 -I - "$tmp/blob" 2>/dev/null <<'PY'
import sys
from PIL import Image, ExifTags
im = Image.open(sys.argv[1])
found = []
exif = im.getexif()
if exif.get_ifd(0x8825):
    found.append("a GPS position")
names = [ExifTags.TAGS.get(t, hex(t)) for t in exif if t != 0x8825]
found += ["EXIF " + n for n in names if n not in ("Orientation", "XResolution", "YResolution", "ResolutionUnit", "ExifOffset", "ColorSpace", "YCbCrPositioning")]
plain = ("dpi", "gamma", "transparency", "background", "version", "duration", "loop", "extension",
         "interlace", "srgb", "chromaticity", "icc_profile", "jfif", "jfif_version", "jfif_unit",
         "jfif_density", "progressive", "progression", "adobe", "adobe_transform", "exif", "timestamp")
found += ["field " + k for k in im.info if k.lower() not in plain]
print(", ".join(found))
PY
      ); then
        [[ -n $finding ]] && report "$where: picture-metadata: $finding"
      else
        report "$where: picture-metadata: could not be read (python3 with Pillow)"
      fi
      ;;
  esac
  mark=$(head -c 2 "$tmp/blob" | od -An -tx1 | tr -d ' \n')
  if [[ $mark == fffe || $mark == feff ]] && iconv -f UTF-16 -t UTF-8 <"$tmp/blob" 2>/dev/null | tr -d '\0' >"$tmp/text"; then
    check_content "$where" "$tmp/text"
  elif (($(head -c 8000 "$tmp/blob" | tr -d -c '\0' | wc -c) > 0)); then
    tr -d '\0' <"$tmp/blob" >"$tmp/text"
    check_content "$where (binary)" "$tmp/text" binary
  else
    tr -d '\0' <"$tmp/blob" >"$tmp/text"
    check_content "$where" "$tmp/text"
  fi
}

# gitleaks 8.19+ has `gitleaks git`; older releases have `detect` and `protect`.
gitleaks_scan() {
  command -v gitleaks >/dev/null || return 0
  local args
  if gitleaks git --help >/dev/null 2>&1; then
    if [[ $1 == staged ]]; then args=(git --staged); else args=(git "--log-opts=$2"); fi
  else
    if [[ $1 == staged ]]; then args=(protect --staged); else args=(detect "--log-opts=$2"); fi
  fi
  if ! gitleaks "${args[@]}" --no-banner --redact >&2; then report "gitleaks found leaks (output above)"; fi
}

usage() {
  echo "usage: scan-secrets --staged | --message FILE | --range REV..." >&2
  exit 2
}

case "${1:-}" in
  --staged)
    # Staged blobs, not the working tree: mode, blob and path of everything added or changed.
    git diff --cached --raw -z --no-abbrev --no-renames --diff-filter=ACMRT >"$tmp/staged" 2>"$tmp/err" \
      || refuse "git cannot list the staged files: $(head -n1 "$tmp/err")"
    while IFS=' ' read -r -d '' _ mode _ blob _ && IFS= read -r -d '' path; do
      check_path "$path"
      [[ $mode == 160000 ]] && continue # a submodule: a commit, no content of its own
      if [[ $mode == 120000 ]]; then
        # A link out of the repository names a path on this machine, and leads nowhere elsewhere.
        target=$(git cat-file blob "$blob" 2>/dev/null)
        [[ $target == /* || $target == '~'* ]] && report "$path (staged): link-out: $target"
      fi
      scan_blob "$blob" "$path (staged)"
    done <"$tmp/staged"
    for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
      address=$(git var "$ident" 2>/dev/null) && address=${address#*<} && check_identity "${address%%>*}" "this commit"
    done
    gitleaks_scan staged
    ;;
  --message)
    [[ -r ${2:-} ]] || usage
    tr -d '\0' <"$2" >"$tmp/text"
    check_content "the commit message" "$tmp/text"
    ;;
  --range)
    shift
    (($#)) || usage
    # A merge is compared with each of its parents (-m): plain `git log -p` shows nothing for
    # it. Renames are shown as additions, so each file header names one path.
    log=(git -c core.quotePath=false log -m --no-renames --diff-filter=ACMRT --no-color
      --no-ext-diff --no-textconv)
    "${log[@]}" --format= --name-only -z "$@" >"$tmp/paths" 2>"$tmp/err" \
      || refuse "git cannot list the commits of '$*': $(head -n1 "$tmp/err")"
    while IFS= read -r -d '' path; do
      path=${path#$'\n'}
      [[ -n $path ]] && check_path "$path"
    done < <(sort -zu "$tmp/paths")

    # Added lines of every commit in the range, with the place of each. The diff is parsed by
    # its headers: every hunk says how many lines it has, so an added line is known by where
    # it stands, whatever it begins with. Binary files are noted with their blob.
    "${log[@]}" -p --full-index --src-prefix=a/ --dst-prefix=b/ --format='commit %H' "$@" >"$tmp/raw" 2>"$tmp/err" \
      || refuse "git cannot show the commits of '$*': $(head -n1 "$tmp/err")"
    : >"$tmp/added" >"$tmp/places" >"$tmp/binaries"
    tr -d '\0' <"$tmp/raw" | LC_ALL=C awk -v added="$tmp/added" -v places="$tmp/places" -v binaries="$tmp/binaries" '
      old > 0 || new > 0 {
        mark = substr($0, 1, 1)
        if (mark == "+") {
          new--; line++
          print substr($0, 2) >added
          print commit " " path ":" line >places
        } else if (mark == "-") old--
        else if (mark != "\\") { old--; new--; line++ }
        next
      }
      /^commit [0-9a-f]+$/ { commit = substr($2, 1, 12); next }
      /^diff --git / {
        # "diff --git a/PATH b/PATH": the two halves are the same length.
        rest = substr($0, 12)
        path = substr(rest, 3, (length(rest) - 1) / 2 - 2)
        blob = ""
        next
      }
      /^index / { split($2, ends, /\.\./); blob = ends[2]; next }
      /^Binary files / { print blob "\t" commit " " path >binaries; next }
      /^@@ / {
        split($0, part, " ")
        old = (part[2] ~ /,/) ? substr(part[2], index(part[2], ",") + 1) + 0 : 1
        new = (part[3] ~ /,/) ? substr(part[3], index(part[3], ",") + 1) + 0 : 1
        line = substr(part[3], 2) + 0 - (new > 0)
        next
      }' || refuse "cannot read the commits of '$*'"
    check_content "commits $*" "$tmp/added" text "$tmp/places"
    declare -A scanned=()
    while IFS=$'\t' read -r blob where; do
      [[ $blob =~ ^[0-9a-f]+$ && -z ${scanned[$blob]:-} ]] || continue
      scanned[$blob]=1
      scan_blob "$blob" "$where"
    done <"$tmp/binaries"

    # Whole binary files were scanned above; every other added file still gets its size checked,
    # and a picture its metadata (scan_blob), once per blob.
    "${log[@]}" --format= --raw --no-abbrev "$@" >"$tmp/raw" 2>"$tmp/err" \
      || refuse "git cannot list the files of '$*': $(head -n1 "$tmp/err")"
    while read -r _ mode _ blob _ path; do
      [[ $mode == 160000 || -n ${scanned[$blob]:-} ]] && continue
      scanned[$blob]=1
      case ${path,,} in
        *.png | *.jpg | *.jpeg | *.gif | *.webp | *.tif | *.tiff) scan_blob "$blob" "$path" ;;
        *) (($(git cat-file -s "$blob" 2>/dev/null || echo 0) > max_blob)) && report "$path: large-file" ;;
      esac
    done < <(sed -n 's/^:[0-7]* //p' "$tmp/raw" | tr '\t' ' ')
    while read -r commit author committer; do
      check_identity "$author" "commit ${commit:0:12} (author)"
      check_identity "$committer" "commit ${commit:0:12} (committer)"
    done < <(git log --format='%H %ae %ce' "$@" 2>/dev/null)

    # Messages, with who wrote and committed each: the private strings apply to those too.
    git log --format='commit %H%n%an <%ae>%n%cn <%ce>%n%B' "$@" >"$tmp/raw" 2>"$tmp/err" \
      || refuse "git cannot list the commit messages of '$*': $(head -n1 "$tmp/err")"
    tr -d '\0' <"$tmp/raw" >"$tmp/text"
    LC_ALL=C awk '/^commit [0-9a-f]+$/ { commit = substr($2, 1, 12) } { print "message of " commit }' \
      "$tmp/text" >"$tmp/places"
    check_content "commit messages $*" "$tmp/text" text "$tmp/places"
    gitleaks_scan range "$*"
    ;;
  *)
    usage
    ;;
esac

if ((hits)); then
  if [[ ${SECRET_SCAN_BYPASS:-} == 1 ]]; then
    echo "scan-secrets: $hits hit(s) ignored because SECRET_SCAN_BYPASS=1." >&2
    exit 0
  fi
  cat >&2 <<'MSG'
scan-secrets: blocked. This repository is public.
  Remove the file or value (git restore --staged <path>), or keep it out with .gitignore.
  Only if you have checked that a hit is a false positive: SECRET_SCAN_BYPASS=1 git commit ...
MSG
  exit 1
fi
exit 0
