#!/usr/bin/env bash
# Scan every commit about to be pushed, in case a commit skipped pre-commit (--no-verify), then
# run the tests.
set -uo pipefail
scan="$(git rev-parse --show-toplevel)/.githooks/scan-secrets"
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue # deleting a ref
  if [[ $remote_sha != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    "$scan" --range "$remote_sha..$local_sha" </dev/null || status=1
  else
    # A new ref, or the remote's commit is not in this clone (a force-push over commits never
    # fetched): there is no range to name, so scan every commit being pushed that is not on a
    # remote-tracking branch yet (all of them for a first push).
    "$scan" --range "$local_sha" --not --remotes </dev/null || status=1
  fi
done
((status)) && exit "$status"

# Then every test (tests/run.sh), on the files as they are here, before the code is public.
# PRE_PUSH_TESTS=0 git push ... skips them.
tests="$(git rev-parse --show-toplevel)/tests/run.sh"
if [[ ${PRE_PUSH_TESTS:-1} != 0 && -x $tests ]]; then
  echo "pre-push: running the tests (PRE_PUSH_TESTS=0 skips them)" >&2
  if ! "$tests" >"${TMPDIR:-/tmp}/pre-push-tests.$$" 2>&1 </dev/null; then
    tail -n 40 "${TMPDIR:-/tmp}/pre-push-tests.$$" >&2
    rm -f "${TMPDIR:-/tmp}/pre-push-tests.$$"
    echo "pre-push: the tests fail; nothing was pushed." >&2
    exit 1
  fi
  rm -f "${TMPDIR:-/tmp}/pre-push-tests.$$"
fi
exit 0
