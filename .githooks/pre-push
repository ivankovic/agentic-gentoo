#!/usr/bin/env bash
# Scan every commit about to be pushed, in case a commit skipped pre-commit (--no-verify).
set -uo pipefail
scan="$(git rev-parse --show-toplevel)/.githooks/scan-secrets"
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue # deleting a ref
  if [[ $remote_sha == "$zero" ]]; then
    # New ref: commits not on any remote-tracking branch yet (all of them for a first push).
    range=$(git rev-list "$local_sha" --not --remotes | tail -1)
    [[ -z $range ]] && continue
    if git rev-parse -q --verify "$range^" >/dev/null; then range="$range^..$local_sha"; else range=$local_sha; fi
  else
    range="$remote_sha..$local_sha"
  fi
  "$scan" --range "$range" || status=1
done
exit $status
