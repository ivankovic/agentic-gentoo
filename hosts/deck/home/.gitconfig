[user]
	email = marko@ivankovic.me
	name = Marko Ivankovic
[push]
	default = simple
	# First push of a new branch creates origin/<branch> and tracks it.
	autoSetupRemote = true
[core]
	# Remember which directories have no untracked files: `git status` in big repos (omnidiff,
	# 10k files) skips rescanning them. Part of git's feature.manyFiles.
	untrackedCache = true
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
[difftool "omnidiff"]
	cmd = omnidiff \"$LOCAL\" \"$REMOTE\"
[diff]
	tool = omnidiff
	external = omnidiff
[difftool]
	prompt = false
[safe]
	# A directory holding HEAD, objects/ and refs/ is a bare repository to git, found on its own
	# like .git: a jailed program could make one in ~/src with a config that runs commands, and
	# the host git guard (usr-local/bin/git) only knows .git. Bare repositories only when named.
	bareRepository = explicit
