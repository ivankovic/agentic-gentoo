[user]
	email = marko@ivankovic.me
	name = Marko Ivankovic
[push]
	default = simple
	# First push of a new branch creates origin/<branch> and tracks it.
	autoSetupRemote = true
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
[difftool "omnidiff"]
	cmd = omnidiff \"$LOCAL\" \"$REMOTE\"
[diff]
	tool = omnidiff
	external = omnidiff
[difftool]
	prompt = false
