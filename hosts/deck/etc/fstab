# /etc/fstab: static file system information.
#
# See the manpage fstab(5) for more information.
#
# NOTE: The root filesystem should have a pass number of either 0 or 1.
#       All other filesystems should have a pass number of 0 or greater than 1.
#
# NOTE: Even though we list ext4 as the type here, it will work with ext2/ext3
#       filesystems.  This just tells the kernel to use the ext4 driver.
#
# NOTE: You can use full paths to devices like /dev/sda3, but it is often
#       more reliable to use filesystem labels or UUIDs. See your filesystem
#       documentation for details on setting a label. To obtain the UUID, use
#       the blkid(8) command.

# <fs>			<mountpoint>	<type>		<opts>		<dump> <pass>

#LABEL=boot		/boot		ext4		defaults	1 2
#UUID=58e72203-57d1-4497-81ad-97655bd56494		/		xfs		defaults		0 1
#LABEL=swap		none		swap		sw		0 0
#/dev/cdrom		/mnt/cdrom	auto		noauto,ro	0 0

UUID=9afbf261-783f-4d96-b958-ac3a73692998	/		btrfs	noatime,compress=zstd:1,subvol=@		0 0
UUID=9afbf261-783f-4d96-b958-ac3a73692998	/home		btrfs	noatime,compress=zstd:1,subvol=@home		0 0
UUID=9afbf261-783f-4d96-b958-ac3a73692998	/.snapshots	btrfs	noatime,compress=zstd:1,subvol=@snapshots	0 0
UUID=9afbf261-783f-4d96-b958-ac3a73692998	/var/log	btrfs	noatime,compress=zstd:1,subvol=@var_log		0 0
UUID=9afbf261-783f-4d96-b958-ac3a73692998	/var/tmp	btrfs	noatime,compress=zstd:1,subvol=@var_tmp		0 0
# btrfs top level (subvolid 5) for btrbk, mounted on first access, unmounted when idle.
UUID=9afbf261-783f-4d96-b958-ac3a73692998	/mnt/btr_pool	btrfs	noatime,compress=zstd:1,subvolid=5,noauto,x-systemd.automount,x-systemd.idle-timeout=60	0 0
UUID=0E9D-1398					/efi		vfat	umask=0077					0 2

