# Hardware state every 2 s (10 s on battery) into the "vitals" journal namespace, kept for a few
# days by journald@vitals.conf, so the last minutes before an unexplained reset are on disk:
#   journalctl --namespace=vitals -b -1 -n 50
# Runs as root only to read RAPL's energy counters (root-only since CVE-2020-8694); otherwise it
# has no capabilities and sees the filesystem read-only.
[Unit]
Description=Log hardware vitals (temperatures, power, frequencies, pressure)
Documentation=file:///etc/deck-vitals/vitals.py

[Service]
ExecStart=/usr/bin/python3 -I -u /etc/deck-vitals/vitals.py
LogNamespace=vitals
Restart=always
RestartSec=5
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryMax=64M

[Install]
WantedBy=multi-user.target
