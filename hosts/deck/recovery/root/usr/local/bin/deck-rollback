#!/usr/bin/env bash
# deck-rollback: put the main system's root (@) back to one of its snapshots. Run with it unmounted
# (deck mount off).
#
# Lists the snapshots of @ (btrbk's hourly @.<time> and the emerge wrapper's @.pre-emerge.<time>),
# asks which, then on the btrfs top level: renames @ to @.broken.<now> and makes a writable
# snapshot of the chosen one the new @. Nothing is deleted: to undo, do the same with @.broken.*.
# /home, /var/log, /var/tmp and the snapshots are separate subvolumes and stay as they are.
#
# The kernels on the ESP aren't part of @. If the restored root lacks the modules of the kernel
# that boots by default, it says so: pick a matching kernel in the boot menu (Space at power-on), or
# reinstall it from inside: deck mount rw; deck chroot; emerge --config sys-kernel/gentoo-kernel.
set -euo pipefail
. /etc/deck-recovery.conf
LUKS=$MAIN_LUKS
NAME=$MAIN_NAME
TOP=/mnt/$NAME-top

findmnt -rn "/mnt/$NAME" >/dev/null && { echo "deck-rollback: $NAME is mounted; run 'deck mount off' first" >&2; exit 1; }
if [[ -e /dev/mapper/$NAME ]] && cryptsetup status "$NAME" | grep -q readonly; then
  echo "deck-rollback: $NAME is open read-only; run 'deck mount off' first" >&2; exit 1
fi
[[ -e /dev/mapper/$NAME ]] || cryptsetup open "$LUKS" "$NAME"
mkdir -p "$TOP"
mount -o subvolid=5 "/dev/mapper/$NAME" "$TOP"
trap 'umount "$TOP"' EXIT

mapfile -t snaps < <(cd "$TOP/@snapshots" && ls -d @.* 2>/dev/null | awk -F. '{print $NF "\t" $0}' | sort | cut -f2)  # by time
((${#snaps[@]})) || { echo "deck-rollback: no snapshots of @ in @snapshots" >&2; exit 1; }
echo "Snapshots of the root, oldest first:"
for i in "${!snaps[@]}"; do printf '  %3d  %s\n' "$((i + 1))" "${snaps[i]}"; done
echo
read -r -p "Roll back to number (Enter to cancel): " n
[[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#snaps[@]})) || { echo "deck-rollback: cancelled"; exit 0; }
pick=${snaps[n - 1]}
now=$(date +%Y%m%dT%H%M%S)
echo
echo "@ becomes @.broken.$now, and a writable copy of @snapshots/$pick becomes @."
read -r -p "Type ROLLBACK to go ahead: " answer
[[ $answer == ROLLBACK ]] || { echo "deck-rollback: cancelled; nothing changed"; exit 0; }

mv "$TOP/@" "$TOP/@.broken.$now"
btrfs subvolume snapshot "$TOP/@snapshots/$pick" "$TOP/@" >/dev/null
echo "deck-rollback: @ is now $pick; the previous root is @.broken.$now (delete it once happy:"
echo "  mount -o subvolid=5 /dev/mapper/$NAME $TOP; btrfs subvolume delete $TOP/@.broken.$now)"

# Does the restored root have modules for the kernels on the ESP?
echo
ls /efi >/dev/null 2>&1 || true  # the ESP is automounted
modules=$(ls "$TOP/@/usr/lib/modules" 2>/dev/null)
echo "Kernel modules in the restored root: $(echo $modules)"
for uki in /efi/EFI/Linux/gentoo-*.efi; do
  [[ -e $uki ]] || continue
  name=${uki##*/gentoo-}; ver=${name%.efi}; ver=${ver%%+*}
  if grep -qx "$ver" <<<"$modules"; then echo "  ok       $ver"; else echo "  MISSING  $ver: boot another kernel, or reinstall it (see the top of this script)"; fi
done
