#!/usr/bin/env bash
# deck-mount [rw]: open deck's main LUKS partition and mount its subvolumes under /mnt/deck.
# Read-only by default, so looking can't change anything; `deck-mount rw` remounts writable for
# repairs (and `deck-chroot` needs it). `deck-mount off` unmounts and closes.
set -euo pipefail
LUKS=/dev/disk/by-uuid/9e6393f4-5800-4971-aa10-aa2ea004c044
MNT=/mnt/deck
mode=${1:-ro}

if [[ $mode == off ]]; then
  for m in $(findmnt -rn -o TARGET | grep "^$MNT" | sort -r); do umount "$m"; done
  cryptsetup close deck 2>/dev/null || true
  echo "deck-mount: closed"; exit 0
fi

if [[ ! -e /dev/mapper/deck ]]; then
  if [[ $mode == rw ]]; then cryptsetup open "$LUKS" deck; else cryptsetup open --readonly "$LUKS" deck; fi
fi

if findmnt -rn "$MNT" >/dev/null; then
  [[ $mode == rw ]] && { cryptsetup status deck | grep -q readonly && { echo "deck-mount: opened read-only; run 'deck-mount off' then 'deck-mount rw'" >&2; exit 1; }; mount -o remount,rw "$MNT"; }
else
  mkdir -p "$MNT"
  opts=$([[ $mode == rw ]] && echo rw || echo ro)
  mount -o "$opts,subvol=@" /dev/mapper/deck "$MNT"
  for sub in home:@home var/log:@var_log var/tmp:@var_tmp .snapshots:@snapshots; do
    mount -o "$opts,subvol=${sub#*:}" /dev/mapper/deck "$MNT/${sub%%:*}"
  done
  findmnt /efi >/dev/null && mount --bind /efi "$MNT/efi"
fi
findmnt -R "$MNT" -o TARGET,OPTIONS | cut -c1-100
cat <<'TXT'

Look:     journalctl --root=/mnt/deck --list-boots
          journalctl --root=/mnt/deck -b -1 -p warning
          journalctl --root=/mnt/deck --namespace=vitals -b -1 -n 50    (hardware, last 100 s)
          ls /mnt/deck/var/lib/systemd/pstore        btrfs subvolume list /mnt/deck/.snapshots
Repair:   deck-mount rw && deck-chroot
TXT
