RUST_MIN_VER="1.85.0"

inherit cargo

DESCRIPTION="Play chess in the terminal: local, against a UCI engine, or on Lichess"
HOMEPAGE="https://github.com/thomas-mauran/chess-tui"
SRC_URI="
	https://github.com/thomas-mauran/chess-tui/archive/refs/tags/${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD CDLA-Permissive-2.0 GPL-3 GPL-3+ ISC MIT MPL-2.0
	Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="+sound"

# Sound goes rodio -> cpal -> alsa-sys. TLS for Lichess is rustls on aws-lc-rs, built from C.
DEPEND="sound? ( media-libs/alsa-lib )"
RDEPEND="${DEPEND}"
BDEPEND="sound? ( virtual/pkgconfig )"

src_configure() {
	local myfeatures=( $(usev sound) )
	cargo_src_configure --no-default-features
}

src_install() {
	cargo_src_install
	dodoc README.md
}

pkg_postinst() {
	elog "Play against an engine with e.g. games-board/stockfish:"
	elog "  chess-tui -e /usr/bin/stockfish   (the path is remembered)"
}
