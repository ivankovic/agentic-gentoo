# edition 2024
RUST_MIN_VER="1.85.0"

inherit cargo

DESCRIPTION="A terminal dashboard for GitHub: inbox, pull requests, issues, reviews and diffs"
HOMEPAGE="https://github.com/chenyukang/ghr"
SRC_URI="
	https://github.com/chenyukang/ghr/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD ISC MIT MPL-2.0 Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

# rusqlite builds its own SQLite ("bundled"); TLS is rustls on ring. No system libraries.
QA_FLAGS_IGNORED="usr/bin/ghr"

src_install() {
	cargo_src_install
	dodoc README.md
}

pkg_postinst() {
	elog "ghr signs in with the GitHub CLI's login (gh auth login), or a classic token in"
	elog "GHR_GITHUB_TOKEN. Its config, cache and logs are in ~/.ghr."
}
