#!/bin/bash
# deck: one name for this machine's own tools, as git does it. `deck <tool> [args]` runs
# deck-<tool>; `deck` alone (or `deck help`) lists the tools this system has; `deck help <tool>`
# shows a script's header comment, and a program's --help (scripts aren't asked: deck-nosnap
# --help would make a subvolume named --help, and deck-rollback would roll back). The same script is in Deck recovery (recovery/build.sh), which has tools
# of its own: there it lists those, and says where the main system's are.
#
# A deck-* file is one of ours; it's typed as `deck <tool>`. Those not listed below (daemons, what
# units and the panel run) run the same way, unlisted.
set -euo pipefail

# name, what it's for: the main system's, then the recovery system's.
main=(
	"patches|packages, local patches on their way upstream, usage, AI reviews (a TUI)"
	"mail|mail: sync, unlock, which PDFs go to Nextcloud, top senders"
	"nosnap|keep rebuildable folders out of the btrfs snapshots"
)
recovery=(
	"mount|the main system at /mnt/deck, read-only (rw, off, check)"
	"chroot|a shell inside the main system, after deck mount rw"
	"rollback|root back to one of its snapshots"
)

in_recovery() { grep -qx 'NAME="Deck recovery"' /etc/os-release 2>/dev/null; }

list() {
	local here=("${main[@]}") there=("${recovery[@]}") where="Deck recovery (boot it from the menu)"
	if in_recovery; then
		here=("${recovery[@]}") there=("${main[@]}") where="the main system (deck mount rw, then deck chroot)"
		echo "deck, in recovery: the tools this system has"
	else
		echo "deck: this machine's own tools"
	fi
	echo
	local t
	for t in "${here[@]}"; do
		command -v "deck-${t%%|*}" >/dev/null && printf '  deck %-10s %s\n' "${t%%|*}" "${t#*|}"
	done
	echo
	printf 'In %s: deck' "$where"
	for t in "${there[@]}"; do printf ' %s' "${t%%|*}"; done
	echo
	echo "deck help <tool>: its own help."
}

# Where a tool is when this system doesn't have it.
elsewhere() {
	local t
	if in_recovery; then
		for t in "${main[@]}"; do
			[[ ${t%%|*} == "$1" ]] && { echo "deck $1 is in the main system: deck mount rw, then deck chroot" >&2; return; }
		done
	else
		for t in "${recovery[@]}"; do
			[[ ${t%%|*} == "$1" ]] && { echo "deck $1 is in Deck recovery: boot it from the menu" >&2; return; }
		done
	fi
	echo "deck: no tool $1; deck lists them" >&2
}

# A script's header: its docstring (Python) or the comments under the #! line. A program's --help.
help() {
	local tool=$1 f
	[[ $tool =~ ^[a-z][a-z0-9-]*$ ]] && f=$(command -v "deck-$tool") || { elsewhere "$tool"; exit 127; }
	if [[ $(head -c2 "$f") != '#!' ]]; then
		exec "$f" --help
	elif head -1 "$f" | grep -q python; then
		awk '/^"""/ && !n++ { sub(/^"""/, ""); p = 1 } p { if (sub(/"""$/, "")) { print; exit } print }' "$f"
	else
		awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$f"
	fi
	exit 0
}

run() {
	local tool=$1
	shift
	# A name, not a path: deck ../x would run something else.
	[[ $tool =~ ^[a-z][a-z0-9-]*$ ]] || { echo "deck: no tool $tool; deck lists them" >&2; exit 2; }
	command -v "deck-$tool" >/dev/null || { elsewhere "$tool"; exit 127; }
	exec "deck-$tool" "$@"
}

case ${1-} in
"" | help | -h | --help)
	[[ ${1-} == help && -n ${2-} ]] && help "$2"
	list
	;;
*) run "$@" ;;
esac
