#!/bin/bash
# jail: run a command (default: a shell) where only ~/src is writable and nothing secret is reachable.
#
#   jail                 a shell in the jail, in the current directory if it is under ~/src (or
#                        another work root, ~/.config/jail/roots), else in ~/src
#   jail claude          any program, e.g. a coding agent
#   jail [OPTIONS] [--] COMMAND
#     --no-src           without ~/src: for programs that read untrusted code (deck patches review)
#     --ro DIR, --rw DIR one more directory, read-only or writable (repeatable). Repositories in
#                        a --rw DIR (it, or up to two levels down) get the same read-only parts
#                        as those in ~/src, but host git is only guarded in the work roots
#     --chdir DIR        start there instead of the current directory
#
# What the jailed program sees (bubblewrap: its own user, PID, IPC, UTS and cgroup namespaces,
# and its own network through pasta: the internet, but not the host's loopback services or abstract
# unix sockets, such as Xwayland's):
#
#   ~/src                read-write, except each repository's .git/config, .git/hooks and hooks
#                        directory (core.hooksPath, its own or a relative one from ~/.gitconfig),
#                        read-only: git on the host runs those. That alone can't keep host git
#                        safe (a new repository, a renamed .git, .git/commondir, a hooks directory
#                        that didn't exist yet...): /usr/local/bin/git, the host's git, refuses to
#                        run in a repository whose config or hooks changed until `git trust`.
#                        Also read-only, where they exist: each repository's
#                        .claude/settings.json and .claude/settings.local.json (Claude Code on the
#                        host runs the hooks they name)
#   work roots           the same as ~/src, for each line of ~/.config/jail/roots (a directory in
#                        the home, e.g. `uni`)
#   home                 its own, ~/.local/share/jail/home, kept between runs: the tools' logins,
#                        settings, history and caches (cargo registry, Go modules, sccache, npm)
#   from the real home   read-only: toolchains (~/.rustup, ~/.cargo/bin, ~/go/bin, ~/.local/bin
#                        and what it links to), ~/.bashrc, ~/.gitconfig, ~/.config/{git,go,nvim},
#                        ~/.local/share/nvim
#   system               /usr, /etc, /opt, /sys read-only; private /tmp, /run, /var/tmp
#
# Not there: the rest of the home (~/.ssh, ~/.gnupg, ~/.config/gh, ~/.cargo/credentials.toml,
# browser, mail), the SSH and GPG agents, D-Bus, the Wayland session. So no git push, no
# `gh`, no crates.io publishing, no clipboard. sudo can't work (no_new_privs).
#
# Limits: everything jailed shares jail.slice (home/.config/systemd/user/jail.slice): a fifth of
# the desktop's CPU priority and at most 90% of the CPU, memory throttled above 22 GiB and capped at
# 24 GiB, 4 GiB of swap, 2000 tasks; systemd-oomd kills inside it when it stalls on memory.
#
# Not a defence against what you later run on the host from ~/src: build scripts, Makefiles,
# tests and tracked hook files a jailed program changed run with your full rights. Nor against
# what host tools load from a directory on their own, which the jail can write and no mount here
# keeps: a .claude/settings.json that didn't exist yet (its hooks), CLAUDE.md and .claude/ in
# any directory, .cargo/config.toml, .envrc (direnv, once allowed), nvim's exrc (.nvim.lua,
# .nvimrc, .exrc, where 'exrc' is on), Python packages installed editable from ~/src, and the
# like. Read the diff first, untracked files too, before working there on the host.
set -euo pipefail

# Two stages: this script starts the scope and pasta (the jail's own network), then runs again
# inside them (JAIL_STAGE=inner) to set up the mounts and start bubblewrap. The mounts that come
# from repositories are opened there and handed to bwrap as descriptors, which pasta wouldn't pass
# on from outside.
src=$HOME/src
# The work roots (roots, in_roots), from the file the host git guard reads them from too:
# /usr/local/share/jail/roots.sh.
self=${BASH_SOURCE[0]}
[[ $self == */* ]] || self=./$self
# shellcheck source=../share/jail/roots.sh
. "${self%/*}/../share/jail/roots.sh"
declare -F in_roots >/dev/null || { echo "jail: ${self%/*}/../share/jail/roots.sh is missing; not starting" >&2; exit 1; }
jhome=${XDG_DATA_HOME:-$HOME/.local/share}/jail/home
DNS_ADDR=169.254.1.1
orig=("$@")

nosrc= chdir= extra=() rwdirs=()
while (($#)); do
	case $1 in
	--no-src) nosrc=1 ;;
	--ro | --rw)
		[[ -d ${2-} ]] || { echo "jail: $1 needs a directory" >&2; exit 2; }
		d=$(realpath "$2")
		if [[ $1 = --ro ]]; then extra+=(--ro-bind "$d" "$d"); else extra+=(--bind "$d" "$d"); rwdirs+=("$d"); fi
		shift ;;
	--chdir)
		chdir=$(realpath "${2:?jail: --chdir needs a directory}")
		shift ;;
	--) shift; break ;;
	*) break ;;
	esac
	shift
done

dir=$src
in_roots "$PWD" >/dev/null && dir=$PWD
[[ -n $nosrc ]] && dir=$HOME
[[ -n $chdir ]] && dir=$chdir

if [[ ${JAIL_STAGE-} != inner ]]; then
	# The jail home's setup: the directories its mounts need, and its caches as their own btrfs
	# subvolumes, out of the hourly snapshots (deck-nosnap). Once, recorded outside the jail home,
	# and only while no jail runs: the jail home is the jail's to change, and a jail running could
	# swap a symlink in between a check here and the work. A symlink found is left alone.
	setup=${XDG_STATE_HOME:-$HOME/.local/state}/jail/home-set-up
	if [[ ! -e $setup ]] && [[ $(systemctl --user show -P TasksCurrent jail.slice 2>/dev/null) =~ ^(0|\[not set\])?$ ]]; then
		done=1
		for d in "$jhome/.cargo" "$jhome/go"; do
			if [[ -L $d ]]; then done=; else mkdir -p -- "$d"; fi
		done
		if command -v deck-nosnap >/dev/null; then
			for d in .cache .cargo/registry go/pkg .npm; do
				d=$jhome/$d
				if [[ -L $d || -L ${d%/*} ]]; then done=; else deck-nosnap "$d" >/dev/null || done=; fi
			done
		fi
		[[ -n $done ]] && mkdir -p -- "${setup%/*}" && : >"$setup"
	fi
	# The network: pasta gives the jail its own namespace, with the internet and DNS (forwarded to
	# the host's resolver from DNS_ADDR), but not the host's loopback (--no-map-gw) and no forwarded
	# ports. Inside it, the user shows as root (mapped to the user): bwrap is told the real ids.
	# Not exec: this script stays the terminal's foreground process, so deck-terminals can tell a
	# jailed program apart and reopen it in the jail.
	JAIL_STAGE=inner JAIL_UID=$UID JAIL_GID=${GROUPS[0]} \
		systemd-run --user --scope --slice=jail.slice --collect --quiet --unit="jail-$$.scope" -- \
		pasta --quiet --config-net --no-map-gw -t none -u none -T none -U none --dns-forward "$DNS_ADDR" -- \
		"$0" "${orig[@]}"
	exit
fi

# The jail's resolv.conf: handed to bwrap as a descriptor, no file with a name anyone could have
# made first.
exec {resolv}<<<"nameserver $DNS_ADDR"
args=(
	--unshare-user --uid "$JAIL_UID" --gid "$JAIL_GID"
	--unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup-try
	--die-with-parent --hostname jail
	--ro-bind /usr /usr
	--symlink usr/bin /bin --symlink usr/sbin /sbin --symlink usr/lib /lib --symlink usr/lib64 /lib64
	--ro-bind /etc /etc
	--ro-bind-try /opt /opt
	--ro-bind /sys /sys
	--proc /proc --dev /dev
	--tmpfs /tmp --tmpfs /run --tmpfs /var --dir /var/tmp
	--perms 0444 --ro-bind-data "$resolv" /etc/resolv.conf
	--bind "$jhome" "$HOME"
)
# No user namespaces of its own inside (they open kernel interfaces the jail has no use for), where
# this bwrap can do that.
[[ $(bwrap --help 2>&1) == *--disable-userns* ]] && args+=(--disable-userns)
# Only with the kernel's legacy TIOCSTI (it's off here): input pushed into the terminal would run
# in the host shell after the jail, so the jail gets a session of its own.
tiocsti=
read -r tiocsti </proc/sys/dev/tty/legacy_tiocsti 2>/dev/null || true
[[ $tiocsti == 0 ]] || args+=(--new-session)
[[ -n $nosrc ]] || for r in "${roots[@]}"; do args+=(--bind "$r" "$r"); done

ro=(
	.rustup .cargo/bin .cargo/config.toml .cargo/env go/bin
	.local/bin .local/share/claude .local/share/uv
	.bashrc .gitconfig .config/git .config/go .config/nvim .local/share/nvim
)
for p in "${ro[@]}"; do
	[[ -e $HOME/$p ]] && args+=(--ro-bind "$HOME/$p" "$HOME/$p")
done

# Before the repositories' read-only mounts, so a --rw can't undo them.
args+=("${extra[@]}")

# Repositories up to two levels down (in a --rw directory: it, or up to two levels down): what git
# and Claude Code on the host execute stays read-only. Nothing from a
# repository (a jailed program may have written it) becomes a mount source unless it is a real
# directory or file under ROOT. Each is opened first, then checked where it really is, and bwrap
# mounts that open descriptor: a jail running meanwhile can't swap it for a symlink between the
# check and the mount. Anything that should be protected and can't be (a symlink, not a plain file
# or directory, can't be opened, leads out) stops the jail from starting: never a silent gap.
# No process per repository: one realpath, one readlink, git only for a config naming hooksPath.
refuse() {
	echo "jail: $1; not starting" >&2
	exit 1
}
pinned=() # descriptor, path, root; three entries each
pin() { # PATH ROOT
	local fd
	[[ -L $1 ]] && refuse "$1 is a symlink"
	[[ -f $1 || -d $1 ]] || refuse "$1 is not a plain file or directory"
	exec {fd}<"$1" || refuse "can't open $1"
	pinned+=("$fd" "$1" "$2")
}
# Writable in this jail: the work roots and the --rw directories. Prints which one PATH is in.
writable=("${rwdirs[@]}")
[[ -n $nosrc ]] || writable+=("${roots[@]}")
in_writable() {
	local r
	for r in "${writable[@]}"; do [[ $1/ == "$r"/* ]] && { printf '%s' "$r"; return 0; }; done
	return 1
}
gits=()
mapfile -d '' gits < <({
	# (|| true: a directory find can't read must not end the list early.)
	[[ -n $nosrc ]] || find "${roots[@]}" -mindepth 2 -maxdepth 3 -name .git -type d -prune -print0 2>/dev/null || true
	((${#rwdirs[@]})) && find "${rwdirs[@]}" -mindepth 1 -maxdepth 3 -name .git -type d -prune -print0 2>/dev/null
	true
} | sort -zu)
# A core.hooksPath for every repository (~/.gitconfig, /etc/gitconfig): a relative one is a
# directory in each repository, like one of its own; an absolute one is protected once, where the
# jail could write it. From /, as below.
ghooks=$(/usr/bin/git -C / config --type=path --get core.hooksPath 2>/dev/null || true)
if ((${#gits[@]})); then
	if [[ $ghooks == /* ]]; then
		hroot=$(in_writable "$(realpath -m -- "$ghooks")") && [[ -e $ghooks || -L $ghooks ]] && pin "$ghooks" "$hroot"
		ghooks=
	fi
	mapfile -d '' repos < <(realpath -m -z -- "${gits[@]%/.git}")
	for i in "${!gits[@]}"; do
		git=${gits[i]} repo=${repos[i]}
		[[ -L $git ]] && refuse "$git is a symlink"
		[[ -e $git/config || -L $git/config ]] && pin "$git/config" "$repo"
		[[ -e $git/hooks || -L $git/hooks ]] && pin "$git/hooks" "$repo"
		# Claude Code's project settings, where there are any: they name hooks it runs. One that
		# isn't there can't be a mount (see the top).
		for f in "$repo/.claude/settings.json" "$repo/.claude/settings.local.json"; do
			[[ -e $f || -L $f ]] && pin "$f" "$repo"
		done
		cfg= hooks=
		[[ -f $git/config ]] && { IFS= read -rd '' cfg <"$git/config" || true; }
		if [[ ${cfg,,} == *hookspath* ]]; then
			# The file itself, read by the real git: no include, nothing run. From /: git would read
			# the current directory's repository too, whatever its config is (a FIFO hangs it).
			hooks=$(/usr/bin/git -C / config --file "$git/config" --type=path --get core.hooksPath 2>/dev/null || true)
		fi
		[[ -n $hooks ]] || hooks=$ghooks
		[[ -n $hooks && $hooks != /* ]] && hooks=$repo/$hooks
		# Where the jail can write, it is protected. Elsewhere the jail can't reach it, or it's in
		# the jail home, where it is the jail's anyway (the host git guard watches it). One that
		# doesn't exist yet can't be a mount: the guard sees it appear.
		if [[ -n $hooks ]] && hroot=$(in_writable "$(realpath -m -- "$hooks")") && [[ -e $hooks || -L $hooks ]]; then
			pin "$hooks" "$hroot"
		fi
	done
fi
if ((${#pinned[@]})); then
	links=()
	for ((i = 0; i < ${#pinned[@]}; i += 3)); do links+=("/proc/self/fd/${pinned[i]}"); done
	mapfile -d '' real < <(readlink -z -- "${links[@]}")
	for ((i = 0, j = 0; i < ${#pinned[@]}; i += 3, j++)); do
		[[ ${real[j]-}/ = "${pinned[i + 2]}"/* ]] || refuse "${pinned[i + 1]} leads out of ${pinned[i + 2]} (to ${real[j]-?})"
		args+=(--ro-bind-fd "${pinned[i]}" "${pinned[i + 1]}")
	done
fi

# A clean environment: nothing from the session leaks in (agent sockets, tokens, D-Bus).
env=(--clearenv --setenv HOME "$HOME" --setenv USER "$USER" --setenv LOGNAME "$USER"
	--setenv SHELL /bin/bash --setenv JAIL 1
	# Without an address, D-Bus clients start a private session bus with dbus-launch, and nothing
	# ever stops it: `gh auth token` (run by Claude Code every 30 minutes) left a dbus-daemon and
	# a gnome-keyring-daemon behind on each call. An address that can't connect makes them fail.
	--setenv DBUS_SESSION_BUS_ADDRESS unix:path=/dev/null/no-session-bus
	--setenv PATH "$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin")
for v in TERM COLORTERM LANG LC_ALL LC_CTYPE LC_MESSAGES TZ EDITOR VISUAL; do
	[[ -n ${!v-} ]] && env+=(--setenv "$v" "${!v}")
done

(($#)) || set -- /bin/bash -i

exec bwrap "${args[@]}" "${env[@]}" --chdir "$dir" -- "$@"
