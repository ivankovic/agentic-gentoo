#!/usr/bin/env python3
"""deck-attention: things on deck that want a look, as one line each.
`deck-attention --details` explains each line, for the maintenance details terminal, and marks
the events (crashes, an unclean shutdown) as seen: they're dropped until a newer one happens.
`--seen` only marks them. `--json` is for the status bar (deck-status): each item with how soon
it wants a look, "now", "soon" or "backlog" (in the bar's popup only), its line and its detail.

  repos     work that exists only on deck: a repository in ~/src with changes not committed, or
            commits on no remote, for more than a day; a week or more: soon, else backlog
  drift     config files that differ between deck and the agentic-gentoo repo (`./deploy.sh`):
            edited on deck and not in the repo, or changed in the repo and not deployed
  crashes   programs that crashed (dumped core) in the last 3 days, from coredumpctl; not
            programs in Portage's build directory (package tests during an emerge)
  unclean   the previous boot ended in a crash, reset or power loss, in the last 7 days
            (/var/lib/deck-health/unclean, written by etc/deck-health/check.py)
  portage   no @world update for 14 days, unread Gentoo news, preserved libraries waiting for
            `emerge @preserved-rebuild`, depclean blocked; from /var/lib/deck-health/portage.json
            (etc/deck-health/portage.py, run as root after syncs and emerges)
  snapshots build output inside the hourly snapshots of @home: ~/.cache, or any folder in the
            home marked as a cache (CACHEDIR.TAG: every cargo target/), that isn't its own
            subvolume (fix: deck-nosnap DIR)
  reviews   findings of AI reviews (deck patches review, tools/deck) nobody has decided about yet, and
            the daily automatic reviews that failed; decide in deck's Review tab (f, then x/n/w)
  scans     updates the scan for malicious code (deck patches scan) flagged or couldn't scan in the
            last 14 days: the emerge wrapper refuses them until allowed
  disk      / or /efi more than 85% full (btrfs slows down and can fail to write when nearly full;
            a full ESP fails the next kernel install)

Runs as the desktop user and takes well under a second. The only thing it writes is when the
events were last seen, in ~/.local/state/deck-attention/seen.
"""
import collections
import datetime
import json
import os
import pathlib
import subprocess
import sys
import threading
import time

HOME = pathlib.Path.home()
SRC = HOME / "src"
REPO = SRC / "agentic-gentoo"
PORTAGE = pathlib.Path("/var/lib/deck-health/portage.json")
UNCLEAN = pathlib.Path("/var/lib/deck-health/unclean")
SEEN = pathlib.Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "deck-attention/seen"
NEWS = pathlib.Path("/var/lib/gentoo/news")
REVIEWS = pathlib.Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "deck/reviews/runs"
SCANS = pathlib.Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "deck/scan"
SCAN_DAYS = 14
DAY = 86400
REPO_GRACE = 1 * DAY
REPO_SOON = 7 * DAY
CRASH_DAYS = 3
UNCLEAN_DAYS = 7
WORLD_DAYS = 14
FULL = 85


def run(*cmd, cwd=None):
    return subprocess.run(cmd, capture_output=True, text=True, cwd=cwd)


def plural(n, word, words=None):
    return f"{n} {word}" if n == 1 else f"{n} {words or word + 's'}"


def parallel(*calls):
    """Run the calls side by side (they mostly wait on git and other programs); their results in
    order. Threads, not concurrent.futures, which takes 35 ms to import."""
    results = [None] * len(calls)
    def call(i, f):
        results[i] = f()
    threads = [threading.Thread(target=call, args=(i, f)) for i, f in enumerate(calls)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return results


def repos():
    """[(name, summary, detail lines)] for repositories with work older than REPO_GRACE."""
    found = sorted(git.parent for git in SRC.glob("*/.git"))
    return [s for s in parallel(*[lambda r=r: repo_state(r) for r in found]) if s]


def repo_state(repo):
    """(name, summary, detail lines, age in seconds), or None when there's nothing old to report."""
    now = time.time()
    # --no-optional-locks: don't refresh the index, so this never collides with git you run.
    status = run("git", "--no-optional-locks", "status", "--porcelain=v1", "-z", cwd=repo).stdout
    changed, entries = [], iter(status.split("\0"))
    for e in entries:
        if len(e) > 3:
            changed.append(e[3:])
            if e[0] in "RC":  # a rename or copy is followed by its old path
                next(entries, None)
    # How long uncommitted: the oldest change still on disk (deleted files don't count).
    ages = [now - (repo / f).lstat().st_mtime for f in changed if (repo / f).exists()]
    old_changes = changed and (max(ages, default=0) > REPO_GRACE or not ages)
    # Commits on local branches that no remote has, with their commit times.
    log = run("git", "log", "--branches", "--not", "--remotes", "--format=%ct %h %s", cwd=repo).stdout
    unpushed = [l.split(" ", 1) for l in log.splitlines() if l]
    old_unpushed = any(now - int(t) > REPO_GRACE for t, _ in unpushed)
    if not (old_changes or old_unpushed):
        return None
    parts = []
    if changed:
        parts.append(plural(len(changed), "change"))
    if unpushed:
        parts.append(plural(len(unpushed), "unpushed commit"))
    detail = [f"  {s}" for _, s in unpushed[:5]] + [f"  changed: {f}" for f in changed[:10]]
    if len(changed) > 10:
        detail.append(f"  ... and {len(changed) - 10} more")
    age = max(ages + [now - int(t) for t, _ in unpushed], default=0)
    return repo.name, ", ".join(parts), detail, age


# Where deploy.sh installs each part of hosts/deck (its targets(); keep the two in step).
DEPLOY_MAP = {"home": HOME, "etc": pathlib.Path("/etc"), "portage": pathlib.Path("/etc/portage"),
              "usr-local": pathlib.Path("/usr/local")}


def drift():
    """[(status, path)] where deck and the repo disagree, as `./deploy.sh deck` would list them
    (files it can't read are left out); None when the repo isn't there. Compared here instead of
    running deploy.sh, which starts a cmp per file: ~20 ms instead of ~230."""
    if not (REPO / "deploy.sh").exists():
        return None
    out = run("git", "ls-files", "-z", "--", *[f"hosts/deck/{d}" for d in DEPLOY_MAP], cwd=REPO).stdout
    found = []
    for src in filter(None, out.split("\0")):
        top, _, rest = src.removeprefix("hosts/deck/").partition("/")
        dst = DEPLOY_MAP[top] / rest
        try:
            if dst.read_bytes() != (REPO / src).read_bytes():
                found.append(("changed:", str(dst)))
        except FileNotFoundError:
            if not dst.exists():
                found.append(("new:", str(dst)))
        except OSError:
            pass  # unreadable without root
    return found


def crashes():
    """{program: [times]} for core dumps in the last CRASH_DAYS days."""
    r = run("coredumpctl", "--json=short", "--no-pager", f"--since=-{CRASH_DAYS}d", "list")
    try:
        entries = json.loads(r.stdout) if r.stdout.strip() else []
    except ValueError:
        return {}
    found = collections.defaultdict(list)
    for e in entries:
        if (e.get("exe") or "").startswith("/var/tmp/portage/"):
            continue  # a package's own tests during a build (Python's PGO run crashes on purpose)
        found[os.path.basename(e.get("exe") or "?")].append(e.get("time", 0) / 1e6)
    return found


def seen():
    """When the events were last looked at (epoch seconds; 0 for never)."""
    try:
        return float(SEEN.read_text())
    except (OSError, ValueError):
        return 0


def mark_seen():
    SEEN.parent.mkdir(parents=True, exist_ok=True)
    tmp = SEEN.with_name("seen.new")
    tmp.write_text(f"{time.time():.0f}\n")
    tmp.rename(SEEN)


def unclean():
    """When deck-health noticed an unclean shutdown (epoch seconds), if in the last UNCLEAN_DAYS."""
    try:
        t = datetime.datetime.fromisoformat(UNCLEAN.read_text().strip()).timestamp()
    except (OSError, ValueError):
        return None
    return t if time.time() - t < UNCLEAN_DAYS * DAY else None


def portage():
    """[(tile line, detail)]."""
    found = []
    try:
        status = json.loads(PORTAGE.read_text())
    except (OSError, ValueError):
        return [("Portage status not checked yet", "  sudo systemctl start deck-portage.service")]
    world = status.get("world_updated")
    if world is None:
        found.append(("No @world update on record", "  emerge --ask --update --deep --newuse @world"))
    else:
        age = (datetime.datetime.now().astimezone() - datetime.datetime.fromisoformat(world)).days
        if age > WORLD_DAYS:
            found.append((f"@world last updated {age} days ago",
                          f"  last update {world}\n  emerge --ask --update --deep --newuse @world"))
    if status.get("preserved"):
        found.append((plural(status["preserved"], "preserved library", "preserved libraries"),
                      "  emerge @preserved-rebuild"))
    if status.get("depclean_blocked"):
        found.append(("Depclean is blocked", f"  {status.get('depclean_reason') or 'see emerge -p --depclean'}\n"
                      "  usually fixed by an @world update"))
    unread = sum(len(p.read_text().split()) for p in NEWS.glob("*.unread"))
    if unread:
        found.append((plural(unread, "unread Gentoo news item"), "  eselect news read"))
    return found


def reviews():
    """[(tile line, detail)]: subjects with findings not decided yet, failed automatic runs."""
    open_by = collections.defaultdict(list)
    failed = []
    for f in REVIEWS.glob("*.json"):
        try:
            r = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if r.get("status") == "done":
            open_by[r["subject"]] += [x for x in r.get("findings", []) if x.get("status", "open") in ("", "open")]
        elif r.get("status") == "failed" and r.get("auto") and time.time() - r.get("started", 0) < 3 * DAY:
            failed.append(r)
    open_by = {s: xs for s, xs in open_by.items() if xs}
    found = []
    if open_by:
        def counts(xs):
            high = sum(str(x.get("severity", "")).lower() in ("high", "critical") for x in xs)
            return f"{high} high of {len(xs)}" if high else plural(len(xs), "finding")
        found.append((f"Review findings to decide: {', '.join(open_by)}",
                      "\n".join(f"  {s}: {counts(xs)} open" for s, xs in sorted(open_by.items()))
                      + "\n  deck patches, tab 4 Review: f lists them; x fixed, n doesn't apply here, w won't fix"))
    if failed:
        found.append((plural(len(failed), "automatic review") + " failed",
                      "\n".join(f"  {r['subject']} ({r['kind']}): {r.get('error', '')}" for r in failed)))
    return found


def scans():
    """[(tile line, detail)]: updates the scan blocks, recent and not installed anyway."""
    blocked = []
    for f in SCANS.glob("*/*.json"):
        try:
            v = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if (v.get("status") in ("flagged", "failed") and time.time() - v.get("when", 0) < SCAN_DAYS * DAY
                and not pathlib.Path("/var/db/pkg", v["cpv"]).exists()):
            blocked.append(v)
    if not blocked:
        return []
    return [(f"Updates blocked by the scan: {', '.join(v['cpv'] for v in blocked)}",
             "\n".join(f"  {v['cpv']} ({v['status']}): {v.get('why', '')}"
                       + (f"\n    report: {v['report']}" if v.get("report") else "") for v in blocked)
             + "\n  After a look: deck patches scan allow <cpv> --note '...'")]


# How deep under the home to look for build output: ~/.claude/jobs/<id>/tmp/target is 5.
SNAP_DEPTH = 5


def snapshotted():
    """Rebuildable folders that the hourly @home snapshots still include: ~/.cache, and any
    folder under the home that says it is a cache (a CACHEDIR.TAG, as cargo writes in every
    target/), that isn't its own subvolume. Subvolumes and symlinks aren't gone into."""
    found = []

    def subvolume(path):
        # A subvolume's root is inode 256 for stat; readdir (scandir) reports another number.
        try:
            return os.stat(path, follow_symlinks=False).st_ino == 256
        except OSError:
            return True

    def walk(d, depth):
        try:
            entries = list(os.scandir(d))
        except OSError:
            return
        if any(e.name == "CACHEDIR.TAG" and e.is_file(follow_symlinks=False) for e in entries):
            # Not the small caches tools keep in a project (.pytest_cache, .venv, .ruff_cache),
            # nor uv's tool environments: what churns is build output.
            name = pathlib.Path(d).name
            if not name.startswith(".") and "/.local/share/uv/" not in d + "/":
                found.append(pathlib.Path(d))
            return
        if depth == SNAP_DEPTH:
            return
        for e in entries:
            if e.is_dir(follow_symlinks=False) and e.name not in (".git", "node_modules") and not subvolume(e.path):
                walk(e.path, depth + 1)

    cache = HOME / ".cache"
    if cache.is_dir() and not cache.is_symlink() and not subvolume(cache):
        found.append(cache)
    for e in os.scandir(HOME):
        if e.is_dir(follow_symlinks=False) and e.name != ".cache" and not subvolume(e.path):
            walk(e.path, 1)
    return sorted(found)


def disks():
    found = []
    for mount in ("/", "/efi"):
        try:
            st = os.statvfs(mount)
        except OSError:
            continue
        used = 100 - st.f_bavail * 100 // st.f_blocks
        if used > FULL:
            found.append((f"{mount} is {used}% full",
                          "  ncdu -x " + mount + "; podman system prune; old snapshots in /.snapshots"))
    return found


def main():
    args = sys.argv[1:]
    if args == ["--seen"]:
        mark_seen()
        return 0
    details, as_json = "--details" in args, "--json" in args
    items = []  # (level, line, detail lines)

    # The slow checks (git in every repo, the drift compare, coredumpctl) run side by side.
    repo_states, d, c = parallel(repos, drift, crashes)
    for name, summary, detail, age in repo_states:
        items.append(("soon" if age > REPO_SOON else "backlog", f"Only on deck: {name} ({summary})",
                      [f"~/src/{name}: {summary}"] + detail))

    if d:
        items.append(("soon", f"Config differs from repo: {plural(len(d), 'file')}",
                      ["Config differs from the agentic-gentoo repo (cd ~/src/agentic-gentoo; ./deploy.sh deck):"]
                      + [f"  {s:9} {p}" for s, p in d]))

    last_seen = seen()
    new = {p: [t for t in times if t > last_seen] for p, times in c.items()}
    new = {p: times for p, times in new.items() if times}
    if c:
        detail = [f"Crashes in the last {CRASH_DAYS} days (coredumpctl info <program> for the stack):"]
        for p, times in c.items():
            when = ", ".join(time.strftime("%a %d %b %H:%M", time.localtime(t))
                             + (" (new)" if t > last_seen else "") for t in times[-5:])
            detail.append(f"  {p}: {when}")
        line = "Crashed: " + ", ".join(f"{p} {len(t)}×" if len(t) > 1 else p for p, t in new.items())
        items.append(("soon" if new else "seen", line if new else "", detail))

    u = unclean()
    if u:
        stamp = time.strftime("%a %d %b, %H:%M", time.localtime(u))
        items.append(("now" if u > last_seen else "seen", f"Unclean shutdown before {stamp}" if u > last_seen else "",
                      [f"Unclean shutdown before {stamp} (see Disk health below)"]))

    snap = snapshotted()
    if snap:
        names = [str(d.relative_to(SRC)) if d.is_relative_to(SRC) else "~/" + str(d.relative_to(HOME)) for d in snap]
        items.append(("soon", "Build output in snapshots: " + ", ".join(names),
                      ["Build output in the hourly snapshots of @home (stop builds, then):",
                       "  deck-nosnap " + " ".join(str(d).replace(str(HOME), "~", 1) for d in snap)]))

    for level, found in (("soon", portage()), ("soon", scans()), ("backlog", reviews()), ("now", disks())):
        for line, detail in found:
            items.append((level, line, [line + ":", detail]))

    if as_json:
        print(json.dumps([{"level": l, "line": line, "detail": "\n".join(d)} for l, line, d in items]))
        return 0
    text = [t for _, _, d in items for t in d]
    if details:
        if c or u:
            text.append("(Crashes and the unclean shutdown above are now marked as seen.)")
        mark_seen()
    lines = [line for _, line, _ in items if line]
    print("\n".join(text if details else lines) or ("nothing" if details else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
