#!/usr/bin/env python3
"""deck-mail: the mail setup on deck (hosts/deck/email.md): Gmail accounts kept offline in
~/Mail with mbsync, indexed by notmuch, read in aerc, sent through msmtp(q).

  deck-mail config   write each account's config from ~/.config/deck-mail/accounts
  deck-mail sync     fetch mail (mbsync), index it (notmuch new), send what's queued
  deck-mail unlock   ask for the GPG passphrase now, so the timer's syncs can read the passwords
  deck-mail send     aerc's outgoing command: msmtpq, which queues what can't go out now
  deck-mail bills [--dry-run]
                     copy the PDFs of bills into the family archive on Nextcloud (WebDAV),
                     filed by date; the rules are in ~/.config/deck-mail/bills. `sync` runs it.
  deck-mail top [N] [query]
                     the N (50) most frequent senders, sender domains and subjects, with the
                     newest message's month: what to clean up. The query defaults to
                     `not tag:sent`; deleted and spam are always left out.

The account list stays out of the repo, which is public: addresses only on deck.
~/.config/deck-mail/accounts, one account a line, the first one the default for sending:

  # name       address               your name as senders see it
  ivankovic    you@your.domain       Your Name
  gmail        you@gmail.com         Your Name

`config` writes, from it: ~/.config/isyncrc (mbsync), ~/.config/msmtp/config,
~/.config/notmuch/default/config, ~/.config/aerc/accounts.conf. The rest is tracked in the repo
(aerc.conf, the notmuch hooks, the sync timer). Each account's app password is in `pass` as
mail/<name>.

Both ways, as tags in notmuch (aerc's d and a, home/.config/aerc/binds.conf):

  unread, flagged  maildir flags, which mbsync carries both ways
  archive          `inbox` removed: `sync` takes the Inbox label off in Gmail, over IMAP
  delete           tag `deleted`: `sync` moves the message to Gmail's Bin (kept 30 days)
  the rest         comes from Gmail: new mail, archiving and deleting there, labels moved

mbsync itself never deletes or uploads on Gmail: it pulls messages and their disappearance, and
pushes only flags. Archive and delete go through Gmail's own IMAP commands (X-GM-LABELS, MOVE),
whatever the account's IMAP settings say.

Every 5 min deck-mail.timer runs `sync`. It never asks for the passphrase itself: when gpg-agent
doesn't have it, it notifies once and waits for `deck-mail unlock` (or a `sync` in a terminal).
"""
import fcntl
import imaplib
import json
import os
import pathlib
import shlex
import subprocess
import sys
import time

HOME = pathlib.Path.home()
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "deck-mail"
ACCOUNTS = CONFIG / "deck-mail/accounts"
BILLS = CONFIG / "deck-mail/bills"
MAIL = HOME / "Mail"
ISYNCRC = CONFIG / "isyncrc"
MSMTPQ = "/usr/share/msmtp/msmtpq"
# Gmail's folders: local name, the IMAP special-use flag that finds it, its English name.
# Gmail names them in the account's language (British English: "[Gmail]/Bin"), so `config` asks
# the server; the names here are the fallback. Spam and the inbox tabs aren't synced.
FOLDERS = [("INBOX", None, "INBOX"), ("All", r"\All", "[Gmail]/All Mail"),
           ("Sent", r"\Sent", "[Gmail]/Sent Mail"), ("Drafts", r"\Drafts", "[Gmail]/Drafts"),
           ("Trash", r"\Trash", "[Gmail]/Trash")]
NOTIFY_EVERY = 3600
# msmtpq: the queue and its log in the state folder; no connection test (debian.org ping): when
# msmtp fails, the mail is queued and the next sync sends it.
QUEUE_ENV = {"MSMTPQ_Q": str(STATE / "queue"), "MSMTPQ_LOG": str(STATE / "msmtpq.log"),
             "EMAIL_CONN_TEST": "x"}


def accounts():
    out = []
    for line in ACCOUNTS.read_text().splitlines():
        line = line.split("#", 1)[0].split()
        if line:
            if len(line) < 3 or "@" not in line[1]:
                sys.exit(f"deck-mail: {ACCOUNTS}: expected 'name address Your Name': {' '.join(line)}")
            out.append({"name": line[0], "address": line[1], "realname": " ".join(line[2:])})
    if not out:
        sys.exit(f"deck-mail: no accounts in {ACCOUNTS}")
    return out


def write(path, text, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    print(f"deck-mail: wrote {path}")


HEADER = "# Written by `deck-mail config` from {} (addresses stay off the repo). Edit that instead.\n"


def isyncrc(accts):
    out = [HEADER.format(ACCOUNTS)]
    for a in accts:
        n = a["name"]
        out.append(f"""
IMAPAccount {n}
Host imap.gmail.com
User {a["address"]}
PassCmd "pass show mail/{n}"
TLSType IMAPS
AuthMechs LOGIN

IMAPStore {n}-far
Account {n}

MaildirStore {n}-near
Path {MAIL}/{n}/
Inbox {MAIL}/{n}/INBOX
SubFolders Verbatim
""")
        for local, remote in a["folders"]:
            out.append(f"""
Channel {n}-{local.lower()}
Far :{n}-far:"{remote}"
Near :{n}-near:{local}
Sync PullNew PullGone Flags
Create Near
Expunge Near
SyncState *
CopyArrivalDate yes
""")
        out.append(f"\nGroup {n}\n" + "".join(f"Channel {n}-{l.lower()}\n" for l, _ in a["folders"]))
    return "".join(out)


def msmtprc(accts):
    out = [HEADER.format(ACCOUNTS), f"""
defaults
auth on
tls on
tls_trust_file system
logfile {STATE}/msmtp.log
"""]
    for a in accts:
        out.append(f"""
account {a["name"]}
host smtp.gmail.com
port 465
tls_starttls off
user {a["address"]}
from {a["address"]}
passwordeval pass show mail/{a["name"]}
""")
    out.append(f"\naccount default : {accts[0]['name']}\n")
    return "".join(out)


def notmuch(accts):
    others = ";".join(a["address"] for a in accts[1:])
    return HEADER.format(ACCOUNTS) + f"""
[database]
path={MAIL}
hook_dir={CONFIG}/notmuch/default/hooks

[user]
name={accts[0]["realname"]}
primary_email={accts[0]["address"]}
other_email={others}

[new]
tags=new
ignore=.mbsyncstate;.mbsyncstate.journal;.mbsyncstate.new;.mbsyncstate.lock;.uidvalidity;.isyncuidmap.db

[search]
exclude_tags=deleted;spam

[maildir]
synchronize_flags=true
"""


def aerc(accts):
    send = "/usr/local/bin/deck-mail send"
    first = accts[0]
    out = [HEADER.format(ACCOUNTS), f"""
# Everything, every account: notmuch searches (aerc/all.map).
[All]
source = notmuch://{MAIL}
query-map = {CONFIG}/aerc/all.map
folders-sort = Inbox,Unread,Flagged,Sent,Drafts,Everything,Bin
default = Inbox
from = {first["realname"]} <{first["address"]}>
aliases = {", ".join(a["address"] for a in accts[1:])}
outgoing = {send}
"""]
    for a in accts:
        out.append(f"""
[{a["name"]}]
source = notmuch://{MAIL}
maildir-store = {MAIL}
maildir-account-path = {a["name"]}
folders-sort = INBOX,All,Sent,Drafts,Trash
default = INBOX
from = {a["realname"]} <{a["address"]}>
outgoing = {send}
""")
    return "".join(out)


def login(a):
    """An IMAP connection to the account, or None without its password."""
    env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
    pw = subprocess.run(["pass", "show", f"mail/{a['name']}"], capture_output=True, text=True,
                        env=env)
    if pw.returncode or not pw.stdout.strip():
        return None
    imap = imaplib.IMAP4_SSL("imap.gmail.com", timeout=60)
    imap.login(a["address"], pw.stdout.splitlines()[0])
    return imap


def special(imap):
    """Gmail's folder names by special-use flag, in the account's language."""
    names = {flag: name for _, flag, name in FOLDERS if flag}
    for line in imap.list()[1]:
        line = line.decode()
        flags, name = line[1:line.index(")")].split(), line.rsplit(' "/" ', 1)[1].strip('"')
        for flag in names:
            if flag in flags:
                names[flag] = name
    return names


def quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def folders(a):
    """The account's Gmail folders, local name and Gmail's, by their special-use flags."""
    names = {flag: name for _, flag, name in FOLDERS if flag}
    try:
        imap = login(a)
        if imap is None:
            print(f"deck-mail: {a['name']}: no password to list Gmail's folders; English names")
        else:
            names = special(imap)
            imap.logout()
    except (OSError, imaplib.IMAP4.error, ValueError) as e:
        print(f"deck-mail: {a['name']}: couldn't list Gmail's folders ({e}); English names")
    return [(local, names[flag] if flag else name) for local, flag, name in FOLDERS]


def pending(query):
    """Message-IDs matching a notmuch search, deleted ones included."""
    out = subprocess.run(["notmuch", "search", "--exclude=false", "--format=json",
                          "--output=messages", query], capture_output=True, text=True, check=True)
    return json.loads(out.stdout)


def push(a):
    """Archive and delete in Gmail what was archived and deleted on deck. False if it failed."""
    n = a["name"]
    archive = pending(f'folder:"{n}/INBOX" and not tag:inbox')
    delete = pending(f'tag:deleted and path:"{n}/**" and not folder:"{n}/Trash"')
    if not archive and not delete:
        return True
    try:
        imap = login(a)
        names = special(imap)

        # Both from All Mail: with INBOX selected, Gmail answers that the label is gone, and keeps it.
        if imap.select(quote(names[r"\All"]))[0] != "OK":
            raise imaplib.IMAP4.error(f"can't open {names[r'\All']}")

        def each(ids, *command):
            for mid in ids:
                uids = imap.uid("SEARCH", "X-GM-RAW", quote(f"rfc822msgid:{mid}"))[1][0].split()
                if uids:
                    typ, data = imap.uid(command[0], b",".join(uids).decode(), *command[1:])
                    if typ != "OK":
                        raise imaplib.IMAP4.error(f"{command[0]} {mid}: {data}")

        each(archive, "STORE", "-X-GM-LABELS", r"(\Inbox)")
        each(delete, "MOVE", quote(names[r"\Trash"]))
        imap.close()
        imap.logout()
    except (OSError, imaplib.IMAP4.error, ValueError, AttributeError, IndexError) as e:
        print(f"deck-mail: {n}: archiving and deleting in Gmail failed: {e}")
        return False
    print(f"deck-mail: {n}: {len(archive)} archived, {len(delete)} moved to the Bin in Gmail")
    return True


def config():
    accts = accounts()
    for a in accts:
        a["folders"] = folders(a)
    write(ISYNCRC, isyncrc(accts))
    write(CONFIG / "msmtp/config", msmtprc(accts))
    write(CONFIG / "notmuch/default/config", notmuch(accts))
    write(CONFIG / "aerc/accounts.conf", aerc(accts))
    gpg_agent()
    STATE.mkdir(parents=True, exist_ok=True)
    for a in accts:
        (MAIL / a["name"]).mkdir(parents=True, exist_ok=True)
    # The index is rebuilt from the mail by `notmuch new`: out of the hourly snapshots.
    if not (MAIL / ".notmuch").exists():
        subprocess.run(["deck-nosnap", str(MAIL / ".notmuch")], check=False)
    missing = [a["name"] for a in accts if not passwords_has(a["name"])]
    if missing:
        print("deck-mail: no app password yet for " + ", ".join(missing) + ": "
              + "; ".join(f"pass insert mail/{m}" for m in missing))
    return 0


# gpg-agent keeps the passphrase while it's used (a sync every 5 min), at most 12 h. Written here:
# the repo's hooks keep anything under .gnupg out of it.
GPG_AGENT = {"default-cache-ttl": "900", "max-cache-ttl": "43200"}


def gpg_agent():
    gnupg = pathlib.Path(os.environ.get("GNUPGHOME") or HOME / ".gnupg")
    conf = gnupg / "gpg-agent.conf"
    lines = conf.read_text().splitlines() if conf.exists() else []
    keep = [l for l in lines if l.split()[:1] not in ([k] for k in GPG_AGENT)]
    new = keep + [f"{k} {v}" for k, v in GPG_AGENT.items()]
    if new != lines:
        gnupg.mkdir(mode=0o700, exist_ok=True)
        write(conf, "\n".join(new) + "\n")
        subprocess.run(["gpgconf", "--reload", "gpg-agent"], check=False)


def passwords_has(name):
    store = pathlib.Path(os.environ.get("PASSWORD_STORE_DIR") or HOME / ".password-store")
    return (store / f"mail/{name}.gpg").exists()


def unlocked(accts, interactive):
    """Whether gpg-agent can decrypt the passwords; asks for the passphrase only if interactive."""
    env = dict(os.environ)
    if not interactive:
        env["PASSWORD_STORE_GPG_OPTS"] = "--pinentry-mode=error"
    r = subprocess.run(["pass", "show", f"mail/{accts[0]['name']}"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return r.returncode == 0


def notify(summary, body):
    stamp = STATE / "notified"
    try:
        if time.time() - stamp.stat().st_mtime < NOTIFY_EVERY:
            return
    except OSError:
        pass
    subprocess.run(["notify-send", "--app-name=deck-mail", summary, body], capture_output=True)
    stamp.touch()


def sync(interactive):
    accts = accounts()
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("deck-mail: a sync is already running")
        return 0
    accts = [a for a in accts if passwords_has(a["name"])]
    if not accts:
        print("deck-mail: no app passwords in pass yet (pass insert mail/<name>)")
        return 0
    if not unlocked(accts, interactive):
        notify("Mail sync is waiting", "The GPG passphrase isn't cached: run deck-mail unlock.")
        print("deck-mail: passwords locked; run deck-mail unlock")
        return 75
    (STATE / "notified").unlink(missing_ok=True)
    env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
    # Archives and deletes go first. If they can't (offline), nothing else runs: notmuch new's
    # hook sets `inbox` and `deleted` from the folders, and would undo them.
    if not all([push(a) for a in accts]):
        return 1
    failed = []
    for a in accts:  # one account failing doesn't hold up the others
        quiet = [] if interactive else ["-q"]  # in a terminal: progress
        r = subprocess.run(["mbsync", "-c", str(ISYNCRC), *quiet, a["name"]], env=env)
        if r.returncode:
            failed.append(a["name"])
    subprocess.run(["notmuch", "new", *([] if interactive else ["--quiet"])], check=True)
    # Only once the bills config is filled in: the example's placeholders would fail every sync.
    if BILLS.exists() and "example" not in BILLS.read_text().split("\n# Bills")[0]:
        try:
            bills(dry_run=False, quiet=not interactive)
        except (OSError, SystemExit, subprocess.CalledProcessError) as e:
            print(f"deck-mail: bills: {e}")
    if any((STATE / "queue").glob("*.mail")):
        subprocess.run([f"{MSMTPQ}/msmtpq", "--q-mgmt", "-r"], env=dict(env, **QUEUE_ENV))
    if failed:
        print("deck-mail: mbsync failed for " + ", ".join(failed))
        return 1
    (STATE / "synced").touch()
    return 0


BILLS_EXAMPLE = """\
# deck-mail bills: which mail's PDFs go to the family archive. On deck only, not in the repo.
url     https://cloud.example.org          # the Nextcloud server
user    you                                # its login
pass    nextcloud/deck                     # the `pass` entry holding a Nextcloud app password
folder  Family Archive                     # where in Nextcloud
# Where in the folder, from: {year} {month} {date} (YYYY-MM-DD) {sender} {subject} {file}
layout  {year}/{date} {sender} - {file}
local   ~/Documents/Bills                  # a copy on deck, same layout
# Bills: any of these notmuch searches, one a line, on mail with a PDF. In aerc, Bb makes any
# message a bill (tag `bill`), Bn keeps one out (tag `notbill`).
from:billing@example.com
subject:invoice
"""
BILL_KEYS = ("url", "user", "pass", "folder", "layout", "local")


def bills_config(upload=True):
    conf, rules = {"layout": "{year}/{date} {sender} - {file}"}, []
    for line in BILLS.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, _, value = line.partition(" ")
        if key in BILL_KEYS:
            conf[key] = value.split(" #")[0].strip()
        else:
            rules.append(line)
    missing = [k for k in (("url", "user", "pass", "folder") if upload else ("folder",))
               if not conf.get(k) or "example" in conf[k]]
    if missing:
        raise SystemExit(f"deck-mail: {BILLS}: missing {', '.join(missing)}")
    return conf, rules


def safe(s, limit=80):
    """A file name's worth of text: no slashes or control characters, short."""
    s = "".join(c if c.isprintable() and c not in '/\\:*?"<>|' else " " for c in s)
    return " ".join(s.split())[:limit].strip(" .") or "unnamed"


def bill_pdfs(path):
    """The message's date, sender name, subject, and its PDFs as (file name, bytes)."""
    import datetime
    import email
    import email.policy
    import email.utils
    with open(path, "rb") as f:
        msg = email.message_from_binary_file(f, policy=email.policy.default)
    try:
        date = email.utils.parsedate_to_datetime(str(msg["Date"])).astimezone()
    except (TypeError, ValueError):
        date = datetime.datetime.fromtimestamp(os.path.getmtime(path)).astimezone()
    name, addr = email.utils.parseaddr(str(msg["From"] or ""))
    sender = name or addr.rpartition("@")[2].removeprefix("email.").removeprefix("mail.")
    pdfs = []
    for part in msg.walk():
        fname = part.get_filename() or ""
        if part.get_content_type() == "application/pdf" or fname.lower().endswith(".pdf"):
            data = part.get_payload(decode=True)
            if data and data.startswith(b"%PDF"):
                fname = safe(fname.removesuffix(".pdf").removesuffix(".PDF") or "attachment")
                pdfs.append((fname + ".pdf", data))
    return date, safe(sender, 40), safe(str(msg["Subject"] or "")), pdfs


def webdav(conf, password):
    """PUT for a path inside the Nextcloud folder: creates the folders, never overwrites (a file
    already there gets " (2)", " (3)"…). Returns the path used."""
    import base64
    import urllib.error
    import urllib.parse
    import urllib.request
    base = f"{conf['url'].rstrip('/')}/remote.php/dav/files/{urllib.parse.quote(conf['user'])}/"
    auth = "Basic " + base64.b64encode(f"{conf['user']}:{password}".encode()).decode()
    made = set()

    def call(method, rel, data=None):
        req = urllib.request.Request(base + urllib.parse.quote(rel), data=data, method=method,
                                     headers={"Authorization": auth})
        try:
            with urllib.request.urlopen(req, timeout=120) as r:
                return r.status
        except urllib.error.HTTPError as e:
            return e.code

    def put(rel, data):
        parts = rel.split("/")
        for i in range(1, len(parts)):
            d = "/".join(parts[:i])
            if d not in made:
                if call("MKCOL", d) not in (201, 405):  # 405: it exists
                    raise OSError(f"Nextcloud: can't create {d}")
                made.add(d)
        stem, n = rel.removesuffix(".pdf"), 1
        while call("HEAD", rel) == 200:
            n += 1
            rel = f"{stem} ({n}).pdf"
        status = call("PUT", rel, data)
        if status not in (201, 204):
            raise OSError(f"Nextcloud: uploading {rel} failed ({status})")
        return rel

    return call, put


def bills(dry_run, quiet=False):
    """Copies bills' PDFs to Nextcloud, once each: a message done is tagged `bill-archived`, and
    a PDF already sent (the same bytes, from another message) is not sent again."""
    import hashlib
    conf, rules = bills_config(upload=not dry_run)
    wanted = " or ".join(f"({r})" for r in rules)
    query = (f"(tag:bill or (({wanted}) and not tag:sent))" if wanted else "tag:bill")
    query += " and (mimetype:application/pdf or attachment:pdf) and not tag:notbill and not tag:bill-archived"
    ids = subprocess.run(["notmuch", "search", "--output=messages", query],
                         capture_output=True, text=True, check=True).stdout.split()
    if not ids:
        return 0
    seen_file = STATE / "bills.json"
    seen = json.loads(seen_file.read_text()) if seen_file.exists() else {}
    put = None
    if not dry_run:
        env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
        pw = subprocess.run(["pass", "show", conf["pass"]], capture_output=True, text=True, env=env)
        if pw.returncode or not pw.stdout.strip():
            print(f"deck-mail: bills: no password from `pass show {conf['pass']}`")
            return 1
        call, put = webdav(conf, pw.stdout.splitlines()[0])
        if call("PROPFIND", conf["folder"]) != 207:
            print(f"deck-mail: bills: no folder {conf['folder']!r} in Nextcloud for {conf['user']}")
            return 1
    local = pathlib.Path(os.path.expanduser(conf["local"])) if conf.get("local") else None
    sent = 0
    for mid in ids:
        files = subprocess.run(["notmuch", "search", "--output=files", "--exclude=false", mid],
                               capture_output=True, text=True, check=True).stdout.split("\n")
        date, sender, subject, pdfs = bill_pdfs(files[0])
        for fname, data in pdfs:
            digest = hashlib.sha256(data).hexdigest()
            rel = conf["layout"].format(year=f"{date:%Y}", month=f"{date:%m}", date=f"{date:%Y-%m-%d}",
                                        sender=sender, subject=subject, file=fname)
            rel = "/".join(safe(p, 120) for p in rel.split("/"))
            if not rel.lower().endswith(".pdf"):
                rel += ".pdf"
            if digest in seen:
                continue
            if dry_run:
                print(f"{conf['folder']}/{rel}\t{subject}")
                seen[digest] = rel  # within this run only: the same PDF twice is listed once
                sent += 1
                continue
            rel = put(f"{conf['folder']}/{rel}", data).removeprefix(conf["folder"] + "/")
            if local:
                out = local / rel
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_bytes(data)
            seen[digest] = rel
            seen_file.write_text(json.dumps(seen, indent=1))
            sent += 1
        if not dry_run:
            subprocess.run(["notmuch", "tag", "+bill-archived", "--", mid], check=True)
    if not quiet or sent:
        print(f"deck-mail: bills: {len(ids)} messages, {sent} PDFs "
              + ("would go to Nextcloud" if dry_run else "copied to Nextcloud"))
    return 0


def top(args):
    """Prints the most frequent senders, sender domains and subjects among the query's messages."""
    import collections
    import email.utils
    import re
    n = int(args.pop(0)) if args and args[0].isdigit() else 50
    out = subprocess.run(["notmuch", "show", "--format=json", "--body=false", "--entire-thread=false",
                          *(args or ["not", "tag:sent"])], capture_output=True, check=True).stdout

    def messages(x):
        if isinstance(x, dict):
            if "headers" in x:
                yield x
        elif isinstance(x, list):
            for y in x:
                yield from messages(y)

    counts = {k: collections.Counter() for k in ("senders", "sender domains", "subjects")}
    newest = {}
    for m in messages(json.loads(out)):
        h = m["headers"]
        addr = email.utils.parseaddr(h.get("From", ""))[1].lower()
        # Re:/Fwd: (and their German, Nordic forms) off, numbers as #: "Invoice 1234" and
        # "Invoice 1240" are one subject.
        subject = re.sub(r"^\s*((re|fwd?|aw|wg|sv)(\[\d+\])?:\s*)+", "", h.get("Subject", ""), flags=re.I)
        subject = re.sub(r"\d+", "#", " ".join(subject.split()))[:80]
        for kind, key in (("senders", f"from:{addr}"), ("sender domains", f"from:{addr.rpartition('@')[2]}"),
                          ("subjects", subject)):
            counts[kind][key] += 1
            newest[kind, key] = max(newest.get((kind, key), 0), m.get("timestamp", 0))
    for kind, c in counts.items():
        print(f"# the {n} most frequent {kind}: messages, newest (month), "
              + ("subject, numbers as #" if kind == "subjects" else "notmuch search"))
        for key, k in c.most_common(n):
            print(f"{k:6}  {time.strftime('%Y-%m', time.localtime(newest[kind, key]))}  {key}")
        print()
    return 0


def main():
    cmd = sys.argv[1:]
    if cmd == ["config"]:
        return config()
    if cmd == ["sync"]:
        return sync(sys.stdin.isatty())
    if cmd[:1] == ["send"]:  # aerc gives the recipients as arguments, the mail on stdin
        os.execve(f"{MSMTPQ}/msmtpq", ["msmtpq", "--read-envelope-from", *cmd[1:]],
                  dict(os.environ, **QUEUE_ENV))
    if cmd == ["unlock"]:
        return 0 if unlocked(accounts(), True) else 1
    if cmd[:1] == ["bills"]:
        if not BILLS.exists():
            BILLS.write_text(BILLS_EXAMPLE)
            print(f"deck-mail: wrote an example {BILLS}: fill it in, then deck-mail bills --dry-run")
            return 1
        return bills(dry_run="--dry-run" in cmd)
    if cmd[:1] == ["top"]:
        return top(cmd[1:])
    print(__doc__.split("\n\n", 2)[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
