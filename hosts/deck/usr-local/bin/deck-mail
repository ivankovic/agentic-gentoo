#!/usr/bin/env python3
"""deck-mail: the mail setup on deck (hosts/deck/email.md): Gmail accounts kept offline in
~/Mail with mbsync, indexed by notmuch, read in aerc, sent through msmtp(q).

  deck-mail config   write each account's config from ~/.config/deck-mail/accounts
  deck-mail sync     fetch mail (mbsync), index it (notmuch new), send what's queued
  deck-mail unlock   ask for the GPG passphrase now, so the timer's syncs can read the passwords
  deck-mail send     aerc's outgoing command: msmtpq, which queues what can't go out now
  deck-mail archive [--dry-run]
                     copy mail's PDFs into the family archive on Nextcloud (WebDAV): where it
                     is in ~/.config/deck-mail/archive; what each PDF is called and its
                     category (also a tag in Nextcloud), or that it's left out, in
                     ~/.config/deck-mail/archive-names.
                     --dry-run lists every PDF and its name. `sync` runs it.
  deck-mail review    a TUI over those PDFs: which go to Nextcloud, in which folder, as what;
                     which are left out; and which mail to delete. It writes archive-names.
  deck-mail top [N] [query]
                     the N (50) most frequent senders, sender domains and subjects, with the
                     newest message's month: what to clean up. The query defaults to
                     `not tag:sent`; deleted and spam are always left out.

The account list stays out of the repo, which is public: addresses only on deck.
~/.config/deck-mail/accounts, one account a line, the first one the default for sending:

  # name       address               your name as senders see it
  ivankovic    you@your.domain       Your Name
  gmail        you@gmail.com         Your Name

`config` writes, from it: ~/.config/isyncrc (mbsync), ~/.config/msmtp/config,
~/.config/notmuch/default/config, ~/.config/aerc/accounts.conf. The rest is tracked in the repo
(aerc.conf, the notmuch hooks, the sync timer). Each account's app password is in `pass` as
mail/<name>.

Both ways, as tags in notmuch (aerc's d and a, home/.config/aerc/binds.conf):

  unread, flagged  maildir flags, which mbsync carries both ways
  archive          `inbox` removed: `sync` takes the Inbox label off in Gmail, over IMAP
  delete           tag `deleted`: `sync` moves the message to Gmail's Bin (kept 30 days)
  the rest         comes from Gmail: new mail, archiving and deleting there, labels moved

mbsync itself never deletes or uploads on Gmail: it pulls messages and their disappearance, and
pushes only flags. Archive and delete go through Gmail's own IMAP commands (X-GM-LABELS, MOVE),
whatever the account's IMAP settings say.

Every 5 min deck-mail.timer runs `sync`. It never asks for the passphrase itself: when gpg-agent
doesn't have it, it notifies once and waits for `deck-mail unlock` (or a `sync` in a terminal).
"""
import fcntl
import imaplib
import json
import os
import pathlib
import re
import shlex
import subprocess
import sys
import time

HOME = pathlib.Path.home()
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "deck-mail"
ACCOUNTS = CONFIG / "deck-mail/accounts"
ARCHIVE = CONFIG / "deck-mail/archive"
ARCHIVE_NAMES = CONFIG / "deck-mail/archive-names"
MAIL = HOME / "Mail"
ISYNCRC = CONFIG / "isyncrc"
MSMTPQ = "/usr/share/msmtp/msmtpq"
# Gmail's folders: local name, the IMAP special-use flag that finds it, its English name.
# Gmail names them in the account's language (British English: "[Gmail]/Bin"), so `config` asks
# the server; the names here are the fallback. Spam and the inbox tabs aren't synced.
FOLDERS = [("INBOX", None, "INBOX"), ("All", r"\All", "[Gmail]/All Mail"),
           ("Sent", r"\Sent", "[Gmail]/Sent Mail"), ("Drafts", r"\Drafts", "[Gmail]/Drafts"),
           ("Trash", r"\Trash", "[Gmail]/Trash")]
NOTIFY_EVERY = 3600
# msmtpq: the queue and its log in the state folder; no connection test (debian.org ping): when
# msmtp fails, the mail is queued and the next sync sends it.
QUEUE_ENV = {"MSMTPQ_Q": str(STATE / "queue"), "MSMTPQ_LOG": str(STATE / "msmtpq.log"),
             "EMAIL_CONN_TEST": "x"}


def accounts():
    out = []
    for line in ACCOUNTS.read_text().splitlines():
        line = line.split("#", 1)[0].split()
        if line:
            if len(line) < 3 or "@" not in line[1]:
                sys.exit(f"deck-mail: {ACCOUNTS}: expected 'name address Your Name': {' '.join(line)}")
            out.append({"name": line[0], "address": line[1], "realname": " ".join(line[2:])})
    if not out:
        sys.exit(f"deck-mail: no accounts in {ACCOUNTS}")
    return out


def write(path, text, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    print(f"deck-mail: wrote {path}")


HEADER = "# Written by `deck-mail config` from {} (addresses stay off the repo). Edit that instead.\n"


def isyncrc(accts):
    out = [HEADER.format(ACCOUNTS)]
    for a in accts:
        n = a["name"]
        out.append(f"""
IMAPAccount {n}
Host imap.gmail.com
User {a["address"]}
PassCmd "pass show mail/{n}"
TLSType IMAPS
AuthMechs LOGIN

IMAPStore {n}-far
Account {n}

MaildirStore {n}-near
Path {MAIL}/{n}/
Inbox {MAIL}/{n}/INBOX
SubFolders Verbatim
""")
        for local, remote in a["folders"]:
            out.append(f"""
Channel {n}-{local.lower()}
Far :{n}-far:"{remote}"
Near :{n}-near:{local}
Sync PullNew PullGone Flags
Create Near
Expunge Near
SyncState *
CopyArrivalDate yes
""")
        out.append(f"\nGroup {n}\n" + "".join(f"Channel {n}-{l.lower()}\n" for l, _ in a["folders"]))
    return "".join(out)


def msmtprc(accts):
    out = [HEADER.format(ACCOUNTS), f"""
defaults
auth on
tls on
tls_trust_file system
logfile {STATE}/msmtp.log
"""]
    for a in accts:
        out.append(f"""
account {a["name"]}
host smtp.gmail.com
port 465
tls_starttls off
user {a["address"]}
from {a["address"]}
passwordeval pass show mail/{a["name"]}
""")
    out.append(f"\naccount default : {accts[0]['name']}\n")
    return "".join(out)


def notmuch(accts):
    others = ";".join(a["address"] for a in accts[1:])
    return HEADER.format(ACCOUNTS) + f"""
[database]
path={MAIL}
hook_dir={CONFIG}/notmuch/default/hooks

[user]
name={accts[0]["realname"]}
primary_email={accts[0]["address"]}
other_email={others}

[new]
tags=new
ignore=.mbsyncstate;.mbsyncstate.journal;.mbsyncstate.new;.mbsyncstate.lock;.uidvalidity;.isyncuidmap.db

[search]
exclude_tags=deleted;spam

[maildir]
synchronize_flags=true
"""


def aerc(accts):
    send = "/usr/local/bin/deck-mail send"
    first = accts[0]
    out = [HEADER.format(ACCOUNTS), f"""
# Everything, every account: notmuch searches (aerc/all.map).
[All]
source = notmuch://{MAIL}
query-map = {CONFIG}/aerc/all.map
folders-sort = Inbox,Unread,Flagged,Sent,Drafts,Everything,Bin
default = Inbox
from = {first["realname"]} <{first["address"]}>
aliases = {", ".join(a["address"] for a in accts[1:])}
outgoing = {send}
"""]
    for a in accts:
        out.append(f"""
[{a["name"]}]
source = notmuch://{MAIL}
maildir-store = {MAIL}
maildir-account-path = {a["name"]}
folders-sort = INBOX,All,Sent,Drafts,Trash
default = INBOX
from = {a["realname"]} <{a["address"]}>
outgoing = {send}
""")
    return "".join(out)


def login(a):
    """An IMAP connection to the account, or None without its password."""
    env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
    pw = subprocess.run(["pass", "show", f"mail/{a['name']}"], capture_output=True, text=True,
                        env=env)
    if pw.returncode or not pw.stdout.strip():
        return None
    imap = imaplib.IMAP4_SSL("imap.gmail.com", timeout=60)
    imap.login(a["address"], pw.stdout.splitlines()[0])
    return imap


def special(imap):
    """Gmail's folder names by special-use flag, in the account's language."""
    names = {flag: name for _, flag, name in FOLDERS if flag}
    for line in imap.list()[1]:
        line = line.decode()
        flags, name = line[1:line.index(")")].split(), line.rsplit(' "/" ', 1)[1].strip('"')
        for flag in names:
            if flag in flags:
                names[flag] = name
    return names


def quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def folders(a):
    """The account's Gmail folders, local name and Gmail's, by their special-use flags."""
    names = {flag: name for _, flag, name in FOLDERS if flag}
    try:
        imap = login(a)
        if imap is None:
            print(f"deck-mail: {a['name']}: no password to list Gmail's folders; English names")
        else:
            names = special(imap)
            imap.logout()
    except (OSError, imaplib.IMAP4.error, ValueError) as e:
        print(f"deck-mail: {a['name']}: couldn't list Gmail's folders ({e}); English names")
    return [(local, names[flag] if flag else name) for local, flag, name in FOLDERS]


def pending(query):
    """Message-IDs matching a notmuch search, deleted ones included."""
    out = subprocess.run(["notmuch", "search", "--exclude=false", "--format=json",
                          "--output=messages", query], capture_output=True, text=True, check=True)
    return json.loads(out.stdout)


def push(a):
    """Archive and delete in Gmail what was archived and deleted on deck. False if it failed."""
    n = a["name"]
    archive = pending(f'folder:"{n}/INBOX" and not tag:inbox')
    delete = pending(f'tag:deleted and path:"{n}/**" and not folder:"{n}/Trash"')
    if not archive and not delete:
        return True
    try:
        imap = login(a)
        names = special(imap)

        # Both from All Mail: with INBOX selected, Gmail answers that the label is gone, and keeps it.
        if imap.select(quote(names[r"\All"]))[0] != "OK":
            raise imaplib.IMAP4.error(f"can't open {names[r'\All']}")

        def each(ids, *command):
            for mid in ids:
                uids = imap.uid("SEARCH", "X-GM-RAW", quote(f"rfc822msgid:{mid}"))[1][0].split()
                if uids:
                    typ, data = imap.uid(command[0], b",".join(uids).decode(), *command[1:])
                    if typ != "OK":
                        raise imaplib.IMAP4.error(f"{command[0]} {mid}: {data}")

        each(archive, "STORE", "-X-GM-LABELS", r"(\Inbox)")
        each(delete, "MOVE", quote(names[r"\Trash"]))
        imap.close()
        imap.logout()
    except (OSError, imaplib.IMAP4.error, ValueError, AttributeError, IndexError) as e:
        print(f"deck-mail: {n}: archiving and deleting in Gmail failed: {e}")
        return False
    print(f"deck-mail: {n}: {len(archive)} archived, {len(delete)} moved to the Bin in Gmail")
    return True


def config():
    accts = accounts()
    for a in accts:
        a["folders"] = folders(a)
    write(ISYNCRC, isyncrc(accts))
    write(CONFIG / "msmtp/config", msmtprc(accts))
    write(CONFIG / "notmuch/default/config", notmuch(accts))
    write(CONFIG / "aerc/accounts.conf", aerc(accts))
    gpg_agent()
    STATE.mkdir(parents=True, exist_ok=True)
    for a in accts:
        (MAIL / a["name"]).mkdir(parents=True, exist_ok=True)
    # The index is rebuilt from the mail by `notmuch new`: out of the hourly snapshots.
    if not (MAIL / ".notmuch").exists():
        subprocess.run(["deck-nosnap", str(MAIL / ".notmuch")], check=False)
    missing = [a["name"] for a in accts if not passwords_has(a["name"])]
    if missing:
        print("deck-mail: no app password yet for " + ", ".join(missing) + ": "
              + "; ".join(f"pass insert mail/{m}" for m in missing))
    return 0


# gpg-agent keeps the passphrase while it's used (a sync every 5 min), at most 12 h. Written here:
# the repo's hooks keep anything under .gnupg out of it.
GPG_AGENT = {"default-cache-ttl": "900", "max-cache-ttl": "43200"}


def gpg_agent():
    gnupg = pathlib.Path(os.environ.get("GNUPGHOME") or HOME / ".gnupg")
    conf = gnupg / "gpg-agent.conf"
    lines = conf.read_text().splitlines() if conf.exists() else []
    keep = [l for l in lines if l.split()[:1] not in ([k] for k in GPG_AGENT)]
    new = keep + [f"{k} {v}" for k, v in GPG_AGENT.items()]
    if new != lines:
        gnupg.mkdir(mode=0o700, exist_ok=True)
        write(conf, "\n".join(new) + "\n")
        subprocess.run(["gpgconf", "--reload", "gpg-agent"], check=False)


def passwords_has(name):
    store = pathlib.Path(os.environ.get("PASSWORD_STORE_DIR") or HOME / ".password-store")
    return (store / f"mail/{name}.gpg").exists()


def unlocked(accts, interactive):
    """Whether gpg-agent can decrypt the passwords; asks for the passphrase only if interactive."""
    env = dict(os.environ)
    if not interactive:
        env["PASSWORD_STORE_GPG_OPTS"] = "--pinentry-mode=error"
    r = subprocess.run(["pass", "show", f"mail/{accts[0]['name']}"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return r.returncode == 0


def notify(summary, body):
    stamp = STATE / "notified"
    try:
        if time.time() - stamp.stat().st_mtime < NOTIFY_EVERY:
            return
    except OSError:
        pass
    subprocess.run(["notify-send", "--app-name=deck-mail", summary, body], capture_output=True)
    stamp.touch()


def sync(interactive):
    accts = accounts()
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("deck-mail: a sync is already running")
        return 0
    accts = [a for a in accts if passwords_has(a["name"])]
    if not accts:
        print("deck-mail: no app passwords in pass yet (pass insert mail/<name>)")
        return 0
    if not unlocked(accts, interactive):
        notify("Mail sync is waiting", "The GPG passphrase isn't cached: run deck-mail unlock.")
        print("deck-mail: passwords locked; run deck-mail unlock")
        return 75
    (STATE / "notified").unlink(missing_ok=True)
    env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
    # Archives and deletes go first. If they can't (offline), nothing else runs: notmuch new's
    # hook sets `inbox` and `deleted` from the folders, and would undo them.
    if not all([push(a) for a in accts]):
        return 1
    failed = []
    for a in accts:  # one account failing doesn't hold up the others
        quiet = [] if interactive else ["-q"]  # in a terminal: progress
        r = subprocess.run(["mbsync", "-c", str(ISYNCRC), *quiet, a["name"]], env=env)
        if r.returncode:
            failed.append(a["name"])
    subprocess.run(["notmuch", "new", *([] if interactive else ["--quiet"])], check=True)
    # Only once the archive config is filled in: the example's placeholders would fail every sync.
    if ARCHIVE.exists() and "example" not in ARCHIVE.read_text():
        try:
            archive(dry_run=False, quiet=not interactive)
        except (OSError, SystemExit, subprocess.CalledProcessError) as e:
            print(f"deck-mail: archive: {e}")
    if any((STATE / "queue").glob("*.mail")):
        subprocess.run([f"{MSMTPQ}/msmtpq", "--q-mgmt", "-r"], env=dict(env, **QUEUE_ENV))
    if failed:
        print("deck-mail: mbsync failed for " + ", ".join(failed))
        return 1
    (STATE / "synced").touch()
    return 0


ARCHIVE_EXAMPLE = """\
# deck-mail archive: where mail's PDFs go in Nextcloud. On deck only, not in the repo.
url     https://cloud.example.org          # the Nextcloud server
user    you                                # its login
pass    nextcloud/deck                     # the `pass` entry holding a Nextcloud app password
folder  Family Archive                     # where in Nextcloud
# Where in the folder, from: {category} {name} (from archive-names), {year} {month} {day}
# {date} (YYYY-MM-DD) {sender} {subject} {file}. Each file also gets its category as a tag.
layout  {year}/{month}/{day}-{category} - {name}
local   ~/Documents/Archive                # a copy on deck, same layout
"""
ARCHIVE_KEYS = ("url", "user", "pass", "folder", "layout", "local")


def archive_config(upload=True):
    conf = {"layout": "{year}/{month}/{day}-{category} - {name}"}
    for line in ARCHIVE.read_text().splitlines():
        key, _, value = line.strip().partition(" ")
        if key in ARCHIVE_KEYS:
            conf[key] = value.split(" #")[0].strip()
    missing = [k for k in (("url", "user", "pass", "folder") if upload else ("folder",))
               if not conf.get(k) or "example" in conf[k]]
    if missing:
        raise SystemExit(f"deck-mail: {ARCHIVE}: missing {', '.join(missing)}")
    return conf


def archive_names():
    """archive-names' lines as (sender regex or sha256 prefix, file regex, category, name)."""
    names = []
    text = ARCHIVE_NAMES.read_text() if ARCHIVE_NAMES.exists() else ""
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = [p.strip() for p in line.split(" | ")]
        if len(parts) != 4:
            raise SystemExit(f"deck-mail: {ARCHIVE_NAMES}:{n}: not sender | file | category | name")
        sender, fname, category, name = parts
        try:
            if not sender.startswith("sha256:"):
                sender = re.compile(sender, re.I)
            names.append((sender, re.compile(fname, re.I), category, name))
        except re.error as e:
            raise SystemExit(f"deck-mail: {ARCHIVE_NAMES}:{n}: {e}")
    return names


def archive_name(names, sender, fname, digest):
    """The PDF's (category, name), ("-", "-") for one left out, None for one no line names."""
    for s, f, category, name in names:
        if isinstance(s, str):
            if digest.startswith(s.removeprefix("sha256:")):
                return (category, name)
            continue
        m = f.search(fname)
        if m and s.search(sender):
            if name == "-":
                return ("-", "-")
            fill = lambda t: re.sub(r"\{(\d+)\}", lambda g: m.group(int(g[1])) or "", t)
            return (fill(category), fill(name))
    return None


def safe(s, limit=80):
    """A file name's worth of text: no slashes or control characters, short."""
    s = "".join(c if c.isprintable() and c not in '/\\:*?"<>|' else " " for c in s)
    return " ".join(s.split())[:limit].strip(" .") or "unnamed"


def mail_pdfs(path):
    """The message's date, sender name, sender name and address, subject, and its PDFs as
    (file name, bytes)."""
    import datetime
    import email
    import email.policy
    import email.utils
    with open(path, "rb") as f:
        msg = email.message_from_binary_file(f, policy=email.policy.default)
    try:
        date = email.utils.parsedate_to_datetime(str(msg["Date"])).astimezone()
    except (TypeError, ValueError):
        date = datetime.datetime.fromtimestamp(os.path.getmtime(path)).astimezone()
    name, addr = email.utils.parseaddr(str(msg["From"] or ""))
    sender = name or addr.rpartition("@")[2].removeprefix("email.").removeprefix("mail.")
    pdfs = []
    for part in msg.walk():
        fname = part.get_filename() or ""
        if part.get_content_type() == "application/pdf" or fname.lower().endswith(".pdf"):
            data = part.get_payload(decode=True)
            if data and data.startswith(b"%PDF"):
                fname = safe(fname.removesuffix(".pdf").removesuffix(".PDF") or "attachment")
                pdfs.append((fname + ".pdf", data))
    return date, safe(sender, 40), f"{name} <{addr}>", safe(str(msg["Subject"] or "")), pdfs


def webdav(conf, password):
    """Nextcloud over WebDAV: call(method, path in the user's files), put(path, data) that
    creates the folders and never overwrites (a file already there gets " (2)", " (3)"…) and
    returns the path used, and tag(path, name), which gives the file that Nextcloud tag."""
    import base64
    import urllib.error
    import urllib.parse
    import urllib.request
    import xml.etree.ElementTree as ET
    dav = f"{conf['url'].rstrip('/')}/remote.php/dav/"
    files = f"files/{urllib.parse.quote(conf['user'])}/"
    auth = "Basic " + base64.b64encode(f"{conf['user']}:{password}".encode()).decode()
    made, tags = set(), None
    ns = {"d": "DAV:", "oc": "http://owncloud.org/ns"}

    def request(method, path, data=None, headers=None):
        # Its own User-Agent: bot blocking in front of Nextcloud turns away Python-urllib's.
        req = urllib.request.Request(dav + path, data=data, method=method,
                                     headers={"Authorization": auth, "User-Agent": "deck-mail",
                                              **(headers or {})})
        try:
            with urllib.request.urlopen(req, timeout=120) as r:
                return r.status, r.headers, r.read()
        except urllib.error.HTTPError as e:
            return e.code, e.headers, b""

    def propfind(path, props, depth="0"):
        body = ('<?xml version="1.0"?><d:propfind xmlns:d="DAV:" xmlns:oc="http://owncloud.org/ns">'
                f"<d:prop>{props}</d:prop></d:propfind>").encode()
        status, _, xml = request("PROPFIND", path, body,
                                 {"Depth": depth, "Content-Type": "application/xml"})
        if status != 207:
            raise OSError(f"Nextcloud: PROPFIND {path} failed ({status})")
        return ET.fromstring(xml).findall("d:response", ns)

    def call(method, rel, data=None):
        return request(method, files + urllib.parse.quote(rel), data)[0]

    def put(rel, data):
        parts = rel.split("/")
        for i in range(1, len(parts)):
            d = "/".join(parts[:i])
            if d not in made:
                if call("MKCOL", d) not in (201, 405):  # 405: it exists
                    raise OSError(f"Nextcloud: can't create {d}")
                made.add(d)
        stem, n = rel.removesuffix(".pdf"), 1
        while call("HEAD", rel) == 200:
            n += 1
            rel = f"{stem} ({n}).pdf"
        status = call("PUT", rel, data)
        if status not in (201, 204):
            raise OSError(f"Nextcloud: uploading {rel} failed ({status})")
        return rel

    def tag(rel, name):
        nonlocal tags
        if tags is None or name not in tags:  # Nextcloud's tags, by name: made once, then reused
            tags = {}
            for r in propfind("systemtags/", "<oc:id/><oc:display-name/>", "1"):
                i, n = r.find(".//oc:id", ns), r.find(".//oc:display-name", ns)
                if i is not None and n is not None:
                    tags[n.text] = i.text
        if name not in tags:
            body = json.dumps({"name": name, "userVisible": True, "userAssignable": True}).encode()
            status, headers, _ = request("POST", "systemtags/", body,
                                         {"Content-Type": "application/json"})
            if status != 201:
                raise OSError(f"Nextcloud: can't create the tag {name!r} ({status})")
            tags[name] = headers["Content-Location"].rstrip("/").rpartition("/")[2]
        found = propfind(files + urllib.parse.quote(rel), "<oc:fileid/>")
        fileid = found[0].find(".//oc:fileid", ns).text if found else None
        if not fileid:
            raise OSError(f"Nextcloud: no file id for {rel}")
        status = request("PUT", f"systemtags-relations/files/{fileid}/{tags[name]}")[0]
        if status not in (201, 409):  # 409: it has the tag already
            raise OSError(f"Nextcloud: tagging {rel} {name!r} failed ({status})")

    return call, put, tag


def archive(dry_run, quiet=False):
    """Copies mail's PDFs to Nextcloud, named and filed by archive-names, once each: a message
    done is tagged `archived`, and a PDF already sent (the same bytes, from another message) is
    not sent again. A message with a PDF archive-names doesn't know waits, untagged, for a line.
    Mail deleted from the mailbox still goes: Gmail empties the Bin after 30 days."""
    import hashlib
    conf = archive_config(upload=not dry_run)
    names = archive_names()
    query = ("(mimetype:application/pdf or attachment:pdf)"
             " and not tag:spam and not tag:noarchive and not tag:archived")
    ids = subprocess.run(["notmuch", "search", "--exclude=false", "--output=messages", query],
                         capture_output=True, text=True, check=True).stdout.split()
    if not ids:
        return 0
    seen_file = STATE / "archive.json"
    seen = json.loads(seen_file.read_text()) if seen_file.exists() else {}
    put = None
    if not dry_run:
        env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
        pw = subprocess.run(["pass", "show", conf["pass"]], capture_output=True, text=True, env=env)
        if pw.returncode or not pw.stdout.strip():
            print(f"deck-mail: archive: no password from `pass show {conf['pass']}`")
            return 1
        call, put, tag = webdav(conf, pw.stdout.splitlines()[0])
        if call("PROPFIND", conf["folder"]) != 207:
            print(f"deck-mail: archive: no folder {conf['folder']!r} in Nextcloud for {conf['user']}")
            return 1
    local = pathlib.Path(os.path.expanduser(conf["local"])) if conf.get("local") else None
    sent, left_out, unknown = 0, [], []
    for mid in ids:
        files = subprocess.run(["notmuch", "search", "--output=files", "--exclude=false", mid],
                               capture_output=True, text=True, check=True).stdout.split("\n")
        date, sender, from_, subject, pdfs = mail_pdfs(files[0])
        named = []
        for fname, data in pdfs:
            digest = hashlib.sha256(data).hexdigest()
            named.append((fname, data, digest,
                          archive_name(names, from_, fname.removesuffix(".pdf"), digest)))
        row = lambda f, d: f"{date:%Y-%m-%d}\t{from_}\t{f}\t{subject}\tsha256:{d[:16]}"
        missing = [row(f, d) for f, _, d, n in named if n is None and d not in seen]
        if missing:
            unknown += missing
            continue
        for fname, data, digest, name in named:
            if digest in seen:
                continue
            if name == ("-", "-"):
                left_out.append(row(fname, digest))
                seen[digest] = None if dry_run else "-"
                continue
            rel = conf["layout"].format(year=f"{date:%Y}", month=f"{date:%m}", day=f"{date:%d}",
                                        date=f"{date:%Y-%m-%d}",
                                        sender=sender, subject=subject, file=fname,
                                        category=name[0], name=name[1])
            rel = "/".join(safe(p, 120) for p in rel.split("/"))
            if not rel.lower().endswith(".pdf"):
                rel += ".pdf"
            if dry_run:
                print(f"{conf['folder']}/{rel}\t{subject}")
                seen[digest] = rel  # within this run only: the same PDF twice is listed once
                sent += 1
                continue
            rel = put(f"{conf['folder']}/{rel}", data).removeprefix(conf["folder"] + "/")
            if local:
                out = local / rel
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_bytes(data)
            seen[digest] = rel
            seen_file.write_text(json.dumps(seen, indent=1))
            sent += 1
            try:
                tag(f"{conf['folder']}/{rel}", name[0])
            except OSError as e:  # the file is there; only its tag is missing
                print(f"deck-mail: archive: {e}")
        if not dry_run:
            seen_file.write_text(json.dumps(seen, indent=1))
            subprocess.run(["notmuch", "tag", "+archived", "--", mid], check=True)
    if dry_run:
        for title, rows in (("left out", left_out), ("no line in archive-names: held back", unknown)):
            if rows:
                print(f"\n# {title} ({len(rows)})")
                print("\n".join(rows))
    if not quiet or sent or unknown:
        print(f"deck-mail: archive: {len(ids)} messages, {sent} PDFs "
              + ("would go to Nextcloud" if dry_run else "copied to Nextcloud")
              + f", {len(left_out)} left out"
              + (f", {len(unknown)} with no line in {ARCHIVE_NAMES} held back" if unknown else ""))
    return 0


CATEGORIES = ("Računi", "Kuća", "Djeca", "Zdravlje", "Financije", "Porezi", "Osiguranja", "Auto",
              "Putovanja", "Posao", "Obrazovanje", "Dokumenti")
REVIEW_START = "# --- Chosen in deck-mail review: first, so they win over the lines below"
REVIEW_END = "# --- end of review choices"


def review_load():
    """Every PDF archive would look at, once each: its messages, what archive-names says now."""
    import hashlib
    query = ("(mimetype:application/pdf or attachment:pdf)"
             " and not tag:spam and not tag:noarchive and not tag:archived")
    out = subprocess.run(["notmuch", "show", "--format=json", "--body=false", "--entire-thread=false",
                          "--exclude=false", query], capture_output=True, text=True, check=True).stdout

    def walk(node):  # notmuch show: threads of [message, replies] pairs
        if isinstance(node, dict):
            if node.get("match"):
                yield node
        elif isinstance(node, list):
            for n in node:
                yield from walk(n)

    names, rows, by_digest, deleted = archive_names(), [], {}, set()
    for m in walk(json.loads(out)):
        if "deleted" in m.get("tags", []):
            deleted.add(m["id"])
        files = m["filename"] if isinstance(m["filename"], list) else [m["filename"]]
        date, sender, from_, subject, pdfs = mail_pdfs(files[0])
        for fname, data in pdfs:
            digest = hashlib.sha256(data).hexdigest()
            if digest in by_digest:
                by_digest[digest]["mids"].append(m["id"])
                continue
            row = {"digest": digest, "date": date, "from": from_, "sender": sender,
                   "subject": subject, "file": fname, "mids": [m["id"]], "path": files[0],
                   "choice": archive_name(names, from_, fname.removesuffix(".pdf"), digest)}
            by_digest[digest] = row
            rows.append(row)
    rows.sort(key=lambda r: r["date"], reverse=True)
    return rows, deleted


def review_overrides():
    """The review section of archive-names as {sha256 prefix: (category, name)}."""
    text = ARCHIVE_NAMES.read_text() if ARCHIVE_NAMES.exists() else ""
    if REVIEW_START not in text:
        return {}
    section = text.split(REVIEW_START, 1)[1].split(REVIEW_END, 1)[0]
    chosen = {}
    for line in section.splitlines():
        parts = [p.strip() for p in line.split(" | ")]
        if len(parts) == 4 and parts[0].startswith("sha256:"):
            chosen[parts[0].removeprefix("sha256:")] = (parts[2], parts[3])
    return chosen


def review_save(chosen):
    """Writes the review section at the top of archive-names, the rest as it was."""
    text = ARCHIVE_NAMES.read_text() if ARCHIVE_NAMES.exists() else ""
    if REVIEW_START in text:
        before, rest = text.split(REVIEW_START, 1)
        text = before + rest.split(REVIEW_END, 1)[1].lstrip("\n")
    lines = text.splitlines()
    at = next((i for i, l in enumerate(lines) if l.strip() and not l.startswith("#")), len(lines))
    section = [REVIEW_START]
    section += [f"sha256:{d} | . | {c} | {n}" for d, (c, n) in chosen.items()]
    section += [REVIEW_END, ""]
    tmp = ARCHIVE_NAMES.with_suffix(".tmp")
    tmp.write_text("\n".join(lines[:at] + section + lines[at:]) + "\n")
    tmp.replace(ARCHIVE_NAMES)


def review():
    """A TUI over every PDF archive would send: choose which go to Nextcloud, as what, and which
    mail to delete."""
    import curses
    import locale
    import shutil
    import tempfile
    locale.setlocale(locale.LC_ALL, "")  # curses draws UTF-8 (č, ć, š) only with the locale set
    print("deck-mail: reading the PDFs in mail…", file=sys.stderr)
    rows, deleted = review_load()
    chosen = review_overrides()
    key = lambda r: r["digest"][:16]
    for r in rows:
        if key(r) in chosen:
            r["choice"] = chosen[key(r)]
    os.environ.setdefault("ESCDELAY", "25")  # Esc cancels at once, not after a second
    tmpdir = pathlib.Path(tempfile.mkdtemp(prefix="deck-mail-review-",
                                           dir=os.environ.get("XDG_RUNTIME_DIR")))
    texts = {}

    def pdf_file(r):
        p = tmpdir / f"{key(r)}.pdf"
        if not p.exists():
            for fname, data in mail_pdfs(r["path"])[4]:
                if fname == r["file"]:
                    p.write_bytes(data)
                    break
        return p

    def preview(r):
        if key(r) not in texts:
            t = subprocess.run(["mutool", "draw", "-q", "-F", "txt", "-o", "-", str(pdf_file(r)), "1"],
                               capture_output=True, text=True, errors="replace").stdout
            texts[key(r)] = [l.strip() for l in t.splitlines() if l.strip()]
        return texts[key(r)]

    def choose(r, choice):
        r["choice"] = choice
        chosen[key(r)] = choice
        review_save(chosen)

    def set_deleted(r, on):
        subprocess.run(["notmuch", "tag", "+deleted" if on else "-deleted", "--", *r["mids"]],
                       check=True)
        (deleted.update if on else deleted.difference_update)(r["mids"])

    def run(scr):
        curses.curs_set(0)
        curses.use_default_colors()
        for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED,
                               curses.COLOR_CYAN), 1):
            curses.init_pair(i, c, -1)
        GREEN, YELLOW, RED, CYAN = (curses.color_pair(i) for i in range(1, 5))
        views = ("all", "transfer", "left out", "no name", "delete")
        state = {"cur": 0, "top": 0, "view": 0, "filter": "", "msg": ""}

        def status(r):
            c = r["choice"]
            return "?" if c is None else ("·" if c == ("-", "-") else "✓")

        def visible():
            v, f = views[state["view"]], state["filter"].lower()
            out = []
            for r in rows:
                s = status(r)
                if v == "transfer" and s != "✓" or v == "left out" and s != "·" \
                        or v == "no name" and s != "?" \
                        or v == "delete" and not deleted.intersection(r["mids"]):
                    continue
                if f and f not in " ".join([r["from"], r["subject"], r["file"],
                                            *(r["choice"] or ())]).lower():
                    continue
                out.append(r)
            return out

        def put(y, x, s, attr=0):
            h, w = scr.getmaxyx()
            if 0 <= y < h and x < w:
                scr.addnstr(y, x, s, max(0, w - x - (1 if y == h - 1 else 0)), attr)

        def ask(prompt, initial=""):
            """A one-line editor on the bottom line: Enter accepts, Esc cancels (None)."""
            curses.curs_set(1)
            buf, pos = list(initial), len(initial)
            while True:
                h, w = scr.getmaxyx()
                scr.move(h - 1, 0)
                scr.clrtoeol()
                text = prompt + "".join(buf)
                start = max(0, len(prompt) + pos - w + 2)
                put(h - 1, 0, text[start:], curses.A_BOLD)
                scr.move(h - 1, min(w - 1, len(prompt) + pos - start))
                ch = scr.get_wch()
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    curses.curs_set(0)
                    return "".join(buf).strip()
                if ch == "\x1b":
                    curses.curs_set(0)
                    return None
                if ch in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    if pos:
                        del buf[pos - 1]
                        pos -= 1
                elif ch == curses.KEY_DC:
                    if pos < len(buf):
                        del buf[pos]
                elif ch == curses.KEY_LEFT:
                    pos = max(0, pos - 1)
                elif ch == curses.KEY_RIGHT:
                    pos = min(len(buf), pos + 1)
                elif ch in (curses.KEY_HOME, "\x01"):
                    pos = 0
                elif ch in (curses.KEY_END, "\x05"):
                    pos = len(buf)
                elif ch == "\x15":  # ^U
                    buf, pos = [], 0
                elif isinstance(ch, str) and ch.isprintable():
                    buf.insert(pos, ch)
                    pos += 1

        def pick_category(current):
            options = [f"{i + 1 if i < 9 else '0-='[i - 9]} {c}" for i, c in enumerate(CATEGORIES)]
            h, w = scr.getmaxyx()
            line = "  ".join(options)
            scr.move(h - 1, 0)
            scr.clrtoeol()
            put(h - 1, 0, "Category: " + line + "  (Esc: cancel)", curses.A_BOLD)
            while True:
                ch = scr.get_wch()
                if ch in ("\x1b", "q"):
                    return None
                if not isinstance(ch, str):
                    continue
                if ch in "123456789":
                    return CATEGORIES[int(ch) - 1]
                if ch in "0-=":
                    return CATEGORIES[9 + "0-=".index(ch)]
                if ch in ("\n", "\r") and current in CATEGORIES:
                    return current

        def transfer(r, rename=False, recategorise=False):
            c = r["choice"]
            cat, name = c if c and c != ("-", "-") else (None, None)
            if cat is None or recategorise:
                cat = pick_category(cat)
                if cat is None:
                    return
            if name is None or rename:
                guess = name or f"{r['sender']} - {r['file'].removesuffix('.pdf')}"
                name = ask("Name: ", guess)
                if not name:
                    return
            choose(r, (cat, safe(name, 90)))

        def draw(vis):
            scr.erase()
            h, w = scr.getmaxyx()
            list_h = max(3, h - 11)
            cur = state["cur"] = max(0, min(state["cur"], len(vis) - 1))
            if cur < state["top"]:
                state["top"] = cur
            if cur >= state["top"] + list_h:
                state["top"] = cur - list_h + 1
            n = {s: sum(status(r) == s for r in rows) for s in "✓·?"}
            head = (f" {n['✓']} to Nextcloud  {n['·']} left out  {n['?']} no name  "
                    f"{len({m for m in deleted})} mail to delete   view: {views[state['view']]}"
                    + (f"   filter: {state['filter']}" if state["filter"] else "")
                    + f"   {cur + 1 if vis else 0}/{len(vis)}")
            put(0, 0, head.ljust(w), curses.A_REVERSE)
            for i, r in enumerate(vis[state["top"]:state["top"] + list_h]):
                y, s = i + 1, status(r)
                attr = {"✓": GREEN, "·": curses.A_DIM, "?": YELLOW}[s]
                if state["top"] + i == cur:
                    attr |= curses.A_REVERSE
                c = r["choice"]
                cat = c[0] if c and c != ("-", "-") else ""
                name = c[1] if c and c != ("-", "-") else f"({r['sender']}: {r['file']})"
                dele = "D" if deleted.intersection(r["mids"]) else " "
                put(y, 0, f"{s}{dele} {r['date']:%Y-%m-%d} {cat:<11.11} {name}".ljust(w), attr)
                if dele == "D":
                    put(y, 1, "D", attr | RED | curses.A_BOLD)
            if vis:
                r = vis[cur]
                y = list_h + 1
                put(y, 0, "─" * w, curses.A_DIM)
                put(y + 1, 0, f"From:    {r['from']}", CYAN)
                put(y + 2, 0, f"Subject: {r['subject']}")
                put(y + 3, 0, f"File:    {r['file']}    sha256:{key(r)}"
                    + (f"    in {len(r['mids'])} messages" if len(r["mids"]) > 1 else ""))
                for j, line in enumerate(preview(r)[:h - y - 6]):
                    put(y + 4 + j, 2, line, curses.A_DIM)
            help_ = ("j/k move  t transfer  x leave out  space toggle  c category  e rename  "
                     "d delete mail  o open  / filter  v view  T/X all shown  q quit")
            put(h - 1, 0, (state["msg"] or help_)[:w - 1], curses.A_BOLD if state["msg"] else curses.A_DIM)
            state["msg"] = ""
            scr.refresh()
            return list_h

        while True:
            vis = visible()
            list_h = draw(vis)
            ch = scr.get_wch()
            r = vis[state["cur"]] if vis else None
            if ch in ("q", "Q"):
                return
            elif ch in ("j", curses.KEY_DOWN):
                state["cur"] += 1
            elif ch in ("k", curses.KEY_UP):
                state["cur"] -= 1
            elif ch in (curses.KEY_NPAGE, "\x06"):
                state["cur"] += list_h
            elif ch in (curses.KEY_PPAGE, "\x02"):
                state["cur"] -= list_h
            elif ch in ("g", curses.KEY_HOME):
                state["cur"] = 0
            elif ch in ("G", curses.KEY_END):
                state["cur"] = len(vis) - 1
            elif ch == "v":
                state["view"] = (state["view"] + 1) % len(views)
                state["cur"] = state["top"] = 0
            elif ch == "/":
                f = ask("Filter: ", state["filter"])
                if f is not None:
                    state["filter"], state["cur"], state["top"] = f, 0, 0
            elif ch == "\x1b":
                state["filter"] = ""
            elif r is None:
                continue
            elif ch == "t":
                transfer(r)
                state["cur"] += 1
            elif ch == "x":
                choose(r, ("-", "-"))
                state["cur"] += 1
            elif ch == " ":
                if status(r) == "✓":
                    choose(r, ("-", "-"))
                else:
                    transfer(r)
            elif ch == "c":
                transfer(r, recategorise=True)
            elif ch in ("e", "r"):
                transfer(r, rename=True)
            elif ch == "d":
                set_deleted(r, not deleted.intersection(r["mids"]))
                state["cur"] += 1
            elif ch == "o":
                subprocess.Popen(["xdg-open", str(pdf_file(r))], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
            elif ch in ("T", "X"):
                what = "to Nextcloud, as named now" if ch == "T" else "left out"
                todo = [x for x in vis if ch == "X" or x["choice"] not in (None, ("-", "-"))]
                if ch == "T" and len(todo) < len(vis):
                    what += f" ({len(vis) - len(todo)} with no name skipped)"
                if ask(f"All {len(todo)} shown {what}? [y/N] ") in ("y", "Y"):
                    for x in todo:
                        if ch == "X":
                            x["choice"] = ("-", "-")
                        chosen[key(x)] = x["choice"]
                    review_save(chosen)
                    state["msg"] = f"{len(todo)} changed"

    try:
        curses.wrapper(run)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    left = sum(r["choice"] is None for r in rows)
    print(f"deck-mail: review: choices are in {ARCHIVE_NAMES}"
          + (f"; {left} PDFs still have no name" if left else "")
          + ". deck-mail archive --dry-run shows what will go; sync sends it and deletes the mail.")
    return 0


def top(args):
    """Prints the most frequent senders, sender domains and subjects among the query's messages."""
    import collections
    import email.utils
    import re
    n = int(args.pop(0)) if args and args[0].isdigit() else 50
    out = subprocess.run(["notmuch", "show", "--format=json", "--body=false", "--entire-thread=false",
                          *(args or ["not", "tag:sent"])], capture_output=True, check=True).stdout

    def messages(x):
        if isinstance(x, dict):
            if "headers" in x:
                yield x
        elif isinstance(x, list):
            for y in x:
                yield from messages(y)

    counts = {k: collections.Counter() for k in ("senders", "sender domains", "subjects")}
    newest = {}
    for m in messages(json.loads(out)):
        h = m["headers"]
        addr = email.utils.parseaddr(h.get("From", ""))[1].lower()
        # Re:/Fwd: (and their German, Nordic forms) off, numbers as #: "Invoice 1234" and
        # "Invoice 1240" are one subject.
        subject = re.sub(r"^\s*((re|fwd?|aw|wg|sv)(\[\d+\])?:\s*)+", "", h.get("Subject", ""), flags=re.I)
        subject = re.sub(r"\d+", "#", " ".join(subject.split()))[:80]
        for kind, key in (("senders", f"from:{addr}"), ("sender domains", f"from:{addr.rpartition('@')[2]}"),
                          ("subjects", subject)):
            counts[kind][key] += 1
            newest[kind, key] = max(newest.get((kind, key), 0), m.get("timestamp", 0))
    for kind, c in counts.items():
        print(f"# the {n} most frequent {kind}: messages, newest (month), "
              + ("subject, numbers as #" if kind == "subjects" else "notmuch search"))
        for key, k in c.most_common(n):
            print(f"{k:6}  {time.strftime('%Y-%m', time.localtime(newest[kind, key]))}  {key}")
        print()
    return 0


def main():
    cmd = sys.argv[1:]
    if cmd == ["config"]:
        return config()
    if cmd == ["sync"]:
        return sync(sys.stdin.isatty())
    if cmd[:1] == ["send"]:  # aerc gives the recipients as arguments, the mail on stdin
        os.execve(f"{MSMTPQ}/msmtpq", ["msmtpq", "--read-envelope-from", *cmd[1:]],
                  dict(os.environ, **QUEUE_ENV))
    if cmd == ["unlock"]:
        return 0 if unlocked(accounts(), True) else 1
    if cmd[:1] == ["archive"]:
        if not ARCHIVE.exists():
            ARCHIVE.write_text(ARCHIVE_EXAMPLE)
            print(f"deck-mail: wrote an example {ARCHIVE}: fill it in, then deck-mail archive --dry-run")
            return 1
        return archive(dry_run="--dry-run" in cmd)
    if cmd == ["review"]:
        return review()
    if cmd[:1] == ["top"]:
        return top(cmd[1:])
    print(__doc__.split("\n\n", 2)[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
