#!/usr/bin/env python3
"""deck-mail: the mail setup on deck (hosts/deck/email.md): Gmail accounts kept offline in
~/Mail with mbsync, indexed by notmuch, read in aerc, sent through msmtp(q).

  deck-mail config   write each account's config from ~/.config/deck-mail/accounts
  deck-mail sync     fetch mail (mbsync), index it (notmuch new), send what's queued
  deck-mail unlock   ask for the GPG passphrase now, so the timer's syncs can read the passwords
  deck-mail send     aerc's outgoing command: msmtpq, which queues what can't go out now
  deck-mail archive [--dry-run] [--limit N]
                     copy mail's PDFs into the family archive on Nextcloud (WebDAV): where it
                     is in ~/.config/deck-mail/archive. Each PDF goes only once it's been
                     chosen, in mmm (t, x) or review: its category (also a tag in Nextcloud)
                     and name, or that it's left out, in ~/.config/deck-mail/archive-names.
                     Until then its mail is tagged pdf-waiting. Sender and file name lines
                     there only suggest. --dry-run lists every PDF and its name. `sync` runs it.
  deck-mail review    a TUI over those PDFs: which go to Nextcloud, in which folder, as what;
                     which are left out; and which mail to delete. It writes archive-names.
  deck-mail pdfs ID…  mmm's view of these messages' PDFs, as JSON
  deck-mail file SHA256 CATEGORY NAME | SHA256 - | SHA256 --forget
                     mmm's choice for one PDF: to Nextcloud as this, left out, or undecided
  deck-mail top [N] [query]
                     the N (50) most frequent senders, sender domains and subjects, with the
                     newest message's month: what to clean up. The query defaults to
                     `not tag:sent`; deleted and spam are always left out.
  deck-mail filter [--query Q | --train]
                     screen new mail in the inbox (notmuch's post-new hook runs it): tags
                     screener (a sender you don't know), suspect (looks like spam: DMARC,
                     a lookalike domain, bogofilter, an optional language model in
                     ~/.config/deck-mail/filter) or deleted (a blocked sender). --train teaches
                     bogofilter again now; `sync` does once a day.
  deck-mail screener allow|block|forget ADDRESS|@DOMAIN
                     a line in ~/.config/deck-mail/senders, and that sender's mail tagged to
                     match (mmm's A and B); prints what it tagged, as JSON
  deck-mail why ID…  mmm's view of why these messages were screened or are suspect, as JSON
  deck-mail unsubscribe [--check] ID
                     how the mail's List-Unsubscribe lets you leave the list (mmm's U); without
                     --check, the one-click request (RFC 8058) is sent

The account list stays out of the repo, which is public: addresses only on deck.
~/.config/deck-mail/accounts, one account a line, the first one the default for sending:

  # name       address               your name as senders see it
  ivankovic    you@your.domain       Your Name
  gmail        you@gmail.com         Your Name

`config` writes, from it: ~/.config/isyncrc (mbsync), ~/.config/msmtp/config,
~/.config/notmuch/default/config, ~/.config/aerc/accounts.conf. The rest is tracked in the repo
(aerc.conf, the notmuch hooks, the sync timer). Each account's app password is in `pass` as
mail/<name>.

Both ways, as tags in notmuch (aerc's d and a, home/.config/aerc/binds.conf):

  unread, flagged  maildir flags, which mbsync carries both ways
  archive          `inbox` removed: `sync` takes the Inbox label off in Gmail, over IMAP
  delete           tag `deleted`: `sync` moves the message to Gmail's Bin (kept 30 days)
  spam             tag `spam`: `sync` moves it to Gmail's Spam, Gmail's "Report spam"; without
                   the tag, a message in Spam goes back to the inbox. Gmail's Spam is synced,
                   so its own verdicts are `spam` here too
  the rest         comes from Gmail: new mail, archiving and deleting there, labels moved

Only here, never in Gmail: `screener` and `suspect` (deck-mail filter; mmm's Screener tab).

mbsync itself never deletes or uploads on Gmail: it pulls messages and their disappearance, and
pushes only flags. Archive and delete go through Gmail's own IMAP commands (X-GM-LABELS, MOVE),
whatever the account's IMAP settings say.

Every 5 min deck-mail.timer runs `sync`. It never asks for the passphrase itself: logging in
(greetd) and unlocking the screen (swaylock) hand the password to gpg-agent through pam_gnupg,
which unlocks the keys `config` lists in ~/.pam-gnupg (the GPG passphrase is the login password).
When gpg-agent still doesn't have it, `sync` notifies once and waits for `deck-mail unlock` (or a
`sync` in a terminal).
"""
import fcntl
import imaplib
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import time

HOME = pathlib.Path.home()
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "deck-mail"
ACCOUNTS = CONFIG / "deck-mail/accounts"
ARCHIVE = CONFIG / "deck-mail/archive"
ARCHIVE_NAMES = CONFIG / "deck-mail/archive-names"
MAIL = HOME / "Mail"
ISYNCRC = CONFIG / "isyncrc"
MSMTPQ = "/usr/share/msmtp/msmtpq"
# Gmail's folders: local name, the IMAP special-use flag that finds it, its English name.
# Gmail names them in the account's language (British English: "[Gmail]/Bin"), so `config` asks
# the server; the names here are the fallback. Spam is synced too: Gmail's verdicts are the `spam`
# tag here, and the filter learns from them. The inbox tabs aren't synced.
FOLDERS = [("INBOX", None, "INBOX"), ("All", r"\All", "[Gmail]/All Mail"),
           ("Sent", r"\Sent", "[Gmail]/Sent Mail"), ("Drafts", r"\Drafts", "[Gmail]/Drafts"),
           ("Trash", r"\Trash", "[Gmail]/Trash"), ("Spam", r"\Junk", "[Gmail]/Spam")]
NOTIFY_EVERY = 3600
# msmtpq: the queue and its log in the state folder; no connection test (debian.org ping): when
# msmtp fails, the mail is queued and the next sync sends it.
QUEUE_ENV = {"MSMTPQ_Q": str(STATE / "queue"), "MSMTPQ_LOG": str(STATE / "msmtpq.log"),
             "EMAIL_CONN_TEST": "x"}


def accounts():
    out = []
    for line in ACCOUNTS.read_text().splitlines():
        line = line.split("#", 1)[0].split()
        if line:
            if len(line) < 3 or "@" not in line[1]:
                sys.exit(f"deck-mail: {ACCOUNTS}: expected 'name address Your Name': {' '.join(line)}")
            out.append({"name": line[0], "address": line[1], "realname": " ".join(line[2:])})
    if not out:
        sys.exit(f"deck-mail: no accounts in {ACCOUNTS}")
    return out


def write(path, text, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    print(f"deck-mail: wrote {path}")


HEADER = "# Written by `deck-mail config` from {} (addresses stay off the repo). Edit that instead.\n"


def isyncrc(accts):
    out = [HEADER.format(ACCOUNTS)]
    for a in accts:
        n = a["name"]
        out.append(f"""
IMAPAccount {n}
Host imap.gmail.com
User {a["address"]}
PassCmd "pass show mail/{n}"
TLSType IMAPS
AuthMechs LOGIN

IMAPStore {n}-far
Account {n}

MaildirStore {n}-near
Path {MAIL}/{n}/
Inbox {MAIL}/{n}/INBOX
SubFolders Verbatim
""")
        for local, remote in a["folders"]:
            out.append(f"""
Channel {n}-{local.lower()}
Far :{n}-far:"{remote}"
Near :{n}-near:{local}
Sync PullNew PullGone Flags
Create Near
Expunge Near
SyncState *
CopyArrivalDate yes
""")
        out.append(f"\nGroup {n}\n" + "".join(f"Channel {n}-{l.lower()}\n" for l, _ in a["folders"]))
    return "".join(out)


def msmtprc(accts):
    out = [HEADER.format(ACCOUNTS), f"""
defaults
auth on
tls on
tls_trust_file system
logfile {STATE}/msmtp.log
"""]
    for a in accts:
        out.append(f"""
account {a["name"]}
host smtp.gmail.com
port 465
tls_starttls off
user {a["address"]}
from {a["address"]}
passwordeval pass show mail/{a["name"]}
""")
    out.append(f"\naccount default : {accts[0]['name']}\n")
    return "".join(out)


def notmuch(accts):
    others = ";".join(a["address"] for a in accts[1:])
    return HEADER.format(ACCOUNTS) + f"""
[database]
path={MAIL}
hook_dir={CONFIG}/notmuch/default/hooks

[user]
name={accts[0]["realname"]}
primary_email={accts[0]["address"]}
other_email={others}

[new]
tags=new
ignore=.mbsyncstate;.mbsyncstate.journal;.mbsyncstate.new;.mbsyncstate.lock;.uidvalidity;.isyncuidmap.db

[search]
exclude_tags=deleted;spam

[maildir]
synchronize_flags=true
"""


def aerc(accts):
    send = "/usr/local/bin/deck-mail send"
    first = accts[0]
    out = [HEADER.format(ACCOUNTS), f"""
# Everything, every account: notmuch searches (aerc/all.map).
[All]
source = notmuch://{MAIL}
query-map = {CONFIG}/aerc/all.map
folders-sort = Inbox,Unread,Flagged,Sent,Drafts,Everything,Bin
default = Inbox
from = {first["realname"]} <{first["address"]}>
aliases = {", ".join(a["address"] for a in accts[1:])}
outgoing = {send}
"""]
    for a in accts:
        out.append(f"""
[{a["name"]}]
source = notmuch://{MAIL}
maildir-store = {MAIL}
maildir-account-path = {a["name"]}
folders-sort = INBOX,All,Sent,Drafts,Trash
default = INBOX
from = {a["realname"]} <{a["address"]}>
outgoing = {send}
""")
    return "".join(out)


def login(a):
    """An IMAP connection to the account, or None without its password."""
    env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
    pw = subprocess.run(["pass", "show", f"mail/{a['name']}"], capture_output=True, text=True,
                        env=env)
    if pw.returncode or not pw.stdout.strip():
        return None
    imap = imaplib.IMAP4_SSL("imap.gmail.com", timeout=60)
    imap.login(a["address"], pw.stdout.splitlines()[0])
    return imap


def special(imap):
    """Gmail's folder names by special-use flag, in the account's language."""
    names = {flag: name for _, flag, name in FOLDERS if flag}
    for line in imap.list()[1]:
        line = line.decode()
        flags, name = line[1:line.index(")")].split(), line.rsplit(' "/" ', 1)[1].strip('"')
        for flag in names:
            if flag in flags:
                names[flag] = name
    return names


def quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def folders(a):
    """The account's Gmail folders, local name and Gmail's, by their special-use flags."""
    names = {flag: name for _, flag, name in FOLDERS if flag}
    try:
        imap = login(a)
        if imap is None:
            print(f"deck-mail: {a['name']}: no password to list Gmail's folders; English names")
        else:
            names = special(imap)
            imap.logout()
    except (OSError, imaplib.IMAP4.error, ValueError) as e:
        print(f"deck-mail: {a['name']}: couldn't list Gmail's folders ({e}); English names")
    return [(local, names[flag] if flag else name) for local, flag, name in FOLDERS]


def pending(query):
    """Message-IDs matching a notmuch search, deleted ones included."""
    out = subprocess.run(["notmuch", "search", "--exclude=false", "--format=json",
                          "--output=messages", query], capture_output=True, text=True, check=True)
    return json.loads(out.stdout)


def push(a):
    """Archive, delete and report spam in Gmail as was done on deck, and take out of Spam what
    deck says isn't. False if it failed."""
    n = a["name"]
    archive = pending(f'folder:"{n}/INBOX" and not tag:inbox')
    # Spam wins over delete: both move the message, and Spam is what trains Gmail.
    delete = pending(f'tag:deleted and not tag:spam and path:"{n}/**" and not folder:"{n}/Trash"')
    spam = pending(f'tag:spam and path:"{n}/**" and not folder:"{n}/Spam" and not folder:"{n}/Trash"')
    unspam = pending(f'folder:"{n}/Spam" and not tag:spam')
    if not archive and not delete and not spam and not unspam:
        return True
    try:
        imap = login(a)
        names = special(imap)

        # Both from All Mail: with INBOX selected, Gmail answers that the label is gone, and keeps it.
        if imap.select(quote(names[r"\All"]))[0] != "OK":
            raise imaplib.IMAP4.error(f"can't open {names[r'\All']}")

        def each(ids, *command):
            for mid in ids:
                uids = imap.uid("SEARCH", "X-GM-RAW", quote(f"rfc822msgid:{mid}"))[1][0].split()
                if uids:
                    typ, data = imap.uid(command[0], b",".join(uids).decode(), *command[1:])
                    if typ != "OK":
                        raise imaplib.IMAP4.error(f"{command[0]} {mid}: {data}")

        each(archive, "STORE", "-X-GM-LABELS", r"(\Inbox)")
        each(delete, "MOVE", quote(names[r"\Trash"]))
        # Moving to Spam is Gmail's "Report spam": it learns from it.
        each(spam, "MOVE", quote(names[r"\Junk"]))
        imap.close()
        if unspam:
            # Out of Spam: found by its header there (Gmail's own search leaves Spam out).
            if imap.select(quote(names[r"\Junk"]))[0] != "OK":
                raise imaplib.IMAP4.error(f"can't open {names[r'\Junk']}")
            for mid in unspam:
                uids = imap.uid("SEARCH", "HEADER", "Message-ID", quote(f"<{mid}>"))[1][0].split()
                if uids:
                    typ, data = imap.uid("MOVE", b",".join(uids).decode(), "INBOX")
                    if typ != "OK":
                        raise imaplib.IMAP4.error(f"MOVE {mid}: {data}")
            imap.close()
        imap.logout()
    except (OSError, imaplib.IMAP4.error, ValueError, AttributeError, IndexError) as e:
        print(f"deck-mail: {n}: archiving, deleting and reporting spam in Gmail failed: {e}")
        return False
    done = [f"{len(archive)} archived", f"{len(delete)} moved to the Bin"]
    done += [f"{len(spam)} reported as spam"] if spam else []
    done += [f"{len(unspam)} back from Spam"] if unspam else []
    print(f"deck-mail: {n}: {', '.join(done)} in Gmail")
    return True


def config():
    accts = accounts()
    for a in accts:
        a["folders"] = folders(a)
    write(ISYNCRC, isyncrc(accts))
    write(CONFIG / "msmtp/config", msmtprc(accts))
    write(CONFIG / "notmuch/default/config", notmuch(accts))
    write(CONFIG / "aerc/accounts.conf", aerc(accts))
    gpg_agent()
    pam_gnupg()
    STATE.mkdir(parents=True, exist_ok=True)
    for a in accts:
        (MAIL / a["name"]).mkdir(parents=True, exist_ok=True)
    for path, example in ((SENDERS, SENDERS_EXAMPLE), (FILTER, FILTER_EXAMPLE)):
        if not path.exists():
            write(path, example, 0o644)
    # The index is rebuilt from the mail by `notmuch new`: out of the hourly snapshots.
    if not (MAIL / ".notmuch").exists():
        subprocess.run(["deck-nosnap", str(MAIL / ".notmuch")], check=False)
    missing = [a["name"] for a in accts if not passwords_has(a["name"])]
    if missing:
        print("deck-mail: no app password yet for " + ", ".join(missing) + ": "
              + "; ".join(f"pass insert mail/{m}" for m in missing))
    return 0


# gpg-agent keeps the passphrase while it's used (a sync every 5 min), at most 12 h, when typed at
# its prompt. One pam_gnupg presets at login and screen unlock stays until gpg-agent restarts.
# Written here: the repo's hooks keep anything under .gnupg out of it.
GPG_AGENT = {"default-cache-ttl": "900", "max-cache-ttl": "43200", "allow-preset-passphrase": ""}


def gpg_agent():
    gnupg = pathlib.Path(os.environ.get("GNUPGHOME") or HOME / ".gnupg")
    conf = gnupg / "gpg-agent.conf"
    lines = conf.read_text().splitlines() if conf.exists() else []
    keep = [l for l in lines if l.split()[:1] not in ([k] for k in GPG_AGENT)]
    new = keep + [f"{k} {v}".rstrip() for k, v in GPG_AGENT.items()]
    if new != lines:
        gnupg.mkdir(mode=0o700, exist_ok=True)
        write(conf, "\n".join(new) + "\n")
        subprocess.run(["gpgconf", "--reload", "gpg-agent"], check=False)


def pam_gnupg():
    """~/.pam-gnupg: the keygrips of the key `pass` encrypts to, for pam_gnupg to unlock."""
    store = pathlib.Path(os.environ.get("PASSWORD_STORE_DIR") or HOME / ".password-store")
    try:
        ids = (store / ".gpg-id").read_text().split()
    except OSError:
        return
    r = subprocess.run(["gpg", "--list-secret-keys", "--with-colons", "--with-keygrip", "--", *ids],
                       capture_output=True, text=True)
    grips = [l.split(":")[9] for l in r.stdout.splitlines() if l.startswith("grp:")]
    if r.returncode or not grips:
        print("deck-mail: no secret key for ~/.password-store/.gpg-id; ~/.pam-gnupg left as it is")
        return
    conf = HOME / ".pam-gnupg"
    text = "# deck-mail config: the keys pam_gnupg unlocks with the login password\n" + \
        "".join(g + "\n" for g in grips)
    if not conf.exists() or conf.read_text() != text:
        write(conf, text)


def passwords_has(name):
    store = pathlib.Path(os.environ.get("PASSWORD_STORE_DIR") or HOME / ".password-store")
    return (store / f"mail/{name}.gpg").exists()


def unlocked(accts, interactive):
    """Whether gpg-agent can decrypt the passwords; asks for the passphrase only if interactive."""
    env = dict(os.environ)
    if not interactive:
        env["PASSWORD_STORE_GPG_OPTS"] = "--pinentry-mode=error"
    r = subprocess.run(["pass", "show", f"mail/{accts[0]['name']}"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return r.returncode == 0


def notify(summary, body):
    stamp = STATE / "notified"
    try:
        if time.time() - stamp.stat().st_mtime < NOTIFY_EVERY:
            return
    except OSError:
        pass
    subprocess.run(["notify-send", "--app-name=deck-mail", summary, body], capture_output=True)
    stamp.touch()


def sync(interactive):
    accts = accounts()
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("deck-mail: a sync is already running")
        return 0
    accts = [a for a in accts if passwords_has(a["name"])]
    if not accts:
        print("deck-mail: no app passwords in pass yet (pass insert mail/<name>)")
        return 0
    if not unlocked(accts, interactive):
        notify("Mail sync is waiting", "The GPG passphrase isn't cached: run deck-mail unlock.")
        print("deck-mail: passwords locked; run deck-mail unlock")
        return 75
    (STATE / "notified").unlink(missing_ok=True)
    env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
    # Archives and deletes go first. If they can't (offline), nothing else runs: notmuch new's
    # hook sets `inbox` and `deleted` from the folders, and would undo them.
    if not all([push(a) for a in accts]):
        return 1
    failed = []
    for a in accts:  # one account failing doesn't hold up the others
        quiet = [] if interactive else ["-q"]  # in a terminal: progress
        r = subprocess.run(["mbsync", "-c", str(ISYNCRC), *quiet, a["name"]], env=env)
        if r.returncode:
            failed.append(a["name"])
    subprocess.run(["notmuch", "new", *([] if interactive else ["--quiet"])], check=True)
    if shutil.which("bogofilter"):
        try:
            train()
        except (OSError, subprocess.CalledProcessError) as e:
            print(f"deck-mail: filter: teaching bogofilter failed: {e}")
    # Only once the archive config is filled in: the example's placeholders would fail every sync.
    if ARCHIVE.exists() and "example" not in ARCHIVE.read_text():
        try:
            archive(dry_run=False, quiet=not interactive)
        except (OSError, SystemExit, subprocess.CalledProcessError) as e:
            print(f"deck-mail: archive: {e}")
    if any((STATE / "queue").glob("*.mail")):
        subprocess.run([f"{MSMTPQ}/msmtpq", "--q-mgmt", "-r"], env=dict(env, **QUEUE_ENV))
    if failed:
        print("deck-mail: mbsync failed for " + ", ".join(failed))
        return 1
    (STATE / "synced").touch()
    return 0


ARCHIVE_EXAMPLE = """\
# deck-mail archive: where mail's PDFs go in Nextcloud. On deck only, not in the repo.
url     https://cloud.example.org          # the Nextcloud server
user    you                                # its login
pass    nextcloud/deck                     # the `pass` entry holding a Nextcloud app password
folder  Family Archive                     # where in Nextcloud; / for the account's own root
# Where in the folder, from: {category} {name} (from archive-names), {year} {month} {day}
# {date} (YYYY-MM-DD) {sender} {subject} {file}. Each file also gets its category as a tag (Nextcloud).
layout  {year}/{month}/{day}-{category} - {name}
# The server: nextcloud (default) or webdav, any plain WebDAV server (url is then the WebDAV root;
# no tags, the category stays in the name). cert: a PEM file with a client certificate and its
# key, for a server that asks for one.
#server webdav
#cert   ~/.local/share/ffca/deck.pem
# File names as they are, or "hyphens": ASCII, words joined by hyphens (17-Kuca-racun-12.pdf)
style   spaces
local   ~/Documents/Archive                # a copy on deck, same layout
"""
ARCHIVE_KEYS = ("url", "user", "pass", "folder", "layout", "local", "style", "server", "cert")


def archive_config(upload=True):
    conf = {"layout": "{year}/{month}/{day}-{category} - {name}"}
    for line in ARCHIVE.read_text().splitlines():
        key, _, value = line.strip().partition(" ")
        if key in ARCHIVE_KEYS:
            conf[key] = value.split(" #")[0].strip()
    missing = [k for k in (("url", "user", "pass", "folder") if upload else ("folder",))
               if not conf.get(k) or "example" in conf[k]]
    if missing:
        raise SystemExit(f"deck-mail: {ARCHIVE}: missing {', '.join(missing)}")
    return conf


def archive_names():
    """archive-names' lines as (sender regex or sha256 prefix, file regex, category, name)."""
    names = []
    text = ARCHIVE_NAMES.read_text() if ARCHIVE_NAMES.exists() else ""
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = [p.strip() for p in line.split(" | ")]
        if len(parts) != 4:
            raise SystemExit(f"deck-mail: {ARCHIVE_NAMES}:{n}: not sender | file | category | name")
        sender, fname, category, name = parts
        try:
            if not sender.startswith("sha256:"):
                sender = re.compile(sender, re.I)
            names.append((sender, re.compile(fname, re.I), category, name))
        except re.error as e:
            raise SystemExit(f"deck-mail: {ARCHIVE_NAMES}:{n}: {e}")
    return names


def confirmed(names, digest):
    """What was chosen for this very PDF (a sha256 line): its (category, name), ("-", "-") for
    one left out, None for one no one has decided on yet. Only these go to Nextcloud."""
    for s, _, category, name in names:
        if isinstance(s, str) and digest.startswith(s.removeprefix("sha256:")):
            return (category, name)
    return None


def suggested(names, sender, fname):
    """What the sender and file name lines say a PDF is: only a suggestion, shown in review and
    mmm until it's confirmed. (category, name), ("-", "-") for one to leave out, or None."""
    for s, f, category, name in names:
        if isinstance(s, str):
            continue
        m = f.search(fname)
        if m and s.search(sender):
            if name == "-":
                return ("-", "-")
            fill = lambda t: re.sub(r"\{(\d+)\}", lambda g: m.group(int(g[1])) or "", t)
            return (fill(category), fill(name))
    return None


def hyphenated(s):
    """The archive's own style for a file name: ASCII letters and digits, words joined by
    hyphens ("Kuća - račun 12/3" → "Kuca-racun-12-3")."""
    import unicodedata
    s = s.translate(str.maketrans({"đ": "d", "Đ": "D", "ß": "ss", "ø": "o", "Ø": "O", "ł": "l"}))
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode()
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-") or "unnamed"


def safe(s, limit=80):
    """A file name's worth of text: no slashes or control characters, short."""
    s = "".join(c if c.isprintable() and c not in '/\\:*?"<>|' else " " for c in s)
    return " ".join(s.split())[:limit].strip(" .") or "unnamed"


def mail_pdfs(path):
    """The message's date, sender name, sender name and address, subject, and its PDFs as
    (file name, bytes)."""
    import datetime
    import email
    import email.policy
    import email.utils
    with open(path, "rb") as f:
        msg = email.message_from_binary_file(f, policy=email.policy.default)
    try:
        date = email.utils.parsedate_to_datetime(str(msg["Date"])).astimezone()
    except (TypeError, ValueError):
        date = datetime.datetime.fromtimestamp(os.path.getmtime(path)).astimezone()
    name, addr = email.utils.parseaddr(str(msg["From"] or ""))
    sender = name or addr.rpartition("@")[2].removeprefix("email.").removeprefix("mail.")
    pdfs = []
    for part in msg.walk():
        fname = part.get_filename() or ""
        if part.get_content_type() == "application/pdf" or fname.lower().endswith(".pdf"):
            data = part.get_payload(decode=True)
            if data and data.startswith(b"%PDF"):
                fname = safe(fname.removesuffix(".pdf").removesuffix(".PDF") or "attachment")
                pdfs.append((fname + ".pdf", data))
    return date, safe(sender, 40), f"{name} <{addr}>", safe(str(msg["Subject"] or "")), pdfs


def webdav(conf, password):
    """The archive over WebDAV (Nextcloud's, or a plain server with `server webdav`):
    call(method, path in the user's files), put(path, data) that creates the folders and never
    overwrites (a file already there gets " (2)", " (3)"…, or -2, -3… in the hyphens style) and
    returns the path used, and tag(path, name), which gives the file that Nextcloud tag (on a
    plain server, nothing: the category is in the name)."""
    import base64
    import ssl
    import urllib.error
    import urllib.parse
    import urllib.request
    import xml.etree.ElementTree as ET
    plain = conf.get("server", "nextcloud") == "webdav"
    label = "WebDAV" if plain else "Nextcloud"
    if plain:
        dav, files = f"{conf['url'].rstrip('/')}/", ""
    else:
        dav = f"{conf['url'].rstrip('/')}/remote.php/dav/"
        files = f"files/{urllib.parse.quote(conf['user'])}/"
    context = None
    if conf.get("cert"):  # a client certificate, for a server that asks for one
        context = ssl.create_default_context()
        context.load_cert_chain(os.path.expanduser(conf["cert"]))
    auth = "Basic " + base64.b64encode(f"{conf['user']}:{password}".encode()).decode()
    made, tags = set(), None
    ns = {"d": "DAV:", "oc": "http://owncloud.org/ns"}

    def request(method, path, data=None, headers=None):
        # Its own User-Agent: bot blocking in front of Nextcloud turns away Python-urllib's.
        req = urllib.request.Request(dav + path, data=data, method=method,
                                     headers={"Authorization": auth, "User-Agent": "deck-mail",
                                              **(headers or {})})
        try:
            with urllib.request.urlopen(req, timeout=120, context=context) as r:
                return r.status, r.headers, r.read()
        except urllib.error.HTTPError as e:
            return e.code, e.headers, b""

    def propfind(path, props, depth="0"):
        body = ('<?xml version="1.0"?><d:propfind xmlns:d="DAV:" xmlns:oc="http://owncloud.org/ns">'
                f"<d:prop>{props}</d:prop></d:propfind>").encode()
        status, _, xml = request("PROPFIND", path, body,
                                 {"Depth": depth, "Content-Type": "application/xml"})
        if status != 207:
            raise OSError(f"{label}: PROPFIND {path} failed ({status})")
        return ET.fromstring(xml).findall("d:response", ns)

    def call(method, rel, data=None):
        return request(method, files + urllib.parse.quote(rel), data)[0]

    def put(rel, data):
        parts = rel.split("/")
        for i in range(1, len(parts)):
            d = "/".join(parts[:i])
            if d not in made:
                if call("MKCOL", d) not in (201, 405):  # 405: it exists
                    raise OSError(f"{label}: can't create {d}")
                made.add(d)
        def same(rel):  # a file already there with these bytes: sent before, its answer lost
            status, _, body = request("GET", files + urllib.parse.quote(rel))
            return status == 200 and body == data

        stem, n = rel.removesuffix(".pdf"), 1
        while call("HEAD", rel) == 200:
            if same(rel):
                return rel
            n += 1
            rel = f"{stem}-{n}.pdf" if conf.get("style") == "hyphens" else f"{stem} ({n}).pdf"
        for attempt in range(4):
            try:
                status = call("PUT", rel, data)
            except OSError:  # a timeout or a dropped connection
                status = None
            # A gateway timeout often comes after Nextcloud has stored the file.
            if status in (201, 204) or call("HEAD", rel) == 200 and same(rel):
                return rel
            if status is not None and status < 500:
                break
            time.sleep(10 * (attempt + 1))
        raise OSError(f"{label}: uploading {rel} failed ({status})")

    def tag(rel, name):
        nonlocal tags
        if plain:
            return
        if tags is None or name not in tags:  # Nextcloud's tags, by name: made once, then reused
            tags = {}
            for r in propfind("systemtags/", "<oc:id/><oc:display-name/>", "1"):
                i, n = r.find(".//oc:id", ns), r.find(".//oc:display-name", ns)
                if i is not None and n is not None:
                    tags[n.text] = i.text
        if name not in tags:
            body = json.dumps({"name": name, "userVisible": True, "userAssignable": True}).encode()
            status, headers, _ = request("POST", "systemtags/", body,
                                         {"Content-Type": "application/json"})
            if status != 201:
                raise OSError(f"Nextcloud: can't create the tag {name!r} ({status})")
            tags[name] = headers["Content-Location"].rstrip("/").rpartition("/")[2]
        found = propfind(files + urllib.parse.quote(rel), "<oc:fileid/>")
        fileid = found[0].find(".//oc:fileid", ns).text if found else None
        if not fileid:
            raise OSError(f"Nextcloud: no file id for {rel}")
        status = request("PUT", f"systemtags-relations/files/{fileid}/{tags[name]}")[0]
        if status not in (201, 409):  # 409: it has the tag already
            raise OSError(f"Nextcloud: tagging {rel} {name!r} failed ({status})")

    return call, put, tag


WAITING = "pdf-waiting"


def nm_id(mid):
    """A message id as a notmuch query term."""
    return "id:" + (mid if re.fullmatch(r"[^\s\"()]+", mid) else '"' + mid.replace('"', '""') + '"')


ARCHIVE_QUERY = ("(mimetype:application/pdf or attachment:pdf)"
                 " and not tag:spam and not tag:noarchive and not tag:archived")


def mark_waiting(waiting):
    """Tags `pdf-waiting` exactly the messages (ids) in `waiting`: mail with a PDF no one has
    decided on yet, mmm's Waiting tab. Only what changes is tagged."""
    have = set(subprocess.run(["notmuch", "search", "--exclude=false", "--output=messages",
                               f"tag:{WAITING}"], capture_output=True, text=True,
                              check=True).stdout.split())
    have = {h.removeprefix("id:") for h in have}
    batch = [f"+{WAITING} -- {nm_id(m)}" for m in sorted(set(waiting) - have)]
    batch += [f"-{WAITING} -- {nm_id(m)}" for m in sorted(have - set(waiting))]
    if batch:
        subprocess.run(["notmuch", "tag", "--batch"], input="\n".join(batch) + "\n", text=True,
                       check=True)


def archive_seen():
    f = STATE / "archive.json"
    return json.loads(f.read_text()) if f.exists() else {}


def archive(dry_run, quiet=False, limit=None):
    """Copies mail's PDFs to Nextcloud once each, as chosen for each one in mmm or review: a
    message done is tagged `archived`, and a PDF already sent (the same bytes, from another
    message) is not sent again. A message with a PDF no one has decided on waits, tagged
    `pdf-waiting`. Mail deleted from the mailbox still goes: Gmail empties the Bin after 30 days."""
    import hashlib
    conf = archive_config(upload=not dry_run)
    names = archive_names()
    ids = subprocess.run(["notmuch", "search", "--exclude=false", "--output=messages", ARCHIVE_QUERY],
                         capture_output=True, text=True, check=True).stdout.split()
    if not ids:
        if not dry_run:
            mark_waiting([])
        return 0
    seen_file = STATE / "archive.json"
    seen = archive_seen()
    put = None
    if not dry_run:
        env = dict(os.environ, PASSWORD_STORE_GPG_OPTS="--pinentry-mode=error")
        pw = subprocess.run(["pass", "show", conf["pass"]], capture_output=True, text=True, env=env)
        if pw.returncode or not pw.stdout.strip():
            print(f"deck-mail: archive: no password from `pass show {conf['pass']}`")
            return 1
        call, put, tag = webdav(conf, pw.stdout.splitlines()[0])
        if call("PROPFIND", conf["folder"].strip("/")) != 207:
            print(f"deck-mail: archive: no folder {conf['folder']!r} on {conf['url']} for {conf['user']}")
            return 1
    local = pathlib.Path(os.path.expanduser(conf["local"])) if conf.get("local") else None
    # The folder, or "/" for the account's root (a WebDAV account that sees only the archive).
    root = conf["folder"].strip("/")
    def inside(rel):
        return f"{root}/{rel}" if root else rel
    sent, left_out, unknown, waiting = 0, [], [], []
    for mid in ids:
        files = subprocess.run(["notmuch", "search", "--output=files", "--exclude=false", mid],
                               capture_output=True, text=True, check=True).stdout.split("\n")
        date, sender, from_, subject, pdfs = mail_pdfs(files[0])
        named = []
        for fname, data in pdfs:
            digest = hashlib.sha256(data).hexdigest()
            named.append((fname, data, digest, confirmed(names, digest)))
        row = lambda f, d: f"{date:%Y-%m-%d}\t{from_}\t{f}\t{subject}\tsha256:{d[:16]}"
        missing = [row(f, d) for f, _, d, n in named if n is None and d not in seen]
        if missing:
            unknown += missing
            waiting.append(mid.removeprefix("id:"))
            continue
        if limit is not None and sent >= limit:
            break
        for fname, data, digest, name in named:
            if digest in seen:
                continue
            if limit is not None and sent >= limit:
                break
            if name == ("-", "-"):
                left_out.append(row(fname, digest))
                seen[digest] = None if dry_run else "-"
                continue
            rel = conf["layout"].format(year=f"{date:%Y}", month=f"{date:%m}", day=f"{date:%d}",
                                        date=f"{date:%Y-%m-%d}",
                                        sender=sender, subject=subject, file=fname,
                                        category=name[0], name=name[1])
            rel = "/".join(safe(p, 120) for p in rel.split("/"))
            rel = rel.removesuffix(".pdf").removesuffix(".PDF")
            if conf.get("style") == "hyphens":
                rel = "/".join(hyphenated(p) for p in rel.split("/"))
            rel += ".pdf"
            if dry_run:
                print(f"{inside(rel)}\t{subject}")
                seen[digest] = rel  # within this run only: the same PDF twice is listed once
                sent += 1
                continue
            rel = put(inside(rel), data).removeprefix(inside(""))
            if local:
                out = local / rel
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_bytes(data)
            seen[digest] = rel
            seen_file.write_text(json.dumps(seen, indent=1))
            sent += 1
            try:
                tag(inside(rel), name[0])
            except OSError as e:  # the file is there; only its tag is missing
                print(f"deck-mail: archive: {e}")
        if not dry_run and all(d in seen for _, _, d, _ in named):  # --limit can stop halfway
            seen_file.write_text(json.dumps(seen, indent=1))
            subprocess.run(["notmuch", "tag", "+archived", "--", mid], check=True)
    if not dry_run and limit is None:  # --limit stops before it has looked at every message
        mark_waiting(waiting)
    if dry_run:
        for title, rows in (("left out", left_out), ("not decided yet: waiting", unknown)):
            if rows:
                print(f"\n# {title} ({len(rows)})")
                print("\n".join(rows))
    if not quiet or sent or unknown:
        print(f"deck-mail: archive: {len(ids)} messages, {sent} PDFs "
              + ("would go to Nextcloud" if dry_run else "copied to Nextcloud")
              + f", {len(left_out)} left out"
              + (f", {len(unknown)} waiting for a decision (mmm's Waiting tab)" if unknown else ""))
    return 0


CATEGORIES = ("Računi", "Kuća", "Djeca", "Zdravlje", "Financije", "Porezi", "Osiguranja", "Auto",
              "Putovanja", "Posao", "Obrazovanje", "Dokumenti")
REVIEW_START = "# --- Chosen in deck-mail review: first, so they win over the lines below"
REVIEW_END = "# --- end of review choices"


def review_load():
    """Every PDF archive would look at, once each: its messages, what was chosen for it, and
    what the sender and file name lines suggest."""
    import hashlib
    out = subprocess.run(["notmuch", "show", "--format=json", "--body=false", "--entire-thread=false",
                          "--exclude=false", ARCHIVE_QUERY], capture_output=True, text=True,
                         check=True).stdout

    def walk(node):  # notmuch show: threads of [message, replies] pairs
        if isinstance(node, dict):
            if node.get("match"):
                yield node
        elif isinstance(node, list):
            for n in node:
                yield from walk(n)

    names, rows, by_digest, deleted = archive_names(), [], {}, set()
    for m in walk(json.loads(out)):
        if "deleted" in m.get("tags", []):
            deleted.add(m["id"])
        files = m["filename"] if isinstance(m["filename"], list) else [m["filename"]]
        date, sender, from_, subject, pdfs = mail_pdfs(files[0])
        for fname, data in pdfs:
            digest = hashlib.sha256(data).hexdigest()
            if digest in by_digest:
                by_digest[digest]["mids"].append(m["id"])
                continue
            row = {"digest": digest, "date": date, "from": from_, "sender": sender,
                   "subject": subject, "file": fname, "mids": [m["id"]], "path": files[0],
                   "choice": confirmed(names, digest),
                   "suggestion": suggested(names, from_, fname.removesuffix(".pdf"))}
            by_digest[digest] = row
            rows.append(row)
    rows.sort(key=lambda r: r["date"], reverse=True)
    return rows, deleted


def review_overrides():
    """The review section of archive-names as {sha256 prefix: (category, name)}."""
    text = ARCHIVE_NAMES.read_text() if ARCHIVE_NAMES.exists() else ""
    if REVIEW_START not in text:
        return {}
    section = text.split(REVIEW_START, 1)[1].split(REVIEW_END, 1)[0]
    chosen = {}
    for line in section.splitlines():
        parts = [p.strip() for p in line.split(" | ")]
        if len(parts) == 4 and parts[0].startswith("sha256:"):
            chosen[parts[0].removeprefix("sha256:")] = (parts[2], parts[3])
    return chosen


def review_save(chosen):
    """Writes the review section at the top of archive-names, the rest as it was."""
    text = ARCHIVE_NAMES.read_text() if ARCHIVE_NAMES.exists() else ""
    if REVIEW_START in text:
        before, rest = text.split(REVIEW_START, 1)
        text = before + rest.split(REVIEW_END, 1)[1].lstrip("\n")
    lines = text.splitlines()
    at = next((i for i, l in enumerate(lines) if l.strip() and not l.startswith("#")), len(lines))
    section = [REVIEW_START]
    section += [f"sha256:{d} | . | {c} | {n}" for d, (c, n) in chosen.items()]
    section += [REVIEW_END, ""]
    tmp = ARCHIVE_NAMES.with_suffix(".tmp")
    tmp.write_text("\n".join(lines[:at] + section + lines[at:]) + "\n")
    tmp.replace(ARCHIVE_NAMES)


def review():
    """A TUI over every PDF archive would send: choose which go to Nextcloud, as what, and which
    mail to delete."""
    import curses
    import locale
    import shutil
    import tempfile
    locale.setlocale(locale.LC_ALL, "")  # curses draws UTF-8 (č, ć, š) only with the locale set
    print("deck-mail: reading the PDFs in mail…", file=sys.stderr)
    rows, deleted = review_load()
    chosen = review_overrides()
    key = lambda r: r["digest"][:16]
    for r in rows:
        if key(r) in chosen:
            r["choice"] = chosen[key(r)]
    os.environ.setdefault("ESCDELAY", "25")  # Esc cancels at once, not after a second
    tmpdir = pathlib.Path(tempfile.mkdtemp(prefix="deck-mail-review-",
                                           dir=os.environ.get("XDG_RUNTIME_DIR")))
    texts = {}

    def pdf_file(r):
        p = tmpdir / f"{key(r)}.pdf"
        if not p.exists():
            for fname, data in mail_pdfs(r["path"])[4]:
                if fname == r["file"]:
                    p.write_bytes(data)
                    break
        return p

    def preview(r):
        if key(r) not in texts:
            t = subprocess.run(["mutool", "draw", "-q", "-F", "txt", "-o", "-", str(pdf_file(r)), "1"],
                               capture_output=True, text=True, errors="replace").stdout
            texts[key(r)] = [l.strip() for l in t.splitlines() if l.strip()]
        return texts[key(r)]

    def choose(r, choice):
        r["choice"] = choice
        chosen[key(r)] = choice
        review_save(chosen)

    def set_deleted(r, on):
        # As id: terms: a bare Message-ID is a query, and the sender picks it (<*> is every mail).
        subprocess.run(["notmuch", "tag", "+deleted" if on else "-deleted", "--",
                        *(nm_id(m) for m in r["mids"])], check=True)
        (deleted.update if on else deleted.difference_update)(r["mids"])

    def run(scr):
        curses.curs_set(0)
        curses.use_default_colors()
        for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED,
                               curses.COLOR_CYAN), 1):
            curses.init_pair(i, c, -1)
        GREEN, YELLOW, RED, CYAN = (curses.color_pair(i) for i in range(1, 5))
        views = ("all", "transfer", "left out", "waiting", "delete")
        state = {"cur": 0, "top": 0, "view": 0, "filter": "", "msg": ""}

        def status(r):
            c = r["choice"]
            return "?" if c is None else ("·" if c == ("-", "-") else "✓")

        def visible():
            v, f = views[state["view"]], state["filter"].lower()
            out = []
            for r in rows:
                s = status(r)
                if v == "transfer" and s != "✓" or v == "left out" and s != "·" \
                        or v == "waiting" and s != "?" \
                        or v == "delete" and not deleted.intersection(r["mids"]):
                    continue
                if f and f not in " ".join([r["from"], r["subject"], r["file"],
                                            *(r["choice"] or ())]).lower():
                    continue
                out.append(r)
            return out

        def put(y, x, s, attr=0):
            h, w = scr.getmaxyx()
            if 0 <= y < h and x < w:
                scr.addnstr(y, x, s, max(0, w - x - (1 if y == h - 1 else 0)), attr)

        def ask(prompt, initial=""):
            """A one-line editor on the bottom line: Enter accepts, Esc cancels (None)."""
            curses.curs_set(1)
            buf, pos = list(initial), len(initial)
            while True:
                h, w = scr.getmaxyx()
                scr.move(h - 1, 0)
                scr.clrtoeol()
                text = prompt + "".join(buf)
                start = max(0, len(prompt) + pos - w + 2)
                put(h - 1, 0, text[start:], curses.A_BOLD)
                scr.move(h - 1, min(w - 1, len(prompt) + pos - start))
                ch = scr.get_wch()
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    curses.curs_set(0)
                    return "".join(buf).strip()
                if ch == "\x1b":
                    curses.curs_set(0)
                    return None
                if ch in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    if pos:
                        del buf[pos - 1]
                        pos -= 1
                elif ch == curses.KEY_DC:
                    if pos < len(buf):
                        del buf[pos]
                elif ch == curses.KEY_LEFT:
                    pos = max(0, pos - 1)
                elif ch == curses.KEY_RIGHT:
                    pos = min(len(buf), pos + 1)
                elif ch in (curses.KEY_HOME, "\x01"):
                    pos = 0
                elif ch in (curses.KEY_END, "\x05"):
                    pos = len(buf)
                elif ch == "\x15":  # ^U
                    buf, pos = [], 0
                elif isinstance(ch, str) and ch.isprintable():
                    buf.insert(pos, ch)
                    pos += 1

        def pick_category(current):
            options = [f"{i + 1 if i < 9 else '0-='[i - 9]} {c}" for i, c in enumerate(CATEGORIES)]
            h, w = scr.getmaxyx()
            line = "  ".join(options)
            scr.move(h - 1, 0)
            scr.clrtoeol()
            put(h - 1, 0, "Category: " + line + "  (Esc: cancel)", curses.A_BOLD)
            while True:
                ch = scr.get_wch()
                if ch in ("\x1b", "q"):
                    return None
                if not isinstance(ch, str):
                    continue
                if ch in "123456789":
                    return CATEGORIES[int(ch) - 1]
                if ch in "0-=":
                    return CATEGORIES[9 + "0-=".index(ch)]
                if ch in ("\n", "\r") and current in CATEGORIES:
                    return current

        def transfer(r, rename=False, recategorise=False):
            c = r["choice"] or r["suggestion"]
            cat, name = c if c and c != ("-", "-") else (None, None)
            if cat is None or recategorise:
                cat = pick_category(cat)
                if cat is None:
                    return
            if name is None or rename:
                guess = name or f"{r['sender']} - {r['file'].removesuffix('.pdf')}"
                name = ask("Name: ", guess)
                if not name:
                    return
            choose(r, (cat, safe(name, 90)))

        def draw(vis):
            scr.erase()
            h, w = scr.getmaxyx()
            list_h = max(3, h - 11)
            cur = state["cur"] = max(0, min(state["cur"], len(vis) - 1))
            if cur < state["top"]:
                state["top"] = cur
            if cur >= state["top"] + list_h:
                state["top"] = cur - list_h + 1
            n = {s: sum(status(r) == s for r in rows) for s in "✓·?"}
            head = (f" {n['✓']} to Nextcloud  {n['·']} left out  {n['?']} waiting  "
                    f"{len({m for m in deleted})} mail to delete   view: {views[state['view']]}"
                    + (f"   filter: {state['filter']}" if state["filter"] else "")
                    + f"   {cur + 1 if vis else 0}/{len(vis)}")
            put(0, 0, head.ljust(w), curses.A_REVERSE)
            for i, r in enumerate(vis[state["top"]:state["top"] + list_h]):
                y, s = i + 1, status(r)
                attr = {"✓": GREEN, "·": curses.A_DIM, "?": YELLOW}[s]
                if state["top"] + i == cur:
                    attr |= curses.A_REVERSE
                c = r["choice"] or r["suggestion"]
                cat = c[0] if c and c != ("-", "-") else ""
                name = c[1] if c and c != ("-", "-") else f"({r['sender']}: {r['file']})"
                if r["choice"] is None and c:  # only suggested: confirm with t, or x
                    name += "  (suggested, " + ("leave out" if c == ("-", "-") else "not confirmed") + ")"
                dele = "D" if deleted.intersection(r["mids"]) else " "
                put(y, 0, f"{s}{dele} {r['date']:%Y-%m-%d} {cat:<11.11} {name}".ljust(w), attr)
                if dele == "D":
                    put(y, 1, "D", attr | RED | curses.A_BOLD)
            if vis:
                r = vis[cur]
                y = list_h + 1
                put(y, 0, "─" * w, curses.A_DIM)
                put(y + 1, 0, f"From:    {r['from']}", CYAN)
                put(y + 2, 0, f"Subject: {r['subject']}")
                put(y + 3, 0, f"File:    {r['file']}    sha256:{key(r)}"
                    + (f"    in {len(r['mids'])} messages" if len(r["mids"]) > 1 else ""))
                for j, line in enumerate(preview(r)[:h - y - 6]):
                    put(y + 4 + j, 2, line, curses.A_DIM)
            help_ = ("j/k move  t transfer  x leave out  space toggle  c category  e rename  "
                     "d delete mail  o open  / filter  v view  T/X all shown  q quit")
            put(h - 1, 0, (state["msg"] or help_)[:w - 1], curses.A_BOLD if state["msg"] else curses.A_DIM)
            state["msg"] = ""
            scr.refresh()
            return list_h

        while True:
            vis = visible()
            list_h = draw(vis)
            ch = scr.get_wch()
            r = vis[state["cur"]] if vis else None
            if ch in ("q", "Q"):
                return
            elif ch in ("j", curses.KEY_DOWN):
                state["cur"] += 1
            elif ch in ("k", curses.KEY_UP):
                state["cur"] -= 1
            elif ch in (curses.KEY_NPAGE, "\x06"):
                state["cur"] += list_h
            elif ch in (curses.KEY_PPAGE, "\x02"):
                state["cur"] -= list_h
            elif ch in ("g", curses.KEY_HOME):
                state["cur"] = 0
            elif ch in ("G", curses.KEY_END):
                state["cur"] = len(vis) - 1
            elif ch == "v":
                state["view"] = (state["view"] + 1) % len(views)
                state["cur"] = state["top"] = 0
            elif ch == "/":
                f = ask("Filter: ", state["filter"])
                if f is not None:
                    state["filter"], state["cur"], state["top"] = f, 0, 0
            elif ch == "\x1b":
                state["filter"] = ""
            elif r is None:
                continue
            elif ch == "t":
                transfer(r)
                state["cur"] += 1
            elif ch == "x":
                choose(r, ("-", "-"))
                state["cur"] += 1
            elif ch == " ":
                if status(r) == "✓":
                    choose(r, ("-", "-"))
                else:
                    transfer(r)
            elif ch == "c":
                transfer(r, recategorise=True)
            elif ch in ("e", "r"):
                transfer(r, rename=True)
            elif ch == "d":
                set_deleted(r, not deleted.intersection(r["mids"]))
                state["cur"] += 1
            elif ch == "o":
                subprocess.Popen(["xdg-open", str(pdf_file(r))], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
            elif ch in ("T", "X"):
                what = "to Nextcloud, as named or suggested" if ch == "T" else "left out"
                named = lambda x: x["choice"] or x["suggestion"]
                todo = [x for x in vis if ch == "X" or named(x) not in (None, ("-", "-"))]
                if ch == "T" and len(todo) < len(vis):
                    what += f" ({len(vis) - len(todo)} with no name skipped)"
                if ask(f"All {len(todo)} shown {what}? [y/N] ") in ("y", "Y"):
                    for x in todo:
                        x["choice"] = ("-", "-") if ch == "X" else named(x)
                        chosen[key(x)] = x["choice"]
                    review_save(chosen)
                    state["msg"] = f"{len(todo)} changed"

    try:
        curses.wrapper(run)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    left = sum(r["choice"] is None for r in rows)
    print(f"deck-mail: review: choices are in {ARCHIVE_NAMES}"
          + (f"; {left} PDFs still wait for a decision" if left else "")
          + ". deck-mail archive --dry-run shows what will go; sync sends it and deletes the mail.")
    return 0


def refresh_waiting():
    """`pdf-waiting` on the mail whose PDFs still wait, after a choice in review or mmm."""
    rows, _ = review_load()
    seen = archive_seen()
    mark_waiting({m for r in rows if r["choice"] is None and r["digest"] not in seen
                  for m in r["mids"]})


def pdfs(mids):
    """For mmm: each PDF of these messages as JSON: its sha256, and its state, `sent` (with
    `where` in Nextcloud), `chosen` (goes at the next sync), `left out`, or `waiting`; the
    category and name chosen, or the ones suggested."""
    import hashlib
    names, seen, out = archive_names(), archive_seen(), []
    shown = subprocess.run(["notmuch", "show", "--format=json", "--body=false", "--entire-thread=false",
                            "--exclude=false", " or ".join(nm_id(m) for m in mids)],
                           capture_output=True, text=True, check=True).stdout if mids else "[]"

    def walk(node):
        if isinstance(node, dict):
            yield node
        elif isinstance(node, list):
            for n in node:
                yield from walk(n)

    for m in walk(json.loads(shown)):
        files = m["filename"] if isinstance(m["filename"], list) else [m["filename"]]
        _, _, from_, _, found = mail_pdfs(files[0])
        tags = m.get("tags", [])
        for fname, data in found:
            digest = hashlib.sha256(data).hexdigest()
            choice = confirmed(names, digest)
            pdf = {"message": m["id"], "file": fname, "sha256": digest,
                   "suggested": suggested(names, from_, fname.removesuffix(".pdf"))}
            if seen.get(digest) not in (None, "-"):
                pdf.update(state="sent", where=seen[digest])
            elif seen.get(digest) == "-" or choice == ("-", "-") or "noarchive" in tags:
                pdf.update(state="left out")
            elif choice:
                pdf.update(state="chosen")
            else:
                pdf.update(state="waiting")
            if choice and choice != ("-", "-"):
                pdf.update(category=choice[0], name=choice[1])
            out.append(pdf)
    print(json.dumps({"categories": CATEGORIES, "pdfs": out}, ensure_ascii=False))
    return 0


def file_pdf(args):
    """`file SHA256 CATEGORY NAME`, `file SHA256 -` (leave out), `file SHA256 --forget`: the
    choice for one PDF, as review makes it. The next sync sends it."""
    if len(args) not in (2, 3) or len(args) == 2 and args[1] not in ("-", "--forget"):
        print("deck-mail file SHA256 CATEGORY NAME | SHA256 - | SHA256 --forget", file=sys.stderr)
        return 2
    digest = args[0].removeprefix("sha256:").lower()
    if not re.fullmatch(r"[0-9a-f]{16,64}", digest):
        print(f"deck-mail: file: not a sha256: {args[0]}", file=sys.stderr)
        return 2
    done = next((v for d, v in archive_seen().items() if d.startswith(digest)), None)
    if done is not None:
        print("deck-mail: file: already " + ("left out" if done == "-" else f"in Nextcloud: {done}"),
              file=sys.stderr)
        return 1
    chosen = review_overrides()
    key = digest[:16]
    if args[1] == "--forget":
        chosen.pop(key, None)
    elif args[1] == "-":
        chosen[key] = ("-", "-")
    else:
        category, name = safe(args[1], 40), safe(args[2], 90)
        chosen[key] = (category, name)
    review_save(chosen)
    refresh_waiting()
    return 0


def top(args):
    """Prints the most frequent senders, sender domains and subjects among the query's messages."""
    import collections
    import email.utils
    import re
    n = int(args.pop(0)) if args and args[0].isdigit() else 50
    out = subprocess.run(["notmuch", "show", "--format=json", "--body=false", "--entire-thread=false",
                          *(args or ["not", "tag:sent"])], capture_output=True, check=True).stdout

    def messages(x):
        if isinstance(x, dict):
            if "headers" in x:
                yield x
        elif isinstance(x, list):
            for y in x:
                yield from messages(y)

    counts = {k: collections.Counter() for k in ("senders", "sender domains", "subjects")}
    newest = {}
    for m in messages(json.loads(out)):
        h = m["headers"]
        addr = email.utils.parseaddr(h.get("From", ""))[1].lower()
        # Re:/Fwd: (and their German, Nordic forms) off, numbers as #: "Invoice 1234" and
        # "Invoice 1240" are one subject.
        subject = re.sub(r"^\s*((re|fwd?|aw|wg|sv)(\[\d+\])?:\s*)+", "", h.get("Subject", ""), flags=re.I)
        subject = re.sub(r"\d+", "#", " ".join(subject.split()))[:80]
        for kind, key in (("senders", f"from:{addr}"), ("sender domains", f"from:{addr.rpartition('@')[2]}"),
                          ("subjects", subject)):
            counts[kind][key] += 1
            newest[kind, key] = max(newest.get((kind, key), 0), m.get("timestamp", 0))
    for kind, c in counts.items():
        print(f"# the {n} most frequent {kind}: messages, newest (month), "
              + ("subject, numbers as #" if kind == "subjects" else "notmuch search"))
        for key, k in c.most_common(n):
            print(f"{k:6}  {time.strftime('%Y-%m', time.localtime(newest[kind, key]))}  {key}")
        print()
    return 0


# The screener and the filter: what new mail in the inbox gets, after notmuch new (its post-new
# hook runs `deck-mail filter`). Gmail never sees these tags; the inbox there stays as it was.
#
#   screener  the first mail from a sender you don't know: mmm's Screener tab, not its Inbox,
#             until `screener allow` (mmm's A) lets the sender in or `block` (B) bins them
#   suspect   something says it's spam: a failed DMARC, a lookalike of a domain you know,
#             bogofilter, or the language model if one is set up. Also in the Screener tab.
#   deleted   from a blocked sender: Gmail's Bin at the next sync
#
# A sender you know: someone you wrote to, an `allow` line in ~/.config/deck-mail/senders, or
# someone whose mail you kept from before the screener started (its start is in the state folder).
SENDERS = CONFIG / "deck-mail/senders"
SENDERS_EXAMPLE = """\
# deck-mail's screener: one rule a line, for an address or a whole @domain. On deck only.
#   allow  their new mail goes straight to the Inbox
#   block  their new mail goes to the Bin
# mmm's A and B write these lines; `deck-mail screener allow|block|forget ADDRESS` too.
"""
FILTER = CONFIG / "deck-mail/filter"
FILTER_EXAMPLE = """\
# deck-mail filter: an optional language model for mail the other checks can't decide on.
# Any OpenAI-compatible chat endpoint (llama.cpp's llama-server, ollama). On deck only.
# Mail goes to it: only point it at a machine of yours.
#llm-url    http://localhost:8080/v1/chat/completions
#llm-model  qwen3-8b
#llm-max    5            # at most this many mails a sync
"""
WORDLIST = STATE / "bogofilter"
FILTER_LOG = STATE / "filter.json"  # why each recent mail was screened or suspect, for mmm
TRAIN_EVERY = 86400
TRAIN_LIMIT = 4000  # mails of each kind
# Too little spam and bogofilter only guesses: no verdicts until it has learned from this many.
TRAIN_MIN = (50, 200)  # spam, other


def own_addresses():
    return {a["address"].lower() for a in accounts()}


def sender_rules():
    rules = {"allow": set(), "block": set()}
    if SENDERS.exists():
        for line in SENDERS.read_text().splitlines():
            line = line.split("#", 1)[0].split()
            if len(line) == 2 and line[0] in rules:
                rules[line[0]].add(line[1].lower())
    return rules


def rule_for(rules, addr):
    """allow, block or None: the address's own line first, then its domain's."""
    for key in (addr, "@" + addr.rpartition("@")[2]):
        for kind in ("block", "allow"):
            if key in rules[kind]:
                return kind
    return None


def screener_start():
    f = STATE / "screener-start"
    if not f.exists():
        STATE.mkdir(parents=True, exist_ok=True)
        f.write_text(f"{int(time.time())}\n")
    return int(f.read_text())


def addresses(output, query):
    out = subprocess.run(["notmuch", "address", "--format=json", f"--output={output}",
                          "--deduplicate=address", query], capture_output=True, text=True, check=True)
    return {x["address"].lower() for x in json.loads(out.stdout or "[]") if x.get("address")}


def known_senders():
    """Everyone you wrote to, and the senders of mail you kept from before the screener."""
    # The Date header is the sender's to write: mail the screener has seen doesn't count, however
    # old it says it is.
    return (addresses("recipients", "tag:sent")
            | addresses("sender", f"date:..@{screener_start()} and not tag:deleted and not tag:spam"
                                  " and not tag:new and not tag:screener and not tag:suspect"))


def base_domain(d):
    """The registrable part, near enough: example.co.uk, example.com."""
    parts = d.split(".")
    n = 3 if len(parts) >= 3 and len(parts[-1]) == 2 and len(parts[-2]) <= 3 else 2
    return ".".join(parts[-n:])


def one_edit(a, b):
    """True when a and b differ by one letter changed, added or removed."""
    if a == b or abs(len(a) - len(b)) > 1:
        return False
    if len(a) == len(b):
        return sum(x != y for x, y in zip(a, b)) == 1
    if len(a) > len(b):
        a, b = b, a
    i = 0
    while i < len(a) and a[i] == b[i]:
        i += 1
    return a[i:] == b[i + 1:]


def lookalike(domain, known_bases):
    """A known domain this one imitates: one letter off, or written in other scripts (xn--)."""
    base = base_domain(domain)
    if base in known_bases:
        return None
    if "xn--" in domain:
        return f"{domain} is written in another script (punycode)"
    for k in known_bases:
        if len(k) >= 6 and one_edit(base, k):
            return f"{base} looks like {k}"
    return None


def authentication(msg):
    """Why Gmail's own checks failed for this mail, or None (only mx.google.com's results)."""
    for h in msg.get_all("Authentication-Results") or []:
        h = " ".join(str(h).split())
        if not h.lower().startswith("mx.google.com"):
            continue
        r = dict(re.findall(r"\b(spf|dkim|dmarc)=(\w+)", h.lower()))
        if r.get("dmarc") == "fail":
            return "DMARC failed (the sender's domain says it didn't send it)"
        if r.get("spf") in ("fail", "softfail") and r.get("dkim") != "pass":
            return f"SPF {r['spf']} and no DKIM signature that passed"
    return None


def message_file(mid):
    out = subprocess.run(["notmuch", "search", "--exclude=false", "--output=files", "--duplicate=1",
                          nm_id(mid)], capture_output=True, text=True, check=True).stdout.split("\n")
    return out[0] if out and out[0] else None


def read_message(path):
    import email
    import email.policy
    with open(path, "rb") as f:
        return email.message_from_binary_file(f, policy=email.policy.default)


def bogofilter(path):
    """bogofilter's verdict, S (spam), H or U (unsure), and its score; None until it has learned."""
    counts = WORDLIST / "counts"
    if not counts.exists() or not shutil.which("bogofilter"):
        return None
    spam, ham = map(int, counts.read_text().split())
    if spam < TRAIN_MIN[0] or ham < TRAIN_MIN[1]:
        return None
    r = subprocess.run(["bogofilter", "-d", str(WORDLIST), "-T", "-I", path],
                       capture_output=True, text=True)
    parts = r.stdout.split()
    return (parts[0], float(parts[1])) if len(parts) >= 2 else None


def filter_config():
    conf = {}
    if FILTER.exists():
        for line in FILTER.read_text().splitlines():
            line = line.split("#", 1)[0].split(None, 1)
            if len(line) == 2:
                conf[line[0]] = line[1].strip()
    return conf


def plain_text(msg, limit=3000):
    body = msg.get_body(preferencelist=("plain", "html"))
    try:
        text = body.get_content() if body else ""
    except (LookupError, ValueError):
        text = ""
    if body is not None and body.get_content_type() == "text/html":
        text = re.sub(r"<(style|script)\b.*?</\1>", " ", text, flags=re.S | re.I)
        text = re.sub(r"<[^>]+>", " ", text)
    return " ".join(text.split())[:limit]


def ask_model(conf, msg, sender):
    """The language model's verdict: (spam?, its reason), or None when it can't say."""
    import urllib.request
    prompt = ("Is this email spam, phishing or a scam? Cold sales outreach counts as spam. "
              "Newsletters and notifications the recipient signed up for do not. Answer with "
              "SPAM or OK, then a short reason, on one line.\n\n"
              f"From: {msg.get('From', '')}\nSubject: {msg.get('Subject', '')}\n\n{plain_text(msg)}")
    body = json.dumps({"model": conf.get("llm-model", ""), "temperature": 0,
                       "messages": [{"role": "user", "content": prompt}]}).encode()
    req = urllib.request.Request(conf["llm-url"], body, {"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            answer = json.load(r)["choices"][0]["message"]["content"]
    except (OSError, ValueError, KeyError, IndexError) as e:
        print(f"deck-mail: filter: the language model didn't answer: {e}", file=sys.stderr)
        return None
    answer = re.sub(r"<think>.*?</think>", "", answer, flags=re.S).strip()
    word = answer.split(None, 1)[0].strip(".:,").upper() if answer else ""
    if word not in ("SPAM", "OK"):
        return None
    return word == "SPAM", answer.split(None, 1)[1].strip() if " " in answer else ""


def filter_log(update=None):
    log = json.loads(FILTER_LOG.read_text()) if FILTER_LOG.exists() else {}
    if update:
        log.update(update)
        cut = time.time() - 90 * 86400
        log = {k: v for k, v in log.items() if v.get("time", 0) > cut}
        STATE.mkdir(parents=True, exist_ok=True)
        tmp = FILTER_LOG.with_suffix(".tmp")
        tmp.write_text(json.dumps(log, indent=1))
        os.replace(tmp, FILTER_LOG)
    return log


def filter_new(query="tag:new and tag:inbox and not tag:sent and not tag:draft"):
    """Screens new inbox mail and looks for spam in it; tags as the comment above says."""
    import email.utils
    ids = pending(f"({query}) and not tag:deleted and not tag:spam")
    if not ids:
        return 0
    own = own_addresses()
    rules = sender_rules()
    known = known_senders()
    known_bases = {base_domain(a.rpartition("@")[2]) for a in known | own}
    conf = filter_config()
    asked = 0
    batch, log = [], {}
    for mid in ids:
        path = message_file(mid)
        if not path:
            continue
        msg = read_message(path)
        addr = email.utils.parseaddr(str(msg.get("From", "")))[1].lower()
        if not addr or addr in own:
            continue
        domain = addr.rpartition("@")[2]
        rule = rule_for(rules, addr)
        if rule == "block":
            batch.append(f"+deleted -- {nm_id(mid)}")
            log[mid] = {"time": time.time(), "sender": addr, "blocked": True, "reasons": []}
            continue
        new_sender = rule != "allow" and addr not in known
        reasons = [r for r in (authentication(msg), lookalike(domain, known_bases)) if r]
        verdict = bogofilter(path)
        if verdict and verdict[0] == "S":
            reasons.append(f"bogofilter: spam ({verdict[1]:.2f})")
        unsure = verdict is None or verdict[0] == "U"
        if (not reasons and new_sender and unsure and conf.get("llm-url")
                and asked < int(conf.get("llm-max", 5))):
            asked += 1
            answer = ask_model(conf, msg, addr)
            if answer and answer[0]:
                reasons.append(f"language model: {answer[1] or 'spam'}")
        if new_sender:
            batch.append(f"+screener -- {nm_id(mid)}")
        if reasons:
            batch.append(f"+suspect -- {nm_id(mid)}")
        if new_sender or reasons:
            log[mid] = {"time": time.time(), "sender": addr, "new-sender": new_sender,
                        "reasons": reasons}
    if batch:
        subprocess.run(["notmuch", "tag", "--batch"], input="\n".join(batch) + "\n", text=True,
                       check=True)
    if log:
        filter_log(log)
        print(f"deck-mail: filter: {sum(v.get('new-sender', False) for v in log.values())} from new "
              f"senders, {sum(bool(v['reasons']) for v in log.values())} suspect, "
              f"{sum(v.get('blocked', False) for v in log.values())} blocked")
    return 0


def train(force=False):
    """Teaches bogofilter again, from scratch: spam is what you or Gmail called spam; the rest is
    mail you kept (not deleted, not screened or suspect, not your own). Once a day from sync."""
    stamp = WORDLIST / "counts"
    if not shutil.which("bogofilter"):
        print("deck-mail: filter: bogofilter isn't installed (mail-filter/bogofilter)", file=sys.stderr)
        return 1
    if not force and stamp.exists() and time.time() - stamp.stat().st_mtime < TRAIN_EVERY:
        return 0

    def files(query):
        out = subprocess.run(["notmuch", "search", "--exclude=false", "--output=files", "--duplicate=1",
                              "--sort=newest-first", f"--limit={TRAIN_LIMIT}", query],
                             capture_output=True, text=True, check=True).stdout
        return [f for f in out.split("\n") if f]

    spam = files("tag:spam")
    ham = files("not tag:spam and not tag:deleted and not tag:screener and not tag:suspect"
                " and not tag:sent and not tag:draft")
    tmp = WORDLIST.with_name("bogofilter.new")
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    for flag, group in (("-s", spam), ("-n", ham)):
        for i in range(0, len(group), 500):
            subprocess.run(["bogofilter", "-d", str(tmp), flag, "-B", *group[i:i + 500]],
                           check=True, capture_output=True)
    (tmp / "counts").write_text(f"{len(spam)} {len(ham)}\n")
    old = WORDLIST.with_name("bogofilter.old")
    shutil.rmtree(old, ignore_errors=True)
    if WORDLIST.exists():
        WORDLIST.rename(old)
    tmp.rename(WORDLIST)
    shutil.rmtree(old, ignore_errors=True)
    ready = len(spam) >= TRAIN_MIN[0] and len(ham) >= TRAIN_MIN[1]
    print(f"deck-mail: filter: bogofilter learned from {len(spam)} spam and {len(ham)} other mails"
          + ("" if ready else f"; it gives verdicts from {TRAIN_MIN[0]} spam and {TRAIN_MIN[1]} other"))
    return 0


def screener(args):
    """`screener allow|block|forget ADDRESS`: the sender's line in the senders file, and their mail
    tagged to match. Prints what it tagged as JSON ([change, [ids]] pairs), for mmm's undo."""
    if len(args) != 2 or args[0] not in ("allow", "block", "forget") or "@" not in args[1] \
            or re.search(r'[\s"()]', args[1]):
        sys.exit("deck-mail: screener allow|block|forget ADDRESS|@DOMAIN")
    kind, who = args[0], args[1].lower()
    lines = SENDERS.read_text().splitlines() if SENDERS.exists() else SENDERS_EXAMPLE.splitlines()
    lines = [l for l in lines if l.split("#", 1)[0].split()[1:2] != [who]]
    if kind != "forget":
        lines.append(f"{kind} {who}")
    SENDERS.parent.mkdir(parents=True, exist_ok=True)
    SENDERS.write_text("\n".join(lines) + "\n")
    q = f"from:{who.lstrip('@')}" if who.startswith("@") else f"from:{who}"
    changes = []
    if kind == "allow":
        changes = [("-screener", f"{q} and tag:screener"), ("-suspect", f"{q} and tag:suspect")]
    elif kind == "block":
        changes = [("+deleted", f"{q} and tag:inbox and not tag:deleted")]
    done = []
    for change, query in changes:
        ids = pending(query)
        if ids:
            subprocess.run(["notmuch", "tag", "--batch"], text=True, check=True,
                           input="".join(f"{change} -- {nm_id(m)}\n" for m in ids))
        done.append([change, ids])
    print(json.dumps(done))
    return 0


def why(mids):
    """mmm's view of why these messages were screened or are suspect, as JSON."""
    log = filter_log()
    rules = sender_rules()
    out = []
    for mid in mids:
        e = log.get(mid)
        if e:
            out.append({"message": mid, "sender": e.get("sender", ""),
                        "new-sender": e.get("new-sender", False), "reasons": e.get("reasons", []),
                        "rule": rule_for(rules, e.get("sender", ""))})
    print(json.dumps(out))
    return 0


def unsubscribe(args):
    """`unsubscribe [--check] ID`: how the mail's List-Unsubscribe header lets you leave the list,
    as JSON: one-click (RFC 8058, an HTTPS POST that deck-mail makes without --check), mailto (a
    mail to write), link (a page to open) or none."""
    import urllib.parse
    import urllib.request
    check = "--check" in args
    args = [a for a in args if a != "--check"]
    if len(args) != 1:
        sys.exit("deck-mail: unsubscribe [--check] MESSAGE-ID")
    path = message_file(args[0])
    if not path:
        sys.exit(f"deck-mail: no message {args[0]}")
    msg = read_message(path)
    targets = re.findall(r"<([^>]+)>", " ".join(str(msg.get("List-Unsubscribe", "")).split()))
    one_click = "list-unsubscribe=one-click" in str(msg.get("List-Unsubscribe-Post", "")).lower()
    https = [t for t in targets if t.lower().startswith("https://")]
    mailto = [t for t in targets if t.lower().startswith("mailto:")]
    if https and one_click:
        info = {"method": "one-click", "target": https[0]}
    elif mailto:
        m = urllib.parse.urlsplit(mailto[0])
        q = urllib.parse.parse_qs(m.query)
        info = {"method": "mailto", "target": urllib.parse.unquote(m.path),
                "subject": q.get("subject", ["unsubscribe"])[0], "body": q.get("body", [""])[0]}
    elif https:
        info = {"method": "link", "target": https[0]}
    else:
        info = {"method": "none", "target": ""}
    info["host"] = urllib.parse.urlsplit(info["target"]).hostname or info["target"].rpartition("@")[2]
    info["sender"] = str(msg.get("From", ""))
    if check or info["method"] != "one-click":
        print(json.dumps(info))
        return 0
    req = urllib.request.Request(info["target"], b"List-Unsubscribe=One-Click", method="POST",
                                 headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            info["status"] = r.status
    except urllib.error.HTTPError as e:
        info["status"] = e.code
    except OSError as e:
        sys.exit(f"deck-mail: unsubscribing at {info['host']} failed: {e}")
    with open(STATE / "unsubscribed.log", "a") as f:
        f.write(f"{time.strftime('%F %T')}\t{info['status']}\t{info['sender']}\t{info['host']}\n")
    if not 200 <= info["status"] < 300:
        sys.exit(f"deck-mail: {info['host']} answered {info['status']}")
    print(json.dumps(info))
    return 0


def main():
    cmd = sys.argv[1:]
    if cmd == ["config"]:
        return config()
    if cmd == ["sync"]:
        return sync(sys.stdin.isatty())
    if cmd[:1] == ["send"]:  # mmm gives the recipients as arguments, the mail on stdin
        # Addresses come from mail: after --, so none is an msmtp option (--passwordeval,
        # --host), and none with whitespace, which msmtpq's queue splits when it sends later.
        bad = [a for a in cmd[1:] if a.startswith("-") or re.search(r"[\s\x00-\x1f\x7f]", a)]
        if bad:
            sys.exit(f"deck-mail send: not an address: {bad[0]!r}")
        os.execve(f"{MSMTPQ}/msmtpq", ["msmtpq", "--read-envelope-from", "--", *cmd[1:]],
                  dict(os.environ, **QUEUE_ENV))
    if cmd == ["unlock"]:
        return 0 if unlocked(accounts(), True) else 1
    if cmd[:1] == ["archive"]:
        if not ARCHIVE.exists():
            ARCHIVE.write_text(ARCHIVE_EXAMPLE)
            print(f"deck-mail: wrote an example {ARCHIVE}: fill it in, then deck-mail archive --dry-run")
            return 1
        limit = int(cmd[cmd.index("--limit") + 1]) if "--limit" in cmd else None
        return archive(dry_run="--dry-run" in cmd, limit=limit)
    if cmd == ["review"]:
        r = review()
        refresh_waiting()
        return r
    if cmd[:1] == ["pdfs"]:
        return pdfs(cmd[1:])
    if cmd[:1] == ["file"]:
        return file_pdf(cmd[1:])
    if cmd[:1] == ["top"]:
        return top(cmd[1:])
    if cmd == ["filter"]:
        return filter_new()
    if cmd[:2] == ["filter", "--query"] and len(cmd) == 3:
        return filter_new(cmd[2])
    if cmd == ["filter", "--train"]:
        return train(force=True)
    if cmd[:1] == ["screener"]:
        return screener(cmd[1:])
    if cmd[:1] == ["why"]:
        return why(cmd[1:])
    if cmd[:1] == ["unsubscribe"]:
        return unsubscribe(cmd[1:])
    print(__doc__.split("\n\n", 2)[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
