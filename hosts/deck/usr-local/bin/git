#!/bin/bash
# git, guarded: in ~/src (and the work roots in ~/.config/jail/roots, as jail has them), host git only
# runs when the repository's git configuration and hooks are
# as they were when you last used git there. Everything else is /usr/bin/git, unchanged.
#
# Why: jailed programs (/usr/local/bin/jail) write ~/src. A repository's own config can make git
# run commands (core.fsmonitor, core.sshCommand, diff.external, filter drivers, hooks...), and a
# jailed program can always reach it: a new repository, a renamed .git, .git/commondir, a
# submodule's config, a change to tracked hooks. Mounts can't close all of that, so the host checks
# before git runs: the repository's own config (with what it includes), the hooks git would run, and
# the git directory's layout. Changed (or never seen): git refuses and shows what changed.
#
#   git trust [DIR...]   accept the current state of the repository (in DIR, default here), after
#                        a look at what it shows; --all: every repository in the work roots
#
# Git commands that can change the config themselves (config, remote, branch, push, init, clone,
# submodule, worktree, switch, checkout) record the state afterwards: what you do with host git
# is trusted. In the jail ($JAIL) this is plain git: the jail is what it guards against.
#
# The check is a stat of the relevant files, compared with the last one; only when that differs is
# the state rebuilt and compared, in ~/.local/state/git-guard.
set -uo pipefail

real=/usr/bin/git
[[ -n ${JAIL-} ]] && exec "$real" "$@"
# No home, no ~/src to guard: system services (gentoo-sync runs git in /var/db/repos as root).
[[ -n ${HOME-} ]] || exec "$real" "$@"
src=$HOME/src
# Work roots: ~/src, and the directories ~/.config/jail/roots lists (one per line, relative to the
# home or absolute, inside the home), treated the same: writable in the jail, their repositories
# protected, host git guarded there. The jail never sees ~/.config, so it can't add one.
roots=("$HOME/src")
if [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/jail/roots ]]; then
	while read -r r; do
		[[ -z $r || $r == '#'* ]] && continue
		[[ $r == /* ]] || r=$HOME/$r
		r=$(realpath -m -- "$r")
		[[ -d $r && $r/ == "$HOME"/?* && $r != "$HOME" ]] && roots+=("$r")
	done <"${XDG_CONFIG_HOME:-$HOME/.config}/jail/roots"
fi
in_roots() { # PATH: inside one of the roots? Prints which.
	local r
	for r in "${roots[@]}"; do [[ $1/ == "$r"/* ]] && { printf '%s' "$r"; return 0; }; done
	return 1
}
store=${XDG_STATE_HOME:-$HOME/.local/state}/git-guard

# The directory git will work in, from the leading -C options (git's own order), and the
# subcommand: the first argument that isn't a global option.
dir=$PWD sub= gitdir_opt=${GIT_DIR-}
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
	a=${args[i]}
	case $a in
	-C) ((i++)); d=${args[i]-}; [[ $d = /* ]] && dir=$d || dir=$dir/$d ;;
	-c | --exec-path | --namespace | --config-env | --super-prefix) ((i++)) ;;
	--git-dir) ((i++)); gitdir_opt=${args[i]-} ;;
	--git-dir=*) gitdir_opt=${a#--git-dir=} ;;
	--work-tree) ((i++)) ;;
	-*) ;;
	*) sub=$a; break ;;
	esac
done

# The worktree and git directory for a directory, found the way git finds them (upwards, a .git
# directory or a "gitdir:" file); nothing when it isn't a repository.
locate() {
	local d
	d=$(realpath -m -- "$1") || return 1
	while :; do
		if [[ -d $d/.git ]]; then
			wt=$d gd=$d/.git
			return 0
		elif [[ -f $d/.git ]]; then
			local line
			line=$(head -c 4096 "$d/.git")
			line=${line#gitdir: }
			[[ $line = /* ]] || line=$d/$line
			wt=$d gd=$(realpath -m -- "$line")
			return 0
		fi
		[[ $d = / ]] && return 1
		d=${d%/*}
		[[ -z $d ]] && d=/
	done
}

# Files whose change means the state must be checked again: inode, size and change time (ctime,
# with nanoseconds) each. Not the modification time: anyone who can write a file can set that back.
# The ctime only the kernel sets.
stamp() {
	local files=("$wt/.git" "$gd/config" "$gd/config.worktree" "$gd/commondir" "$gd/hooks"
		"$gd/modules" "$gd/worktrees")
	local f
	while IFS= read -r f; do files+=("$f"); done < <(extra_files)
	stat -L -c '%n %i %s %z' -- "${files[@]}" 2>&1 | sort
}

# What the last full check found worth watching: the hooks directory and its files, included
# config files, submodules' config.
extra_files() {
	[[ -f $record.files ]] && cat -- "$record.files"
}

# The state itself: everything in it that can make git run something.
state() {
	local common=$gd hooks f
	echo "worktree $wt"
	echo "gitdir $gd"
	[[ -f $wt/.git ]] && echo "gitfile $(head -c 4096 "$wt/.git")"
	if [[ -f $gd/commondir ]]; then
		echo "commondir $(head -c 4096 "$gd/commondir")"
		common=$(realpath -m -- "$gd/$(head -n1 "$gd/commondir")")
	fi
	# The repository's own config as git reads it, includes followed, with where each line is from.
	"$real" --git-dir="$gd" config --list --show-origin --includes --local 2>&1
	[[ -f $gd/config.worktree ]] && "$real" -C / config --file "$gd/config.worktree" --list --show-origin --includes 2>&1
	# Without what the caller sets for itself (git -c, which reaches child gits as
	# GIT_CONFIG_PARAMETERS, or GIT_CONFIG_COUNT): a program running git with hooks off recorded
	# "hooks /dev/null" as the repository's, and then every plain git looked like a change.
	hooks=$(env -u GIT_CONFIG_PARAMETERS -u GIT_CONFIG_COUNT -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_SYSTEM \
		-u GIT_CONFIG_NOSYSTEM "$real" --git-dir="$gd" config --get core.hooksPath 2>/dev/null) || hooks=$common/hooks
	[[ $hooks = /* ]] || hooks=$wt/$hooks
	echo "hooks $hooks"
	{
		[[ -d $hooks ]] && echo "$hooks"
		find "$hooks" -maxdepth 1 \( -type f -o -type l \) ! -name '*.sample' 2>/dev/null
		# Submodules' and other worktrees' own config and hooks, and their directories: a file added
		# to one (a submodule's new hook) changes its ctime, which the stamp sees. Not the object and
		# ref stores, which change all the time.
		find "$common/modules" "$common/worktrees" \( -name config -o -name config.worktree -o -name commondir \
			-o -path '*/hooks/*' \) ! -name '*.sample' \( -type f -o -type l \) 2>/dev/null
		find "$common/modules" "$common/worktrees" -type d \( -name objects -o -name refs -o -name logs -o -name lfs \
			-o -name info \) -prune -o -type d -print 2>/dev/null
		# Files the config includes.
		"$real" --git-dir="$gd" config --list --show-origin --includes --local 2>/dev/null |
			sed -n 's/^file:\([^	]*\)	.*/\1/p' | sort -u
	} | sort -u >"$record.files.$$"
	while IFS= read -r f; do
		[[ -L $f ]] && echo "link $f -> $(readlink -- "$f")"
		if [[ -d $f ]]; then
			echo "dir $f"
		else
			echo "file $f $(stat -L -c %a -- "$f" 2>/dev/null) $(sha256sum <"$f" 2>/dev/null | cut -c1-64)"
		fi
	done <"$record.files.$$"
}

save() {
	mkdir -p -- "$store"
	state >"$record.state.$$"
	mv -- "$record.files.$$" "$record.files"
	mv -- "$record.state.$$" "$record.state"
	stamp >"$record.stamp"
}

# Sets wt, gd and record for a directory; false when it isn't a repository in a work root.
guarded() {
	if [[ -n $gitdir_opt ]]; then
		gd=$(realpath -m -- "$gitdir_opt") wt=${gd%/.git}
	else
		locate "$1" || return 1
	fi
	in_roots "$wt" >/dev/null || in_roots "$gd" >/dev/null || return 1
	record=$store/$(printf '%s' "$gd" | sha256sum | cut -c1-32)
	# Work files of this git's own (.$$): two gits at once writing one file saved a hook list cut short.
	trap 'rm -f -- "$record.files.$$" "$record.state.$$"' EXIT
}

trust() {
	local dirs=("$@") d
	if [[ ${dirs[0]-} = --all ]]; then
		mapfile -t dirs < <(find "${roots[@]}" -mindepth 2 -maxdepth 4 -name .git -prune -printf '%h\n' 2>/dev/null)
	fi
	((${#dirs[@]})) || dirs=("$dir") # -C DIR trust, as the refusal suggests
	for d in "${dirs[@]}"; do
		gitdir_opt=
		guarded "$d" || { echo "git trust: $d is not a repository in ~/src or a work root" >&2; continue; }
		mkdir -p -- "$store"
		if [[ -f $record.state ]]; then
			state | diff -u --label "trusted" --label "now" -- "$record.state" - && { echo "git trust: ${wt#"$HOME"/}: unchanged"; rm -f -- "$record.files.$$"; continue; }
		else
			echo "git trust: ${wt#"$HOME"/}: first time"
			# The settings that make git run something, if it has any; and its hooks.
			state | grep -E -i '^file:[^	]*	[^=]*(fsmonitor|sshcommand|hookspath|\.cmd|\.clean|\.smudge|\.process|external|editor|pager|askpass|program|helper|textconv|include)[^=]*=|^file [^ ]*hooks/' | sed 's/^/  /'
			rm -f -- "$record.files.$$"
		fi
		save
		echo "git trust: ${wt#"$HOME"/}: trusted"
	done
}

if [[ $sub = trust ]]; then
	shift $((i + 1))
	trust "$@"
	exit
fi

# A new repository made by host git is trusted as it comes out.
if [[ $sub = clone || $sub = init ]]; then
	"$real" "$@"
	rc=$?
	((rc == 0)) || exit "$rc"
	pos=()
	for a in "${args[@]:i+1}"; do [[ $a = -* ]] || pos+=("$a"); done
	# (${pos[-1]} is an error on an empty array, default or not.)
	if [[ $sub = init ]]; then
		target=.
		((${#pos[@]})) && target=${pos[-1]}
	elif ((${#pos[@]} == 1)); then
		# Only the URL: git names the directory after its last part.
		target=${pos[0]%/}; target=${target##*[/:]}; target=${target%.git}
	else
		target=
		((${#pos[@]})) && target=${pos[-1]}
	fi
	[[ $target = /* ]] || target=$dir/$target
	gitdir_opt=
	guarded "$target" && save
	exit 0
fi

guarded "$dir" || exec "$real" "$@"

# What git reads must be plain files: a FIFO, a device or a socket would hang or feed git.
for f in "$gd/config" "$gd/config.worktree" "$gd/commondir" "$wt/.git"; do
	if [[ -e $f && ! -f $f && ! -d $f ]]; then
		echo "git: ${wt#"$HOME"/}: $f is not a plain file; look at it (a jailed program may have made it)" >&2
		exit 128
	fi
done

if [[ -f $record.stamp ]] && [[ $(stamp) == "$(cat -- "$record.stamp")" ]]; then
	:
elif [[ -f $record.state ]] && state | cmp -s -- "$record.state" -; then
	mv -- "$record.files.$$" "$record.files"
	stamp >"$record.stamp"
else
	{
		if [[ -f $record.state ]]; then
			echo "git: ${wt#"$HOME"/}: its git config, hooks or layout changed since you last used git there:"
			state | diff -u --label "trusted" --label "now" -- "$record.state" - | head -40
		else
			echo "git: ${wt#"$HOME"/}: a repository host git hasn't seen before."
		fi
		rm -f -- "$record.files.$$"
		echo "Look at it (a jailed program may have changed it), then: git -C '$wt' trust"
	} >&2
	exit 128
fi

case $sub in
config | remote | branch | push | submodule | worktree | switch | checkout) ;;
*) exec "$real" "$@" ;;
esac

# A command that may change the config: run it, then record what host git left.
"$real" "$@"
rc=$?
((rc == 0)) && save
exit "$rc"
