gmime: groups hold mailboxes, not groups

RFC 5322, 3.4: a group's list is a mailbox-list. Parse only mailboxes
inside a group.

--- a/gmime/internet-address.c
+++ b/gmime/internet-address.c
@@ -2100,7 +2100,8 @@
 		
 		charset = NULL;
 		
-		if (!address_parse (options, ALLOW_ANY, &inptr, &charset, &address, offset)) {
+		/* RFC 5322: a group holds mailboxes, not groups */
+		if (!address_parse (options, is_group ? ALLOW_MAILBOX : ALLOW_ANY, &inptr, &charset, &address, offset)) {
 			/* skip this address... */
 			while (*inptr && *inptr != ',' && (!is_group || *inptr != ';'))
 				inptr++;
