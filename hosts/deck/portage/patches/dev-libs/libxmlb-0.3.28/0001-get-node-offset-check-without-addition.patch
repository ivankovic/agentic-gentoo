xb-silo: compare the node offset without arithmetic

xb_silo_get_node() checks the offset with off >= strtab again, as before
0.3.28: off + 1 is computed in a guint32, so the comparison holds for
every value only in the form without the addition.

--- a/src/xb-silo.c
+++ b/src/xb-silo.c
@@ -226,7 +226,7 @@
 xb_silo_get_node(XbSilo *self, guint32 off, GError **error)
 {
 	XbSiloPrivate *priv = GET_PRIVATE(self);
-	if (G_UNLIKELY(off + 1 > priv->strtab)) {
+	if (G_UNLIKELY(off >= priv->strtab)) {
 		g_set_error(error,
 			    G_IO_ERROR,
 			    G_IO_ERROR_INVALID_DATA,
