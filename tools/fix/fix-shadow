#!/usr/bin/env python3
"""fix-shadow: would the local sysadmin model have done what the main agent did?

    fix-shadow run [--model URL | --serve GGUF] [--source NAME] [--days N] [--limit N]
    fix-shadow report [--days N] [--show N]

`run` reads the main agent's recent sessions, picks its sysadmin commands, and asks the local
model, at the same point of each session (the user's request and the commands and outputs before
it), for the next command; it records both and how close they are. `report` sums that up and shows
where they differ.

The main agent is whatever writes the sessions: a source turns its log format into a neutral trace
(user text, commands with their output), so another agent only needs another source. The local
model is any OpenAI-compatible chat server with tool calls (llama-server --jinja); --serve starts
llama-server on a GGUF for the run and stops it after.

This only measures. The main agent's sessions are not training data: its provider's terms may not
allow that, and the measure is only honest while the model has not seen them.

Results: $XDG_STATE_HOME/fix/shadow.jsonl (default ~/.local/state/fix/shadow.jsonl), one line per
command; commands already there are skipped. A command the server failed on (an HTTP error, a
prompt too long for its context) is not a comparison: it goes to shadow-errors.jsonl next to the
results and is asked again on later runs, three times at most.
"""
import argparse
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

# clip and post are the drills' (tools/drills/modelchat.py): installed beside this script's Python
# modules, or next door in a checkout.
if (_drills := Path(__file__).resolve().parent.parent / "drills" / "modelchat.py").is_file():
    sys.path.insert(0, str(_drills.parent))
from modelchat import clip, post  # noqa: E402

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "fix"
RESULTS = STATE / "shadow.jsonl"
ERRORS = STATE / "shadow-errors.jsonl"
MAX_ATTEMPTS = 3     # times a command is asked before the server's errors on it are final

# Commands that administer a system, as opposed to editing code or reading files.
SYSADMIN = frozenset("""sudo doas systemctl journalctl emerge eselect equery eix qlist
    qdepends portageq emaint dispatch-conf etc-update dmesg mount umount findmnt lsblk blkid fdisk
    sfdisk parted mkfs fsck btrfs cryptsetup zramctl swapon ip ss ping nmcli networkctl
    resolvectl iw useradd usermod userdel groupadd gpasswd passwd chage chown chmod chgrp df du ps
    pgrep pkill kill killall lsof fuser dracut bootctl ukify efibootmgr kernel-install modprobe
    lsmod sysctl udevadm smartctl nvme sensors loginctl timedatectl hostnamectl localectl
    coredumpctl fwupdmgr crontab visudo getent ssh rsync docker podman""".split())
# Words before the program that are not it: `env A=b nice -n 5 emerge`, `if ! systemctl ...; then`.
PREFIXES = frozenset("env time nice ionice nohup setsid exec command builtin timeout if then else elif do while "
                     "until ! {".split())
SHELLS = frozenset("sh bash dash zsh".split())
OPERATORS = "();<>|&\n"
# A here-document's text, up to the line that ends it: input, not commands.
HEREDOC = re.compile(r"(?<!<)<<-?\s*(['\"]?)([A-Za-z_]\w*)\1([^\n]*)\n.*?^\s*\2\s*$", re.S | re.M)


def programs(command):
    """The program of each simple command in a command line: the first word after `;`, `&&`,
    `||`, `|`, a newline or a parenthesis, past variable assignments and prefixes such as env or
    nice, without its directory. Words inside quotes and the text of here-documents are
    arguments, never programs, except the command line given to a shell (`bash -c '...'`), which
    is read the same way. A line the lexer cannot read to its end (an unclosed quote) gives the
    programs up to there."""
    lex = shlex.shlex(HEREDOC.sub(r"\3", command), posix=True, punctuation_chars=OPERATORS)
    lex.whitespace_split = True
    lex.whitespace = " \t\r"
    lex.commenters = ""
    found, first, prefixed, skip, last = [], True, False, False, ""
    try:
        for word in lex:
            if all(c in OPERATORS for c in word):
                if "<" in word or ">" in word:
                    skip = True              # a redirection: the next word is its file
                else:
                    first, prefixed, last = True, False, ""
                continue
            before, last = last, word
            if skip:
                skip = False
            elif before == "-c ":
                found += programs(word)      # the command line of sh -c
            elif word == "-c" and before.rsplit("/", 1)[-1] in SHELLS:
                last = "-c "
            elif first:
                if re.fullmatch(r"[A-Za-z_]\w*=.*", word) or word in PREFIXES:
                    prefixed = prefixed or word in PREFIXES
                elif prefixed and re.fullmatch(r"-.*|\d+[smhd]?", word):
                    pass                     # a prefix's own option or number: nice -n 5, timeout 30
                else:
                    found.append(word.rsplit("/", 1)[-1])
                    first = False
    except ValueError:
        pass
    return found


def sysadmin(command):
    """Whether a command line runs a sysadmin program. The program is what counts, not the text:
    `git commit -m "fix ip parsing"` is not one."""
    return any(p in SYSADMIN or p.startswith(("mkfs.", "fsck.")) for p in programs(command))

SYSTEM_PROMPT = """\
You are the system administrator's assistant on a Gentoo Linux machine (systemd, Portage). You see \
what the user asked and the commands run so far with their output. Decide the single next command \
to run and call the `run` tool with it. Find the cause before changing anything, make the smallest \
change that fixes it, and never delete data you were not asked to delete."""

TOOLS = [{
    "type": "function",
    "function": {
        "name": "run",
        "description": "Run a shell command and return its output and exit code.",
        "parameters": {
            "type": "object",
            "properties": {"command": {"type": "string", "description": "a bash command line"}},
            "required": ["command"],
        },
    },
}]

HISTORY = 8          # earlier commands shown with each question
OUTPUT_LIMIT = 1500  # characters of each earlier output: the head and the tail
TEXT_LIMIT = 2000    # characters of the user's messages




# Sources: each yields sessions as (session id, [event]), an event being
#   {"kind": "user", "text": ...} or
#   {"kind": "command", "id": ..., "command": ..., "output": ..., "time": ...}

def claude_code(days):
    """Claude Code: ~/.claude/projects/<project>/<session>.jsonl."""
    since = time.time() - days * 86400
    for path in sorted((Path.home() / ".claude/projects").glob("*/*.jsonl")):
        if path.stat().st_mtime < since:
            continue
        events, pending = [], {}
        for line in path.open(errors="replace"):
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            if e.get("isSidechain") or e.get("type") not in ("user", "assistant"):
                continue
            content = (e.get("message") or {}).get("content")
            if isinstance(content, str):
                if e["type"] == "user" and not content.startswith("<"):
                    events.append({"kind": "user", "text": content})
                continue
            for b in content or []:
                if b.get("type") == "text" and e["type"] == "user" and not b["text"].startswith("<"):
                    events.append({"kind": "user", "text": b["text"]})
                elif b.get("type") == "tool_use" and b.get("name") == "Bash":
                    ev = {"kind": "command", "id": b["id"], "command": b["input"].get("command", ""),
                          "output": "", "time": e.get("timestamp", "")}
                    pending[b["id"]] = ev
                    events.append(ev)
                elif b.get("type") == "tool_result" and b.get("tool_use_id") in pending:
                    out = b.get("content")
                    if isinstance(out, list):
                        out = "\n".join(x.get("text", "") for x in out if isinstance(x, dict))
                    pending.pop(b["tool_use_id"])["output"] = out or ""
        yield path.stem, events


SOURCES = {"claude-code": claude_code}


def questions(events):
    """Each sysadmin command with what came before it: the user's last messages, and the commands
    run since the last of them (the work on this request)."""
    for i, ev in enumerate(events):
        if ev["kind"] != "command" or not sysadmin(ev["command"]):
            continue
        before = events[:i]
        users = [n for n, e in enumerate(before) if e["kind"] == "user"]
        if not users:
            continue
        commands = [e for e in before[users[-1]:] if e["kind"] == "command"][-HISTORY:]
        yield ev, [before[n]["text"] for n in users[-3:]], commands


def messages(users, commands):
    msgs = [{"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": clip("\n\n".join(users), TEXT_LIMIT)}]
    for n, c in enumerate(commands):
        call = {"id": f"c{n}", "type": "function",
                "function": {"name": "run", "arguments": json.dumps({"command": c["command"]})}}
        msgs.append({"role": "assistant", "content": "", "tool_calls": [call]})
        msgs.append({"role": "tool", "tool_call_id": f"c{n}", "content": clip(c["output"], OUTPUT_LIMIT)})
    return msgs


class ServerError(Exception):
    """The server gave no answer to this question (an HTTP error, a timeout, a reply that is not
    a chat completion): nothing is known about what the model would have run."""




def ask(url, msgs):
    """(command, None), or (None, why) when the model named none; ServerError when the server
    failed. A server that cannot be reached at all raises URLError: that is not about this
    question, and ends the run."""
    body = {"messages": msgs, "tools": TOOLS, "temperature": 0.2, "max_tokens": 1024,
            "chat_template_kwargs": {"enable_thinking": False}}
    try:
        msg = post(url, body)["choices"][0]["message"]
    except urllib.error.HTTPError as e:
        raise ServerError(f"HTTP {e.code}: {e.read().decode(errors='replace')[:200]}") from None
    except TimeoutError:
        raise ServerError("no answer in time") from None
    except urllib.error.URLError as e:
        if isinstance(e.reason, TimeoutError):
            raise ServerError("no answer in time") from None
        raise
    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as e:
        raise ServerError(f"not a chat completion: {type(e).__name__}: {e}") from None
    for call in msg.get("tool_calls") or []:
        try:
            command = json.loads(call["function"]["arguments"])["command"]
        except (KeyError, TypeError, json.JSONDecodeError):
            return None, "bad tool call"
        return (command, None) if isinstance(command, str) else (None, "bad tool call")
    return None, "no command: " + (msg.get("content") or "")[:200]


def normalize(command):
    c = re.sub(r"^\s*cd \S+\s*&&\s*", "", command.strip())
    c = re.sub(r"\b(sudo|doas)\s+(-\S+\s+)*", "", c)
    return " ".join(c.split())


def verb(command):
    """The program and its subcommand or first option: "systemctl restart", "emerge -pv"."""
    words = normalize(command).split()
    return " ".join(words[:2])


def compare(actual, predicted):
    if predicted is None:
        return "none"
    if normalize(actual) == normalize(predicted):
        return "same"
    if verb(actual) == verb(predicted):
        return "similar"
    a, p = normalize(actual).split()[:1], normalize(predicted).split()[:1]
    return "same-program" if a == p else "different"


def serve(gguf):
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    proc = subprocess.Popen(["llama-server", "-m", gguf, "--port", str(port), "-ngl", "99", "-c", "16384",
                             "-np", "1", "--jinja"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    url = f"http://127.0.0.1:{port}"
    for _ in range(120):
        if proc.poll() is not None:
            sys.exit(f"fix-shadow: llama-server exited with {proc.returncode}")
        try:
            urllib.request.urlopen(url + "/health", timeout=2)
            return proc, url
        except OSError:
            time.sleep(1)
    proc.kill()
    sys.exit("fix-shadow: llama-server did not come up")


def read_lines(path):
    """The records of a results file. A line that is not a record (a write cut short) is skipped
    with a warning, not fatal: one bad line must not stop every later run."""
    if not path.exists():
        return
    with path.open(errors="replace") as f:
        for n, line in enumerate(f, 1):
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                rec = None
            if isinstance(rec, dict) and "id" in rec:
                yield rec
            else:
                print(f"fix-shadow: {path}:{n}: not a record, skipped", file=sys.stderr)


def server_error(rec):
    """A record of the server failing, not of the model: one from shadow-errors.jsonl, or one that
    earlier versions wrote into the results as match "none" with the HTTP error."""
    return rec.get("match") in (None, "error") or (
        rec.get("predicted") is None and str(rec.get("error") or "").startswith("HTTP "))


def state(records):
    """(compared, attempts) from all records read: the ids that have a comparison, and for the
    others how many times the server failed on them."""
    compared, attempts = set(), {}
    for rec in records:
        if server_error(rec):
            attempts[rec["id"]] = attempts.get(rec["id"], 0) + 1
        else:
            compared.add(rec["id"])
    return compared, {i: n for i, n in attempts.items() if i not in compared}


def append(path, rec):
    """Adds a record as one whole line, on disk before the next question is asked. After a line
    that was cut short the record starts on a line of its own."""
    with path.open("ab+") as f:
        if f.tell():
            f.seek(-1, os.SEEK_END)
            if f.read(1) != b"\n":
                f.write(b"\n")
        f.write((json.dumps(rec) + "\n").encode())
        f.flush()
        os.fsync(f.fileno())


def compare_all(sessions, url, source, limit, compared, attempts, results=None, errors=None):
    """Asks the model at each sysadmin command not yet compared, and records the comparison, or
    the server's failure: that command is then asked again on a later run, until MAX_ATTEMPTS
    failures. Returns (compared, failed) counts."""
    results, errors = results or RESULTS, errors or ERRORS
    done = failed = 0
    for session, events in sessions:
        for ev, users, commands in questions(events):
            if ev["id"] in compared or attempts.get(ev["id"], 0) >= MAX_ATTEMPTS or done + failed >= limit:
                continue
            rec = {"id": ev["id"], "source": source, "session": session, "time": ev["time"],
                   "request": clip(users[-1], 300), "actual": ev["command"]}
            try:
                predicted, error = ask(url, messages(users, commands))
            except ServerError as e:
                append(errors, {**rec, "error": str(e), "match": "error"})
                attempts[ev["id"]] = attempts.get(ev["id"], 0) + 1
                failed += 1
                continue
            append(results, {**rec, "predicted": predicted, "error": error,
                             "match": compare(ev["command"], predicted)})
            compared.add(ev["id"])
            done += 1
    return done, failed


def run(args):
    proc = None
    url = args.model
    if args.serve:
        proc, url = serve(args.serve)
    STATE.mkdir(parents=True, exist_ok=True)
    compared, attempts = state([*read_lines(RESULTS), *read_lines(ERRORS)])
    try:
        done, failed = compare_all(SOURCES[args.source](args.days), url, args.source, args.limit,
                                   compared, attempts)
    except urllib.error.URLError as e:
        sys.exit(f"fix-shadow: the model server cannot be reached: {e.reason}")
    finally:
        if proc:
            proc.terminate()
            proc.wait()
    print(f"fix-shadow: {done} commands compared -> {RESULTS}")
    if failed:
        print(f"fix-shadow: {failed} not compared, the server failed -> {ERRORS}", file=sys.stderr)


def report(args):
    if not RESULTS.exists():
        sys.exit("fix-shadow: no results yet; run `fix-shadow run` first")
    since = time.strftime("%Y-%m-%d", time.gmtime(time.time() - args.days * 86400))
    # A server's failure is not a disagreement: the records earlier versions wrote for one are
    # left out, as are those in shadow-errors.jsonl.
    recs = [r for r in read_lines(RESULTS) if not server_error(r) and r.get("time", "")[:10] >= since]
    if not recs:
        sys.exit(f"fix-shadow: nothing in the last {args.days} days")
    counts = {}
    for r in recs:
        counts[r["match"]] = counts.get(r["match"], 0) + 1
    print(f"{len(recs)} sysadmin commands in the last {args.days} days")
    for k in ("same", "similar", "same-program", "different", "none"):
        n = counts.get(k, 0)
        print(f"  {k:13} {n:5}  {100 * n / len(recs):5.1f} %")
    _, attempts = state([*read_lines(RESULTS), *read_lines(ERRORS)])
    if attempts:
        final = sum(1 for n in attempts.values() if n >= MAX_ATTEMPTS)
        print(f"  not compared, the server failed: {len(attempts)} commands ({final} given up after "
              f"{MAX_ATTEMPTS} attempts), see {ERRORS}")
    differ = [r for r in recs if r["match"] in ("different", "none")][-args.show:]
    if differ:
        print("\nWhere they differ (latest):")
    for r in differ:
        print(f"\n  asked:     {r['request'][:120]!r}")
        print(f"  agent:     {r['actual'][:160]}")
        print(f"  local:     {(r['predicted'] or r['error'] or '')[:160]}")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="compare the latest sessions' sysadmin commands")
    g = r.add_mutually_exclusive_group(required=True)
    g.add_argument("--model", help="base URL of an OpenAI-compatible server")
    g.add_argument("--serve", metavar="GGUF", help="start llama-server on this model for the run")
    r.add_argument("--source", choices=sorted(SOURCES), default="claude-code")
    r.add_argument("--days", type=int, default=2, help="sessions changed in the last N days (default 2)")
    r.add_argument("--limit", type=int, default=200, help="at most N commands per run (default 200)")
    s = sub.add_parser("report", help="how often the local model agreed")
    s.add_argument("--days", type=int, default=30)
    s.add_argument("--show", type=int, default=10, help="differences to show (default 10)")
    args = p.parse_args()
    run(args) if args.cmd == "run" else report(args)


if __name__ == "__main__":
    main()
