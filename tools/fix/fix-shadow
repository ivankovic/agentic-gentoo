#!/usr/bin/env python3
"""fix-shadow: would the local sysadmin model have done what the main agent did?

    fix-shadow run [--model URL | --serve GGUF] [--source NAME] [--days N] [--limit N]
    fix-shadow report [--days N] [--show N]

`run` reads the main agent's recent sessions, picks its sysadmin commands, and asks the local
model, at the same point of each session (the user's request and the commands and outputs before
it), for the next command; it records both and how close they are. `report` sums that up and shows
where they differ.

The main agent is whatever writes the sessions: a source turns its log format into a neutral trace
(user text, commands with their output), so another agent only needs another source. The local
model is any OpenAI-compatible chat server with tool calls (llama-server --jinja); --serve starts
llama-server on a GGUF for the run and stops it after.

This only measures. The main agent's sessions are not training data: its provider's terms may not
allow that, and the measure is only honest while the model has not seen them.

Results: $XDG_STATE_HOME/fix/shadow.jsonl (default ~/.local/state/fix/shadow.jsonl), one line per
command; commands already there are skipped.
"""
import argparse
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "fix"
RESULTS = STATE / "shadow.jsonl"

# Commands that administer a system, as opposed to editing code or reading files.
SYSADMIN = re.compile(r"""(^|[\s;&|(`'"])(sudo|doas|systemctl|journalctl|emerge|eselect|equery|eix|qlist|
    qdepends|portageq|emaint|dispatch-conf|etc-update|dmesg|mount|umount|findmnt|lsblk|blkid|fdisk|
    sfdisk|parted|mkfs\S*|fsck\S*|btrfs|cryptsetup|zramctl|swapon|ip|ss|ping|nmcli|networkctl|
    resolvectl|iw|useradd|usermod|userdel|groupadd|gpasswd|passwd|chage|chown|chmod|chgrp|df|du|ps|
    pgrep|pkill|kill|killall|lsof|fuser|dracut|bootctl|ukify|efibootmgr|kernel-install|modprobe|
    lsmod|sysctl|udevadm|smartctl|nvme|sensors|loginctl|timedatectl|hostnamectl|localectl|
    coredumpctl|fwupdmgr|crontab|visudo|getent|ssh|rsync|docker|podman)(\s|$)""", re.X)

SYSTEM_PROMPT = """\
You are the system administrator's assistant on a Gentoo Linux machine (systemd, Portage). You see \
what the user asked and the commands run so far with their output. Decide the single next command \
to run and call the `run` tool with it. Find the cause before changing anything, make the smallest \
change that fixes it, and never delete data you were not asked to delete."""

TOOLS = [{
    "type": "function",
    "function": {
        "name": "run",
        "description": "Run a shell command and return its output and exit code.",
        "parameters": {
            "type": "object",
            "properties": {"command": {"type": "string", "description": "a bash command line"}},
            "required": ["command"],
        },
    },
}]

HISTORY = 8          # earlier commands shown with each question
OUTPUT_LIMIT = 1500  # characters of each earlier output: the head and the tail
TEXT_LIMIT = 2000    # characters of the user's messages


def clip(text, limit):
    if len(text) <= limit:
        return text
    half = limit // 2
    return f"{text[:half]}\n[... {len(text) - limit} characters left out ...]\n{text[-half:]}"


# Sources: each yields sessions as (session id, [event]), an event being
#   {"kind": "user", "text": ...} or
#   {"kind": "command", "id": ..., "command": ..., "output": ..., "time": ...}

def claude_code(days):
    """Claude Code: ~/.claude/projects/<project>/<session>.jsonl."""
    since = time.time() - days * 86400
    for path in sorted((Path.home() / ".claude/projects").glob("*/*.jsonl")):
        if path.stat().st_mtime < since:
            continue
        events, pending = [], {}
        for line in path.open(errors="replace"):
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            if e.get("isSidechain") or e.get("type") not in ("user", "assistant"):
                continue
            content = (e.get("message") or {}).get("content")
            if isinstance(content, str):
                if e["type"] == "user" and not content.startswith("<"):
                    events.append({"kind": "user", "text": content})
                continue
            for b in content or []:
                if b.get("type") == "text" and e["type"] == "user" and not b["text"].startswith("<"):
                    events.append({"kind": "user", "text": b["text"]})
                elif b.get("type") == "tool_use" and b.get("name") == "Bash":
                    ev = {"kind": "command", "id": b["id"], "command": b["input"].get("command", ""),
                          "output": "", "time": e.get("timestamp", "")}
                    pending[b["id"]] = ev
                    events.append(ev)
                elif b.get("type") == "tool_result" and b.get("tool_use_id") in pending:
                    out = b.get("content")
                    if isinstance(out, list):
                        out = "\n".join(x.get("text", "") for x in out if isinstance(x, dict))
                    pending.pop(b["tool_use_id"])["output"] = out or ""
        yield path.stem, events


SOURCES = {"claude-code": claude_code}


def questions(events):
    """Each sysadmin command with what came before it: the user's last messages, and the commands
    run since the last of them (the work on this request)."""
    for i, ev in enumerate(events):
        if ev["kind"] != "command" or not SYSADMIN.search(ev["command"]):
            continue
        before = events[:i]
        users = [n for n, e in enumerate(before) if e["kind"] == "user"]
        if not users:
            continue
        commands = [e for e in before[users[-1]:] if e["kind"] == "command"][-HISTORY:]
        yield ev, [before[n]["text"] for n in users[-3:]], commands


def messages(users, commands):
    msgs = [{"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": clip("\n\n".join(users), TEXT_LIMIT)}]
    for n, c in enumerate(commands):
        call = {"id": f"c{n}", "type": "function",
                "function": {"name": "run", "arguments": json.dumps({"command": c["command"]})}}
        msgs.append({"role": "assistant", "content": "", "tool_calls": [call]})
        msgs.append({"role": "tool", "tool_call_id": f"c{n}", "content": clip(c["output"], OUTPUT_LIMIT)})
    return msgs


def ask(url, msgs):
    body = {"messages": msgs, "tools": TOOLS, "temperature": 0.2, "max_tokens": 1024,
            "chat_template_kwargs": {"enable_thinking": False}}
    req = urllib.request.Request(url.rstrip("/") + "/v1/chat/completions", json.dumps(body).encode(),
                                 {"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=600) as r:
            msg = json.load(r)["choices"][0]["message"]
    except urllib.error.HTTPError as e:
        return None, f"HTTP {e.code}: {e.read().decode(errors='replace')[:200]}"
    for call in msg.get("tool_calls") or []:
        try:
            return json.loads(call["function"]["arguments"])["command"], None
        except (KeyError, json.JSONDecodeError):
            return None, "bad tool call"
    return None, "no command: " + (msg.get("content") or "")[:200]


def normalize(command):
    c = re.sub(r"^\s*cd \S+\s*&&\s*", "", command.strip())
    c = re.sub(r"\b(sudo|doas)\s+(-\S+\s+)*", "", c)
    return " ".join(c.split())


def verb(command):
    """The program and its subcommand or first option: "systemctl restart", "emerge -pv"."""
    words = normalize(command).split()
    return " ".join(words[:2])


def compare(actual, predicted):
    if predicted is None:
        return "none"
    if normalize(actual) == normalize(predicted):
        return "same"
    if verb(actual) == verb(predicted):
        return "similar"
    a, p = normalize(actual).split()[:1], normalize(predicted).split()[:1]
    return "same-program" if a == p else "different"


def serve(gguf):
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    proc = subprocess.Popen(["llama-server", "-m", gguf, "--port", str(port), "-ngl", "99", "-c", "16384",
                             "-np", "1", "--jinja"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    url = f"http://127.0.0.1:{port}"
    for _ in range(120):
        if proc.poll() is not None:
            sys.exit(f"fix-shadow: llama-server exited with {proc.returncode}")
        try:
            urllib.request.urlopen(url + "/health", timeout=2)
            return proc, url
        except OSError:
            time.sleep(1)
    proc.kill()
    sys.exit("fix-shadow: llama-server did not come up")


def run(args):
    proc = None
    url = args.model
    if args.serve:
        proc, url = serve(args.serve)
    seen = set()
    if RESULTS.exists():
        seen = {json.loads(l)["id"] for l in RESULTS.open()}
    STATE.mkdir(parents=True, exist_ok=True)
    done = 0
    try:
        with RESULTS.open("a") as out:
            for session, events in SOURCES[args.source](args.days):
                for ev, users, commands in questions(events):
                    if ev["id"] in seen or done >= args.limit:
                        continue
                    predicted, error = ask(url, messages(users, commands))
                    rec = {"id": ev["id"], "source": args.source, "session": session, "time": ev["time"],
                           "request": clip(users[-1], 300), "actual": ev["command"],
                           "predicted": predicted, "error": error, "match": compare(ev["command"], predicted)}
                    out.write(json.dumps(rec) + "\n")
                    out.flush()
                    done += 1
    finally:
        if proc:
            proc.terminate()
            proc.wait()
    print(f"fix-shadow: {done} commands compared -> {RESULTS}")


def report(args):
    if not RESULTS.exists():
        sys.exit("fix-shadow: no results yet; run `fix-shadow run` first")
    since = time.strftime("%Y-%m-%d", time.gmtime(time.time() - args.days * 86400))
    recs = [r for r in map(json.loads, RESULTS.open()) if r["time"][:10] >= since]
    if not recs:
        sys.exit(f"fix-shadow: nothing in the last {args.days} days")
    counts = {}
    for r in recs:
        counts[r["match"]] = counts.get(r["match"], 0) + 1
    print(f"{len(recs)} sysadmin commands in the last {args.days} days")
    for k in ("same", "similar", "same-program", "different", "none"):
        n = counts.get(k, 0)
        print(f"  {k:13} {n:5}  {100 * n / len(recs):5.1f} %")
    differ = [r for r in recs if r["match"] in ("different", "none")][-args.show:]
    if differ:
        print("\nWhere they differ (latest):")
    for r in differ:
        print(f"\n  asked:     {r['request'][:120]!r}")
        print(f"  agent:     {r['actual'][:160]}")
        print(f"  local:     {(r['predicted'] or r['error'] or '')[:160]}")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="compare the latest sessions' sysadmin commands")
    g = r.add_mutually_exclusive_group(required=True)
    g.add_argument("--model", help="base URL of an OpenAI-compatible server")
    g.add_argument("--serve", metavar="GGUF", help="start llama-server on this model for the run")
    r.add_argument("--source", choices=sorted(SOURCES), default="claude-code")
    r.add_argument("--days", type=int, default=2, help="sessions changed in the last N days (default 2)")
    r.add_argument("--limit", type=int, default=200, help="at most N commands per run (default 200)")
    s = sub.add_parser("report", help="how often the local model agreed")
    s.add_argument("--days", type=int, default=30)
    s.add_argument("--show", type=int, default=10, help="differences to show (default 10)")
    args = p.parse_args()
    run(args) if args.cmd == "run" else report(args)


if __name__ == "__main__":
    main()
