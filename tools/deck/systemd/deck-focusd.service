# Time actively spent in each program: its window focused, the user not idle. Reads niri's event
# stream and Wayland's idle notifications; writes $XDG_STATE_HOME/deck/focus.db.
[Unit]
Description=Per-program active time (deck)
Documentation=https://github.com/ivankovic/agentic-gentoo/tree/main/tools/deck
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/deck-focusd
Restart=on-failure
RestartSec=10
Nice=10

# What a user unit gets without a namespace of its own: it still reads the compositor's sockets
# and its user's processes in /proc, and writes ~/.local/state/deck. Options that mount (ProtectSystem,
# ProtectHome, PrivateTmp) would put it in a user namespace, so they are left out.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# focus.db says what was used when: the user's alone.
UMask=0077

[Install]
WantedBy=graphical-session.target
