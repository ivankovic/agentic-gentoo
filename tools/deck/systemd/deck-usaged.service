# CPU, memory and profile per package, for `deck usage` and deck's Usage tab.
[Unit]
Description=Per-package CPU and memory accounting (deck)
Documentation=https://github.com/ivankovic/agentic-gentoo/tree/main/tools/deck

[Service]
ExecStart=/usr/sbin/deck-usaged
StateDirectory=deck
Nice=10
IOSchedulingClass=idle
MemoryMax=256M

# Reading other users' processes (exe, maps, smaps_rollup) and resetting their peak memory
# (clear_refs) takes ptrace access and DAC override; the kernel's process events and exit
# reports take CAP_NET_ADMIN; the profiler's CPU-cycle sampling takes CAP_PERFMON, and the kernel
# modules' addresses in /proc/modules (to tell i915 from btrfs) take CAP_SYSLOG.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_PERFMON CAP_SYSLOG
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
# No ProtectKernelLogs: it takes CAP_SYSLOG out of the bounding set, and with it the modules'
# addresses.
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service perf_event_open

[Install]
WantedBy=multi-user.target
